// ============================================================================
// ICT/SMC ALGO TRADING SYSTEM - PHASE 1
// Strategy: Top-Down Bias + OB/FVG/BOS/MSS + Trade Window Entry
// TTF: Trade Timeframe (default 5M) | HTF1/2/3: Higher TFs (default 1H/4H/D)
// Author: Built for mesan4net-blip algo trading system
// Version: 1.0
// ============================================================================
//@version=6
indicator("ICT SMC Phase 1 OB FVG BOS MSS", shorttitle="ICT-P1-v1",
     overlay=true, max_bars_back=5000, max_labels_count=500, max_boxes_count=500,
     max_lines_count=500)

// ============================================================================
// INPUTS
// ============================================================================

// --- Timeframe Settings ---
grp_tf   = "Timeframe Settings"
ttf_in   = input.timeframe("5",   "TTF  - Trade Timeframe (entry/exit detection)", group=grp_tf)
htf1_in  = input.timeframe("60",  "HTF1 - Higher Timeframe 1 (confirmation)",      group=grp_tf)
htf2_in  = input.timeframe("240", "HTF2 - Higher Timeframe 2 (setup)",             group=grp_tf)
htf3_in  = input.timeframe("D",   "HTF3 - Higher Timeframe 3 (bias)",              group=grp_tf)

// --- Trade Windows ---
grp_kz = "Trade Windows"
kz_london_on  = input.bool(true,  "London Trade Window",          group=grp_kz)
kz_london_h1  = input.int(2,      "London Start Hour (EST)",   group=grp_kz, minval=0, maxval=23)
kz_london_h2  = input.int(5,      "London End Hour (EST)",     group=grp_kz, minval=0, maxval=23)
kz_ny_on      = input.bool(true,  "NY Trade Window",              group=grp_kz)
kz_ny_h1      = input.int(8,      "NY Start Hour (EST)",       group=grp_kz, minval=0, maxval=23)
kz_ny_h2      = input.int(11,     "NY End Hour (EST)",         group=grp_kz, minval=0, maxval=23)
kz_bg_transp  = input.int(90,     "Trade Window BG Transparency", group=grp_kz, minval=50, maxval=99)
kz_london_col = input.color(color.new(color.blue,   90), "London Color", group=grp_kz)
kz_ny_col     = input.color(color.new(color.orange, 90), "NY Color",     group=grp_kz)

// --- Structure ---
grp_str = "Market Structure"
show_bos      = input.bool(true, "Show BOS Labels",  group=grp_str)
show_mss      = input.bool(true, "Show MSS Labels",  group=grp_str)
show_choch    = input.bool(true, "Show CHoCH Labels (visual only)", group=grp_str)
str_lookback  = input.int(10,    "Swing Lookback (bars)", group=grp_str, minval=3, maxval=50)

// --- Order Blocks ---
grp_ob = "Order Blocks"
show_ob       = input.bool(true,  "Show Order Blocks",          group=grp_ob)
ob_bull_col   = input.color(color.new(color.green, 80), "Bullish OB Color", group=grp_ob)
ob_bear_col   = input.color(color.new(color.red,   80), "Bearish OB Color", group=grp_ob)
ob_border_bull= input.color(color.new(color.green, 20), "Bull OB Border",   group=grp_ob)
ob_border_bear= input.color(color.new(color.red,   20), "Bear OB Border",   group=grp_ob)
ob_max        = input.int(5, "Max Active OBs to Show", group=grp_ob, minval=1, maxval=20)

// --- Fair Value Gaps ---
grp_fvg = "Fair Value Gaps"
show_fvg      = input.bool(true,  "Show FVGs",               group=grp_fvg)
fvg_bull_col  = input.color(color.new(color.teal,   80), "Bullish FVG Color", group=grp_fvg)
fvg_bear_col  = input.color(color.new(color.purple, 80), "Bearish FVG Color", group=grp_fvg)
fvg_border_bull = input.color(color.new(color.teal,   20), "Bull FVG Border", group=grp_fvg)
fvg_border_bear = input.color(color.new(color.purple, 20), "Bear FVG Border", group=grp_fvg)
fvg_max       = input.int(5, "Max Active FVGs to Show", group=grp_fvg, minval=1, maxval=20)

// --- Entry & Risk ---
grp_risk = "Entry & Risk"
sl_buffer_pips = input.float(2.0, "SL Buffer (pips beyond OB)",  group=grp_risk, minval=0, step=0.5)
tp1_rr         = input.float(2.0, "TP1 Risk:Reward",             group=grp_risk, minval=0.5, step=0.5)
tp2_rr         = input.float(4.0, "TP2 Risk:Reward",             group=grp_risk, minval=1.0, step=0.5)
trail_lookback = input.int(10,    "Trail SL Lookback (bars)",     group=grp_risk, minval=1, maxval=50)
require_fvg    = input.bool(false, "Require FVG (in addition to OB)", group=grp_risk)
displace_mult  = input.float(1.5, "Displacement Candle Min Size (ATRx)", group=grp_risk, minval=0.5, step=0.1)

// --- Visuals ---
grp_vis = "Visuals"
show_entry_labels = input.bool(true, "Show Entry Labels",    group=grp_vis)
show_sl_line      = input.bool(true, "Show SL Line",         group=grp_vis)
show_tp_lines     = input.bool(true, "Show TP1/TP2 Lines",   group=grp_vis)
show_trail_dots   = input.bool(true, "Show Trail SL Dots",   group=grp_vis)
show_hud          = input.bool(true, "Show HUD Table",       group=grp_vis)
show_bias_label   = input.bool(true, "Show Bias Label (top right)", group=grp_vis)

// --- Alerts ---
grp_alert = "Alerts / Webhook"
alert_on_entry = input.bool(true, "Fire Alert on Entry Signal", group=grp_alert)

// ============================================================================
// CONSTANTS & HELPERS
// ============================================================================
pip_size = syminfo.mintick * (syminfo.type == "forex" ? 10 : 1)
atr14    = ta.atr(14)

f_pip_to_price(_pips) => _pips * pip_size

// Timestamp - available globally for tooltips and HUD
ts_str = str.tostring(year) + "-" + (month < 10 ? "0" : "") + str.tostring(month) + "-" + (dayofmonth < 10 ? "0" : "") + str.tostring(dayofmonth) + " " + (hour < 10 ? "0" : "") + str.tostring(hour) + ":" + (minute < 10 ? "0" : "") + str.tostring(minute)

// Hour in EST (UTC-5 standard, UTC-4 DST - TradingView uses exchange time)
// For forex pairs, syminfo.timezone = "America/New_York" on most brokers
bar_hour = hour(time, "America/New_York")
bar_min  = minute(time, "America/New_York")

// Trade Window detection
in_london = kz_london_on and (bar_hour >= kz_london_h1 and bar_hour < kz_london_h2)
in_ny     = kz_ny_on     and (bar_hour >= kz_ny_h1     and bar_hour < kz_ny_h2)
in_kz     = in_london or in_ny
kz_name   = in_london ? "London" : in_ny ? "New York" : "Closed"

// Gap filter (same as Script 1 - no entry on gap bars)
gap_up   = bar_index > 0 and low  > high[1]
gap_dn   = bar_index > 0 and high < low[1]
gap_bar  = gap_up or gap_dn

// ============================================================================
// HIGHER TIMEFRAME DATA
// ============================================================================
f_htf_close(_tf) =>
    request.security(syminfo.tickerid, _tf, close, barmerge.gaps_off, barmerge.lookahead_off)

f_htf_high(_tf) =>
    request.security(syminfo.tickerid, _tf, high, barmerge.gaps_off, barmerge.lookahead_off)

f_htf_low(_tf) =>
    request.security(syminfo.tickerid, _tf, low, barmerge.gaps_off, barmerge.lookahead_off)

// HTF3 (default: Daily) - Bias
d_close  = f_htf_close(htf3_in)
d_high   = f_htf_high(htf3_in)
d_low    = f_htf_low(htf3_in)

// HTF2 (default: 4H) - Setup
h4_close = f_htf_close(htf2_in)
h4_high  = f_htf_high(htf2_in)
h4_low   = f_htf_low(htf2_in)

// HTF1 (default: 1H) - Confirmation
h1_close = f_htf_close(htf1_in)
h1_high  = f_htf_high(htf1_in)
h1_low   = f_htf_low(htf1_in)

// ============================================================================
// ============================================================================
// 5M TRADE DATA - always fetched at 5M resolution for trade detection
// Structure runs on chart TF. Trades always detected on 5M.
// Labels placed with xloc.bar_time so they appear on all TFs correctly.
// ============================================================================
// TTF (default: 5M) - Trade detection data
m5_o  = request.security(syminfo.tickerid, ttf_in, open,  barmerge.gaps_off, barmerge.lookahead_off)
m5_h  = request.security(syminfo.tickerid, ttf_in, high,  barmerge.gaps_off, barmerge.lookahead_off)
m5_l  = request.security(syminfo.tickerid, ttf_in, low,   barmerge.gaps_off, barmerge.lookahead_off)
m5_c  = request.security(syminfo.tickerid, ttf_in, close, barmerge.gaps_off, barmerge.lookahead_off)
m5_t  = request.security(syminfo.tickerid, ttf_in, time,  barmerge.gaps_off, barmerge.lookahead_off)
m5_hr = request.security(syminfo.tickerid, ttf_in, hour(time, "America/New_York"), barmerge.gaps_off, barmerge.lookahead_off)

// Trade Window - evaluated on 5M time
tw_london = kz_london_on and (m5_hr >= kz_london_h1 and m5_hr < kz_london_h2)
tw_ny     = kz_ny_on     and (m5_hr >= kz_ny_h1     and m5_hr < kz_ny_h2)
in_kz_5m  = tw_london or tw_ny
kz_5m_name = tw_london ? "London" : tw_ny ? "New York" : "Closed"

// 5M structure for trade entry trigger only
var float last_sh_5m_trade = na
var float last_sl_5m_trade = na
var int   struct_dir_trade  = 0
var bool  mss_bull_trade    = false
var bool  mss_bear_trade    = false

mss_bull_trade := false
mss_bear_trade := false

m5_ph = ta.pivothigh(m5_h, str_lookback, str_lookback)
m5_pl = ta.pivotlow(m5_l,  str_lookback, str_lookback)

if not na(m5_ph)
    last_sh_5m_trade := m5_ph
if not na(m5_pl)
    last_sl_5m_trade := m5_pl

if not na(last_sh_5m_trade) and m5_c > last_sh_5m_trade and barstate.isconfirmed
    if struct_dir_trade <= 0
        mss_bull_trade := true
    struct_dir_trade := 1

if not na(last_sl_5m_trade) and m5_c < last_sl_5m_trade and barstate.isconfirmed
    if struct_dir_trade >= 0
        mss_bear_trade := true
    struct_dir_trade := -1

// 5M gap filter for trade entries
m5_gap_up  = m5_l > m5_h[1]
m5_gap_bar = m5_gap_up or m5_h < m5_l[1]

// MARKET STRUCTURE ENGINE
// Detects swing highs/lows, BOS, MSS on each timeframe
// ============================================================================

// --- Swing detection on a series ---
f_swing_high(_high, _n) =>
    ph = ta.pivothigh(_high, _n, _n)
    ph

f_swing_low(_low, _n) =>
    pl = ta.pivotlow(_low, _n, _n)
    pl

// 5M structure (chart TF)
swing_h_5m = f_swing_high(high, str_lookback)
swing_l_5m = f_swing_low(low,   str_lookback)

// Track last confirmed swing high/low on 5M
var float last_sh_5m = na
var float last_sl_5m = na
var int   last_sh_5m_bar = na
var int   last_sl_5m_bar = na

if not na(swing_h_5m)
    last_sh_5m     := swing_h_5m
    last_sh_5m_bar := bar_index - str_lookback

if not na(swing_l_5m)
    last_sl_5m     := swing_l_5m
    last_sl_5m_bar := bar_index - str_lookback

// 5M BOS & MSS detection
var int   struct_dir_5m = 0   // 1 = bullish structure, -1 = bearish
var bool  bos_bull_5m   = false
var bool  bos_bear_5m   = false
var bool  mss_bull_5m   = false
var bool  mss_bear_5m   = false

bos_bull_5m := false
bos_bear_5m := false
mss_bull_5m := false
mss_bear_5m := false

// Bullish BOS: close above last swing high (structure was bearish or neutral)
if not na(last_sh_5m) and close > last_sh_5m and barstate.isconfirmed
    if struct_dir_5m <= 0
        mss_bull_5m   := true   // Was bearish -> shift = MSS
    else
        bos_bull_5m   := true   // Was bullish -> continuation = BOS
    struct_dir_5m := 1

// Bearish BOS: close below last swing low
if not na(last_sl_5m) and close < last_sl_5m and barstate.isconfirmed
    if struct_dir_5m >= 0
        mss_bear_5m   := true   // Was bullish -> shift = MSS
    else
        bos_bear_5m   := true   // Was bearish -> continuation = BOS
    struct_dir_5m := -1

// Daily structure (simplified - track bias via HTF close vs prior swings)
swing_h_d = f_swing_high(d_high, str_lookback)
swing_l_d = f_swing_low(d_low,   str_lookback)

var float last_sh_d = na
var float last_sl_d = na
var int   daily_struct = 0

if not na(swing_h_d)
    last_sh_d := swing_h_d
if not na(swing_l_d)
    last_sl_d := swing_l_d

if not na(last_sh_d) and d_close > last_sh_d
    daily_struct := 1
if not na(last_sl_d) and d_close < last_sl_d
    daily_struct := -1

// 4H structure
swing_h_4h = f_swing_high(h4_high, str_lookback)
swing_l_4h = f_swing_low(h4_low,   str_lookback)

var float last_sh_4h = na
var float last_sl_4h = na
var int   h4_struct  = 0

if not na(swing_h_4h)
    last_sh_4h := swing_h_4h
if not na(swing_l_4h)
    last_sl_4h := swing_l_4h

if not na(last_sh_4h) and h4_close > last_sh_4h
    h4_struct := 1
if not na(last_sl_4h) and h4_close < last_sl_4h
    h4_struct := -1

// 1H structure
swing_h_1h = f_swing_high(h1_high, str_lookback)
swing_l_1h = f_swing_low(h1_low,   str_lookback)

var float last_sh_1h = na
var float last_sl_1h = na
var int   h1_struct  = 0

if not na(swing_h_1h)
    last_sh_1h := swing_h_1h
if not na(swing_l_1h)
    last_sl_1h := swing_l_1h

if not na(last_sh_1h) and h1_close > last_sh_1h
    h1_struct := 1
if not na(last_sl_1h) and h1_close < last_sl_1h
    h1_struct := -1

// ============================================================================
// TOP-DOWN BIAS
// Daily sets bias -> 4H confirms -> 1H activates -> 5M triggers
// ============================================================================
// Bias: 4H + 1H must agree (trading bias).
// Daily acts as a filter - if Daily is bearish, only allow short bias. If bullish, only long.
// If Daily is flat/0, allow 4H+1H to decide freely.
bias_bull = h4_struct == 1 and h1_struct == 1 and daily_struct >= 0
bias_bear = h4_struct == -1 and h1_struct == -1 and daily_struct <= 0

// ============================================================================
// ORDER BLOCK DETECTION (5M chart)
// Bullish OB: last bearish candle before a bullish BOS/MSS
// Bearish OB: last bullish candle before a bearish BOS/MSS
// ============================================================================
var float[] ob_bull_top   = array.new_float()
var float[] ob_bull_bot   = array.new_float()
var int[]   ob_bull_bar   = array.new_int()
var bool[]  ob_bull_valid = array.new_bool()

var float[] ob_bear_top   = array.new_float()
var float[] ob_bear_bot   = array.new_float()
var int[]   ob_bear_bar   = array.new_int()
var bool[]  ob_bear_valid = array.new_bool()

// On bullish MSS/BOS -> find last bearish candle before it
if (bos_bull_5m or mss_bull_5m) and barstate.isconfirmed
    // Look back for last bearish candle (close < open)
    for i = 1 to math.min(str_lookback * 2, bar_index)
        if close[i] < open[i]   // bearish candle = bullish OB
            array.unshift(ob_bull_top,   high[i])
            array.unshift(ob_bull_bot,   low[i])
            array.unshift(ob_bull_bar,   bar_index - i)
            array.unshift(ob_bull_valid, true)
            break
    // Trim to max
    while array.size(ob_bull_top) > ob_max
        array.pop(ob_bull_top)
        array.pop(ob_bull_bot)
        array.pop(ob_bull_bar)
        array.pop(ob_bull_valid)

// On bearish MSS/BOS -> find last bullish candle before it
if (bos_bear_5m or mss_bear_5m) and barstate.isconfirmed
    for i = 1 to math.min(str_lookback * 2, bar_index)
        if close[i] > open[i]   // bullish candle = bearish OB
            array.unshift(ob_bear_top,   high[i])
            array.unshift(ob_bear_bot,   low[i])
            array.unshift(ob_bear_bar,   bar_index - i)
            array.unshift(ob_bear_valid, true)
            break
    while array.size(ob_bear_top) > ob_max
        array.pop(ob_bear_top)
        array.pop(ob_bear_bot)
        array.pop(ob_bear_bar)
        array.pop(ob_bear_valid)

// Invalidate OBs when price closes through them
if array.size(ob_bull_valid) > 0
    for i = 0 to array.size(ob_bull_valid) - 1
        if array.get(ob_bull_valid, i) and close < array.get(ob_bull_bot, i)
            array.set(ob_bull_valid, i, false)

if array.size(ob_bear_valid) > 0
    for i = 0 to array.size(ob_bear_valid) - 1
        if array.get(ob_bear_valid, i) and close > array.get(ob_bear_top, i)
            array.set(ob_bear_valid, i, false)

// Draw OB boxes
if show_ob and barstate.islast
    if array.size(ob_bull_top) > 0
        for i = 0 to array.size(ob_bull_top) - 1
            if array.get(ob_bull_valid, i)
                box.new(array.get(ob_bull_bar, i), array.get(ob_bull_top, i),
                        bar_index + 5,             array.get(ob_bull_bot, i),
                        border_color=ob_border_bull, bgcolor=ob_bull_col,
                        extend=extend.none)

    if array.size(ob_bear_top) > 0
        for i = 0 to array.size(ob_bear_top) - 1
            if array.get(ob_bear_valid, i)
                box.new(array.get(ob_bear_bar, i), array.get(ob_bear_top, i),
                        bar_index + 5,             array.get(ob_bear_bot, i),
                        border_color=ob_border_bear, bgcolor=ob_bear_col,
                        extend=extend.none)

// ============================================================================
// FAIR VALUE GAP DETECTION (5M chart)
// Bullish FVG: low[0] > high[2] (gap between candle 1 and candle 3)
// Bearish FVG: high[0] < low[2]
// ============================================================================
var float[] fvg_bull_top   = array.new_float()
var float[] fvg_bull_bot   = array.new_float()
var int[]   fvg_bull_bar   = array.new_int()
var bool[]  fvg_bull_valid = array.new_bool()

var float[] fvg_bear_top   = array.new_float()
var float[] fvg_bear_bot   = array.new_float()
var int[]   fvg_bear_bar   = array.new_int()
var bool[]  fvg_bear_valid = array.new_bool()

// Bullish FVG: gap between bar[2] high and bar[0] low, middle candle is bullish
bull_fvg_cond = low > high[2] and close[1] > open[1]
bear_fvg_cond = high < low[2] and close[1] < open[1]

if bull_fvg_cond and barstate.isconfirmed
    array.unshift(fvg_bull_top,   low)
    array.unshift(fvg_bull_bot,   high[2])
    array.unshift(fvg_bull_bar,   bar_index - 1)
    array.unshift(fvg_bull_valid, true)
    while array.size(fvg_bull_top) > fvg_max
        array.pop(fvg_bull_top)
        array.pop(fvg_bull_bot)
        array.pop(fvg_bull_bar)
        array.pop(fvg_bull_valid)

if bear_fvg_cond and barstate.isconfirmed
    array.unshift(fvg_bear_top,   low[2])
    array.unshift(fvg_bear_bot,   high)
    array.unshift(fvg_bear_bar,   bar_index - 1)
    array.unshift(fvg_bear_valid, true)
    while array.size(fvg_bear_top) > fvg_max
        array.pop(fvg_bear_top)
        array.pop(fvg_bear_bot)
        array.pop(fvg_bear_bar)
        array.pop(fvg_bear_valid)

// Invalidate FVGs when price fills them
if array.size(fvg_bull_valid) > 0
    for i = 0 to array.size(fvg_bull_valid) - 1
        if array.get(fvg_bull_valid, i) and close < array.get(fvg_bull_bot, i)
            array.set(fvg_bull_valid, i, false)

if array.size(fvg_bear_valid) > 0
    for i = 0 to array.size(fvg_bear_valid) - 1
        if array.get(fvg_bear_valid, i) and close > array.get(fvg_bear_top, i)
            array.set(fvg_bear_valid, i, false)

// Draw FVG boxes
if show_fvg and barstate.islast
    if array.size(fvg_bull_top) > 0
        for i = 0 to array.size(fvg_bull_top) - 1
            if array.get(fvg_bull_valid, i)
                box.new(array.get(fvg_bull_bar, i), array.get(fvg_bull_top, i),
                        bar_index + 5,              array.get(fvg_bull_bot, i),
                        border_color=fvg_border_bull, bgcolor=fvg_bull_col,
                        extend=extend.none)

    if array.size(fvg_bear_top) > 0
        for i = 0 to array.size(fvg_bear_top) - 1
            if array.get(fvg_bear_valid, i)
                box.new(array.get(fvg_bear_bar, i), array.get(fvg_bear_top, i),
                        bar_index + 5,              array.get(fvg_bear_bot, i),
                        border_color=fvg_border_bear, bgcolor=fvg_bear_col,
                        extend=extend.none)

// ============================================================================
// ============================================================================
// ============================================================================
// MARKET STRUCTURE LABELS
// MSS = your entry trigger - bold, clear, with vertical spike
// BOS = continuation context - subtle dashed line only, no label clutter
// CHoCH = off by default
// ============================================================================

// BOS - dashed line only, no floating label
if show_bos and bos_bull_5m and not na(last_sh_5m) and not na(last_sh_5m_bar)
    line.new(last_sh_5m_bar, last_sh_5m, bar_index, last_sh_5m, color=color.new(color.green, 60), width=1, style=line.style_dashed)

if show_bos and bos_bear_5m and not na(last_sl_5m) and not na(last_sl_5m_bar)
    line.new(last_sl_5m_bar, last_sl_5m, bar_index, last_sl_5m, color=color.new(color.red, 60), width=1, style=line.style_dashed)

// MSS - solid bold line + label at right end + vertical spike on candle
if show_mss and mss_bull_5m and not na(last_sh_5m) and not na(last_sh_5m_bar)
    line.new(last_sh_5m_bar, last_sh_5m, bar_index + 3, last_sh_5m, color=color.new(color.lime, 0), width=2, style=line.style_solid)
    label.new(bar_index + 3, last_sh_5m, "MSS", style=label.style_label_left, color=color.new(color.lime, 0), textcolor=color.black, size=size.small)
    line.new(bar_index, low - atr14 * 0.2, bar_index, low - atr14 * 1.0, color=color.new(color.lime, 0), width=2)

if show_mss and mss_bear_5m and not na(last_sl_5m) and not na(last_sl_5m_bar)
    line.new(last_sl_5m_bar, last_sl_5m, bar_index + 3, last_sl_5m, color=color.new(color.orange, 0), width=2, style=line.style_solid)
    label.new(bar_index + 3, last_sl_5m, "MSS", style=label.style_label_left, color=color.new(color.orange, 0), textcolor=color.black, size=size.small)
    line.new(bar_index, high + atr14 * 0.2, bar_index, high + atr14 * 1.0, color=color.new(color.orange, 0), width=2)

// CHoCH - off by default, tiny if enabled
choch_bull = struct_dir_5m == -1 and not na(last_sl_5m) and low < last_sl_5m and close > last_sl_5m
choch_bear = struct_dir_5m == 1  and not na(last_sh_5m) and high > last_sh_5m and close < last_sh_5m

if show_choch and choch_bull
    label.new(bar_index, low - atr14 * 0.3, "CHoCH", style=label.style_label_up, color=color.new(color.teal, 50), textcolor=color.white, size=size.tiny)

if show_choch and choch_bear
    label.new(bar_index, high + atr14 * 0.3, "CHoCH", style=label.style_label_down, color=color.new(color.purple, 50), textcolor=color.white, size=size.tiny)

// POI PROXIMITY CHECK
// Is price currently inside or retesting a valid OB or FVG?
// ============================================================================
f_in_bull_ob() =>
    bool result = false
    float ob_top_ref = na
    float ob_bot_ref = na
    if array.size(ob_bull_valid) > 0
        for i = 0 to array.size(ob_bull_valid) - 1
            if array.get(ob_bull_valid, i)
                t = array.get(ob_bull_top, i)
                b = array.get(ob_bull_bot, i)
                if low <= t and high >= b
                    result     := true
                    ob_top_ref := t
                    ob_bot_ref := b
                    break
    [result, ob_top_ref, ob_bot_ref]

f_in_bear_ob() =>
    bool result = false
    float ob_top_ref = na
    float ob_bot_ref = na
    if array.size(ob_bear_valid) > 0
        for i = 0 to array.size(ob_bear_valid) - 1
            if array.get(ob_bear_valid, i)
                t = array.get(ob_bear_top, i)
                b = array.get(ob_bear_bot, i)
                if low <= t and high >= b
                    result     := true
                    ob_top_ref := t
                    ob_bot_ref := b
                    break
    [result, ob_top_ref, ob_bot_ref]

f_in_bull_fvg() =>
    bool result = false
    if array.size(fvg_bull_valid) > 0
        for i = 0 to array.size(fvg_bull_valid) - 1
            if array.get(fvg_bull_valid, i)
                t = array.get(fvg_bull_top, i)
                b = array.get(fvg_bull_bot, i)
                if low <= t and high >= b
                    result := true
                    break
    result

f_in_bear_fvg() =>
    bool result = false
    if array.size(fvg_bear_valid) > 0
        for i = 0 to array.size(fvg_bear_valid) - 1
            if array.get(fvg_bear_valid, i)
                t = array.get(fvg_bear_top, i)
                b = array.get(fvg_bear_bot, i)
                if low <= t and high >= b
                    result := true
                    break
    result

[in_bull_ob, active_ob_top, active_ob_bot] = f_in_bull_ob()
[in_bear_ob, active_bear_ob_top, active_bear_ob_bot] = f_in_bear_ob()
in_bull_fvg = f_in_bull_fvg()
in_bear_fvg = f_in_bear_fvg()

poi_bull = in_bull_ob and (require_fvg ? in_bull_fvg : true)
poi_bear = in_bear_ob and (require_fvg ? in_bear_fvg : true)

// ============================================================================
// DISPLACEMENT CANDLE CHECK
// Large bodied candle closing near high (bull) or low (bear)
// ============================================================================
candle_body   = math.abs(close - open)
candle_range  = high - low
is_displaced  = candle_body >= atr14 * displace_mult
disp_bull     = is_displaced and close > open and close >= (low + candle_range * 0.6)
disp_bear     = is_displaced and close < open and close <= (high - candle_range * 0.6)

// ============================================================================
// ENTRY CONDITIONS
// All must align: Bias + POI + MSS + Displacement + Trade Window + No Gap
// ============================================================================
// Entry: Bias + POI + MSS + Trade Window. Displacement removed - MSS candle is the displacement.
long_entry_raw  = bias_bull and poi_bull and mss_bull_trade and in_kz_5m and not m5_gap_bar and barstate.isconfirmed
short_entry_raw = bias_bear and poi_bear and mss_bear_trade and in_kz_5m and not m5_gap_bar and barstate.isconfirmed

// ============================================================================
// TRADE STATE & MANAGEMENT
// ============================================================================
var int   pos          = 0       // 1 = long, -1 = short, 0 = flat
var float entry_price  = na
var float sl_price     = na
var float tp1_price    = na
var float tp2_price    = na
var float trail_sl     = na
var bool  tp1_hit      = false
var int   entry_bar    = na
var int   entry_time   = na   // wall-clock time of entry, for cross-TF display

// SL calculation
f_long_sl(_ob_bot)  => _ob_bot - f_pip_to_price(sl_buffer_pips)
f_short_sl(_ob_top) => _ob_top + f_pip_to_price(sl_buffer_pips)

// Trail SL update (rolling candle low for longs, high for shorts)
f_trail_long() =>
    float best = low[1]
    int   n    = math.min(trail_lookback, bar_index)
    for i = 2 to n
        if low[i] < best
            best := low[i]
    best

f_trail_short() =>
    float best = high[1]
    int   n    = math.min(trail_lookback, bar_index)
    for i = 2 to n
        if high[i] > best
            best := high[i]
    best

// Exit conditions
long_sl_hit   = pos == 1  and not na(trail_sl) and m5_l <= trail_sl
short_sl_hit  = pos == -1 and not na(trail_sl) and m5_h >= trail_sl
long_tp1_hit  = pos == 1  and not tp1_hit and not na(tp1_price) and m5_h >= tp1_price
short_tp1_hit = pos == -1 and not tp1_hit and not na(tp1_price) and m5_l <= tp1_price
long_tp2_hit  = pos == 1  and tp1_hit and not na(tp2_price) and m5_h >= tp2_price
short_tp2_hit = pos == -1 and tp1_hit and not na(tp2_price) and m5_l <= tp2_price

// HUD variables
var float gross_profit = 0.0
var float gross_loss   = 0.0
var int   wins         = 0
var int   losses       = 0
var int   trades       = 0
var float peak_equity  = 0.0
var float equity       = 0.0
var float max_dd       = 0.0

// f_log_exit replaced with inline logic below

// ============================================================================
// ENGINE - Exits first, then entries
// ============================================================================
bool exited_this_bar = false

// --- EXITS ---

// TP2 hit (full close on runner)
if pos == 1 and long_tp2_hit
    float _pnl_ltp2 = tp2_price - entry_price
    if show_entry_labels
        close_tt_ltp2 = "EXIT: CLOSE LONG" + "\n" + "====================" + "\n" + "Reason:    TP2 Hit" + "\n" + "Open:       " + str.tostring(m5_o, format.mintick) + "\n" + "Close:       " + str.tostring(m5_c, format.mintick) + "\n" + "Entry:      " + str.tostring(entry_price, format.mintick) + "\n" + "Exit:         " + str.tostring(tp2_price, format.mintick) + "\n" + "P&L:         " + str.tostring(_pnl_ltp2, format.mintick) + "\n" + "Result:      " + (_pnl_ltp2 >= 0 ? "PROFIT" : "LOSS") + "\n" + "Time: " + ts_str
        label.new(time, high + atr14 * 1.5, "CLOSE", style=label.style_label_down, color=_pnl_ltp2 >= 0 ? color.new(color.green, 0) : color.new(color.black, 0), textcolor=color.white, size=size.large, tooltip=close_tt_ltp2, xloc=xloc.bar_time)
    equity += _pnl_ltp2
    trades += 1
    if _pnl_ltp2 >= 0
        gross_profit += _pnl_ltp2
        wins += 1
    else
        gross_loss += math.abs(_pnl_ltp2)
        losses += 1
    peak_equity := math.max(peak_equity, equity)
    max_dd := math.max(max_dd, peak_equity - equity)
    pos          := 0
    trail_sl     := na
    tp1_hit      := false
    exited_this_bar := true

if pos == -1 and short_tp2_hit
    float _pnl_stp2 = entry_price - tp2_price
    if show_entry_labels
        close_tt_stp2 = "EXIT: CLOSE SHORT" + "\n" + "====================" + "\n" + "Reason:    TP2 Hit" + "\n" + "Open:       " + str.tostring(m5_o, format.mintick) + "\n" + "Close:       " + str.tostring(m5_c, format.mintick) + "\n" + "Entry:      " + str.tostring(entry_price, format.mintick) + "\n" + "Exit:         " + str.tostring(tp2_price, format.mintick) + "\n" + "P&L:         " + str.tostring(_pnl_stp2, format.mintick) + "\n" + "Result:      " + (_pnl_stp2 >= 0 ? "PROFIT" : "LOSS") + "\n" + "Time: " + ts_str
        label.new(time, low - atr14 * 1.5, "CLOSE", style=label.style_label_up, color=_pnl_stp2 >= 0 ? color.new(color.green, 0) : color.new(color.black, 0), textcolor=color.white, size=size.large, tooltip=close_tt_stp2, xloc=xloc.bar_time)
    equity += _pnl_stp2
    trades += 1
    if _pnl_stp2 >= 0
        gross_profit += _pnl_stp2
        wins += 1
    else
        gross_loss += math.abs(_pnl_stp2)
        losses += 1
    peak_equity := math.max(peak_equity, equity)
    max_dd := math.max(max_dd, peak_equity - equity)
    pos          := 0
    trail_sl     := na
    tp1_hit      := false
    exited_this_bar := true

// TP1 hit (partial - move SL to BE, continue trailing)
if not exited_this_bar and pos == 1 and long_tp1_hit
    tp1_hit  := true
    trail_sl := entry_price   // Move SL to BE
    if show_entry_labels
        tp1_tt_l = "TP1 HIT - LONG" + "\n" + "Entry: " + str.tostring(entry_price, format.mintick) + "\n" + "TP1:    " + str.tostring(tp1_price, format.mintick) + "\n" + "SL now at breakeven" + "\n" + "Trailing runner to TP2: " + str.tostring(tp2_price, format.mintick)
        label.new(time, high + atr14 * 0.8, "TP1", style=label.style_label_down, color=color.new(color.green, 20), textcolor=color.white, size=size.small, tooltip=tp1_tt_l, xloc=xloc.bar_time)

if not exited_this_bar and pos == -1 and short_tp1_hit
    tp1_hit  := true
    trail_sl := entry_price   // Move SL to BE
    if show_entry_labels
        tp1_tt_s = "TP1 HIT - SHORT" + "\n" + "Entry: " + str.tostring(entry_price, format.mintick) + "\n" + "TP1:    " + str.tostring(tp1_price, format.mintick) + "\n" + "SL now at breakeven" + "\n" + "Trailing runner to TP2: " + str.tostring(tp2_price, format.mintick)
        label.new(time, low - atr14 * 0.8, "TP1", style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.small, tooltip=tp1_tt_s, xloc=xloc.bar_time)

// SL hit
if not exited_this_bar and pos == 1 and long_sl_hit
    float _pnl_lsl = trail_sl - entry_price
    if show_entry_labels
        close_tt_lsl = "EXIT: CLOSE LONG" + "\n" + "====================" + "\n" + "Reason:    Stop Loss Hit" + "\n" + "Open:       " + str.tostring(m5_o, format.mintick) + "\n" + "Close:       " + str.tostring(m5_c, format.mintick) + "\n" + "Entry:      " + str.tostring(entry_price, format.mintick) + "\n" + "Exit:         " + str.tostring(trail_sl, format.mintick) + "\n" + "P&L:         " + str.tostring(_pnl_lsl, format.mintick) + "\n" + "Result:      " + (_pnl_lsl >= 0 ? "PROFIT" : "LOSS") + "\n" + "Time: " + ts_str
        label.new(time, high + atr14 * 1.5, "CLOSE", style=label.style_label_down, color=_pnl_lsl >= 0 ? color.new(color.green, 0) : color.new(color.black, 0), textcolor=color.white, size=size.large, tooltip=close_tt_lsl, xloc=xloc.bar_time)
    equity += _pnl_lsl
    trades += 1
    if _pnl_lsl >= 0
        gross_profit += _pnl_lsl
        wins += 1
    else
        gross_loss += math.abs(_pnl_lsl)
        losses += 1
    peak_equity := math.max(peak_equity, equity)
    max_dd := math.max(max_dd, peak_equity - equity)
    pos          := 0
    trail_sl     := na
    tp1_hit      := false
    exited_this_bar := true

if not exited_this_bar and pos == -1 and short_sl_hit
    float _pnl_ssl = entry_price - trail_sl
    if show_entry_labels
        close_tt_ssl = "EXIT: CLOSE SHORT" + "\n" + "====================" + "\n" + "Reason:    Stop Loss Hit" + "\n" + "Open:       " + str.tostring(m5_o, format.mintick) + "\n" + "Close:       " + str.tostring(m5_c, format.mintick) + "\n" + "Entry:      " + str.tostring(entry_price, format.mintick) + "\n" + "Exit:         " + str.tostring(trail_sl, format.mintick) + "\n" + "P&L:         " + str.tostring(_pnl_ssl, format.mintick) + "\n" + "Result:      " + (_pnl_ssl >= 0 ? "PROFIT" : "LOSS") + "\n" + "Time: " + ts_str
        label.new(time, low - atr14 * 1.5, "CLOSE", style=label.style_label_up, color=_pnl_ssl >= 0 ? color.new(color.green, 0) : color.new(color.black, 0), textcolor=color.white, size=size.large, tooltip=close_tt_ssl, xloc=xloc.bar_time)
    equity += _pnl_ssl
    trades += 1
    if _pnl_ssl >= 0
        gross_profit += _pnl_ssl
        wins += 1
    else
        gross_loss += math.abs(_pnl_ssl)
        losses += 1
    peak_equity := math.max(peak_equity, equity)
    max_dd := math.max(max_dd, peak_equity - equity)
    pos          := 0
    trail_sl     := na
    tp1_hit      := false
    exited_this_bar := true

// --- ENTRIES ---
var int last_alert_bar = na

if not exited_this_bar and pos == 0 and long_entry_raw
    entry_price := m5_c
    sl_price    := f_long_sl(active_ob_bot)
    risk        = entry_price - sl_price
    tp1_price   := entry_price + risk * tp1_rr
    tp2_price   := entry_price + risk * tp2_rr
    trail_sl    := sl_price
    tp1_hit     := false
    pos         := 1
    entry_bar   := bar_index
    entry_time  := time

    if show_entry_labels
        buy_tt = "ENTRY: BUY" + "\n" + "====================" + "\n" + "Pair:        " + syminfo.ticker + "\n" + "Open:       " + str.tostring(m5_o, format.mintick) + "\n" + "Close:       " + str.tostring(m5_c, format.mintick) + "\n" + "Entry:      " + str.tostring(entry_price, format.mintick) + "\n" + "Stop Loss: " + str.tostring(sl_price, format.mintick) + "\n" + "TP1:          " + str.tostring(tp1_price, format.mintick) + "\n" + "TP2:          " + str.tostring(tp2_price, format.mintick) + "\n" + "====================" + "\n" + "WHY THIS TRADE:" + "\n" + "HTF3 (" + htf3_in + "): " + (daily_struct == 1 ? "BULLISH" : daily_struct == -1 ? "BEARISH" : "FLAT") + "\n" + "HTF2 (" + htf2_in + "): " + (h4_struct == 1 ? "BULLISH" : h4_struct == -1 ? "BEARISH" : "FLAT") + "\n" + "HTF1 (" + htf1_in + "): " + (h1_struct == 1 ? "BULLISH" : h1_struct == -1 ? "BEARISH" : "FLAT") + "\n" + "In OB:       " + (in_bull_ob ? "YES" : "NO") + "\n" + "In FVG:     " + (in_bull_fvg ? "YES" : "NO") + "\n" + "MSS 5M:    YES" + "\n" + "Window:   " + kz_name + "\n" + "====================" + "\n" + "Time: " + ts_str
        label.new(time, low - atr14 * 1.5, "BUY", style=label.style_label_up, color=color.new(color.blue, 0), textcolor=color.white, size=size.large, tooltip=buy_tt, xloc=xloc.bar_time)

    if show_sl_line
        line.new(bar_index, sl_price, bar_index + 20, sl_price,
                 color=color.new(color.red, 0), width=1, style=line.style_dashed)

    if show_tp_lines
        line.new(bar_index, tp1_price, bar_index + 20, tp1_price,
                 color=color.new(color.green, 30), width=1, style=line.style_dotted)
        line.new(bar_index, tp2_price, bar_index + 20, tp2_price,
                 color=color.new(color.green, 0), width=1, style=line.style_dotted)

    // Alert
    if alert_on_entry and (na(last_alert_bar) or bar_index != last_alert_bar)
        risk_pts  = entry_price - sl_price
        tp1_val   = entry_price + risk_pts * tp1_rr
        tp2_val   = entry_price + risk_pts * tp2_rr
        conf_str  = in_bull_ob and in_bull_fvg ? "[OB+FVG+MSS]" : in_bull_ob ? "[OB+MSS]" : "[FVG+MSS]"
        msg = "{\"pair\":\"" + syminfo.ticker + "\",\"direction\":\"BUY\",\"entry\":" + str.tostring(entry_price, format.mintick) + ",\"sl\":" + str.tostring(sl_price, format.mintick) + ",\"tp1\":" + str.tostring(tp1_val, format.mintick) + ",\"tp2\":" + str.tostring(tp2_val, format.mintick) + ",\"killzone\":\"" + kz_name + "\",\"confluences\":\"" + conf_str + "\"}"
        alert(msg, alert.freq_once_per_bar)
        last_alert_bar := bar_index

if not exited_this_bar and pos == 0 and short_entry_raw
    entry_price := m5_c
    sl_price    := f_short_sl(active_bear_ob_top)
    risk        = sl_price - entry_price
    tp1_price   := entry_price - risk * tp1_rr
    tp2_price   := entry_price - risk * tp2_rr
    trail_sl    := sl_price
    tp1_hit     := false
    pos         := -1
    entry_bar   := bar_index
    entry_time  := time

    if show_entry_labels
        sell_tt = "ENTRY: SELL" + "\n" + "====================" + "\n" + "Pair:        " + syminfo.ticker + "\n" + "Open:       " + str.tostring(m5_o, format.mintick) + "\n" + "Close:       " + str.tostring(m5_c, format.mintick) + "\n" + "Entry:      " + str.tostring(entry_price, format.mintick) + "\n" + "Stop Loss: " + str.tostring(sl_price, format.mintick) + "\n" + "TP1:          " + str.tostring(tp1_price, format.mintick) + "\n" + "TP2:          " + str.tostring(tp2_price, format.mintick) + "\n" + "====================" + "\n" + "WHY THIS TRADE:" + "\n" + "HTF3 (" + htf3_in + "): " + (daily_struct == 1 ? "BULLISH" : daily_struct == -1 ? "BEARISH" : "FLAT") + "\n" + "HTF2 (" + htf2_in + "): " + (h4_struct == 1 ? "BULLISH" : h4_struct == -1 ? "BEARISH" : "FLAT") + "\n" + "HTF1 (" + htf1_in + "): " + (h1_struct == 1 ? "BULLISH" : h1_struct == -1 ? "BEARISH" : "FLAT") + "\n" + "In OB:       " + (in_bear_ob ? "YES" : "NO") + "\n" + "In FVG:     " + (in_bear_fvg ? "YES" : "NO") + "\n" + "MSS 5M:    YES" + "\n" + "Window:   " + kz_name + "\n" + "====================" + "\n" + "Time: " + ts_str
        label.new(time, high + atr14 * 1.5, "SELL", style=label.style_label_down, color=color.new(color.blue, 0), textcolor=color.white, size=size.large, tooltip=sell_tt, xloc=xloc.bar_time)

    if show_sl_line
        line.new(bar_index, sl_price, bar_index + 20, sl_price,
                 color=color.new(color.red, 0), width=1, style=line.style_dashed)

    if show_tp_lines
        line.new(bar_index, tp1_price, bar_index + 20, tp1_price,
                 color=color.new(color.green, 30), width=1, style=line.style_dotted)
        line.new(bar_index, tp2_price, bar_index + 20, tp2_price,
                 color=color.new(color.green, 0),  width=1, style=line.style_dotted)

    if alert_on_entry and (na(last_alert_bar) or bar_index != last_alert_bar)
        risk_pts  = sl_price - entry_price
        tp1_val   = entry_price - risk_pts * tp1_rr
        tp2_val   = entry_price - risk_pts * tp2_rr
        conf_str  = in_bear_ob and in_bear_fvg ? "[OB+FVG+MSS]" : in_bear_ob ? "[OB+MSS]" : "[FVG+MSS]"
        msg = "{\"pair\":\"" + syminfo.ticker + "\",\"direction\":\"SELL\",\"entry\":" + str.tostring(entry_price, format.mintick) + ",\"sl\":" + str.tostring(sl_price, format.mintick) + ",\"tp1\":" + str.tostring(tp1_val, format.mintick) + ",\"tp2\":" + str.tostring(tp2_val, format.mintick) + ",\"killzone\":\"" + kz_name + "\",\"confluences\":\"" + conf_str + "\"}"
        alert(msg, alert.freq_once_per_bar)
        last_alert_bar := bar_index

// --- TRAILING SL UPDATE (after TP1, trail the runner) ---
if pos == 1 and tp1_hit
    candidate = f_trail_long()
    if not na(candidate) and candidate > trail_sl and candidate < m5_c
        if show_trail_dots
            label.new(bar_index, candidate - atr14 * 0.3, "",
                      style=label.style_circle, color=color.new(color.green, 0), size=size.tiny)
        trail_sl := candidate

if pos == -1 and tp1_hit
    candidate = f_trail_short()
    // For shorts: move SL down (lower high = tighter stop = more profit locked)
    // candidate < trail_sl = new highest high is lower than current SL (good, move it down)
    // candidate > close = don't move SL below current price (would cause immediate exit)
    if not na(candidate) and candidate < trail_sl and candidate > m5_c
        if show_trail_dots
            label.new(bar_index, candidate + atr14 * 0.3, "",
                      style=label.style_circle, color=color.new(color.red, 0), size=size.tiny)
        trail_sl := candidate

// ============================================================================
// TRADE WINDOW BACKGROUND
// ============================================================================
bgcolor(in_london and kz_london_on ? kz_london_col : na, title="London Window")
bgcolor(in_ny     and kz_ny_on     ? kz_ny_col     : na, title="NY Window")

// ============================================================================
// TRAILING SL PLOT
// ============================================================================
plot(pos != 0 and not na(trail_sl) ? trail_sl : na,
     title="Trail SL", color=color.new(color.orange, 0),
     linewidth=2, style=plot.style_stepline)

// ============================================================================
// BIAS LABEL (top right)
// ============================================================================
var label bias_lbl = na
if show_bias_label and barstate.islast
    label.delete(bias_lbl)
    bias_txt   = bias_bull ? "^ BULLISH BIAS" : bias_bear ? "v BEARISH BIAS" : "- NO BIAS"
    bias_col   = bias_bull ? color.new(color.green, 0) : bias_bear ? color.new(color.red, 0) : color.new(color.gray, 0)
    bias_lbl  := label.new(bar_index + 3, high,
                           bias_txt + "\nD: " + (daily_struct == 1 ? "^" : daily_struct == -1 ? "v" : "-") +
                           "  4H: " + (h4_struct == 1 ? "^" : h4_struct == -1 ? "v" : "-") +
                           "  1H: " + (h1_struct == 1 ? "^" : h1_struct == -1 ? "v" : "-"),
                           style=label.style_label_left,
                           color=bias_col, textcolor=color.white, size=size.normal)

// ============================================================================
// ============================================================================
// ============================================================================
// ============================================================================
// HUD TABLE - White background, colored text only, with trade log
// ============================================================================
win_rate = (wins + losses) > 0 ? (float(wins) / float(wins + losses)) * 100.0 : 0.0
net_pnl  = gross_profit - gross_loss

p_dir    = pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "FLAT"
p_col    = pos == 1 ? color.new(color.green, 0) : pos == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)
p_entry  = pos != 0 ? str.tostring(entry_price, format.mintick) : "---"
p_sl     = pos != 0 ? str.tostring(trail_sl,    format.mintick) : "---"
p_tp1    = pos != 0 ? str.tostring(tp1_price,   format.mintick) : "---"
p_tp2    = pos != 0 ? str.tostring(tp2_price,   format.mintick) : "---"
p_stat   = tp1_hit ? "TP1 hit - trailing" : pos != 0 ? "Waiting for TP1" : "---"
p_statc  = tp1_hit ? color.new(color.green, 0) : color.new(color.gray, 0)
d_str    = daily_struct == 1 ? "BULLISH" : daily_struct == -1 ? "BEARISH" : "FLAT"
h4_str   = h4_struct  == 1 ? "BULLISH" : h4_struct  == -1 ? "BEARISH" : "FLAT"
h1_str   = h1_struct  == 1 ? "BULLISH" : h1_struct  == -1 ? "BEARISH" : "FLAT"
d_col    = daily_struct == 1 ? color.new(color.green, 0) : daily_struct == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)
h4_col   = h4_struct  == 1 ? color.new(color.green, 0) : h4_struct  == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)
h1_col   = h1_struct  == 1 ? color.new(color.green, 0) : h1_struct  == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)
kz_str   = tw_london ? "LONDON" : tw_ny ? "NEW YORK" : "CLOSED"
kz_col   = in_kz_5m ? color.new(color.green, 0) : color.new(color.red, 0)
wr_col   = win_rate >= 50 ? color.new(color.green, 0) : color.new(color.red, 0)
pnl_col  = net_pnl >= 0 ? color.new(color.green, 0) : color.new(color.red, 0)
sig_all_b = bias_bull and poi_bull and mss_bull_trade and in_kz_5m
sig_all_s = bias_bear and poi_bear and mss_bear_trade and in_kz_5m
sig_txt   = sig_all_b ? "LONG SIGNAL READY" : sig_all_s ? "SHORT SIGNAL READY" : "No signal yet"
sig_col   = sig_all_b ? color.new(color.green, 0) : sig_all_s ? color.new(color.red, 0) : color.new(color.gray, 0)

W   = color.white
BK  = color.new(color.black, 0)
GR  = color.new(color.gray, 20)
SZ  = size.normal
SZS = size.small

var table hud = table.new(position.bottom_right, 2, 20, frame_color=color.new(color.gray, 50), frame_width=1, border_color=color.new(color.gray, 70), border_width=1)

if show_hud
    // Row 0 - Title + timestamp
    table.cell(hud, 0, 0, "ICT / SMC  Phase 1", bgcolor=W, text_color=BK, text_size=size.large)
    table.cell(hud, 1, 0, ts_str,                bgcolor=W, text_color=GR, text_size=SZS)

    // Row 1 - Trade Window
    table.cell(hud, 0, 1, "Trade Window", bgcolor=W, text_color=BK,    text_size=SZ)
    table.cell(hud, 1, 1, kz_str,         bgcolor=W, text_color=kz_col, text_size=SZ)

    // Row 2 - Section
    table.cell(hud, 0, 2, "OPEN POSITION", bgcolor=W, text_color=GR, text_size=SZS)
    table.cell(hud, 1, 2, "",              bgcolor=W, text_color=GR, text_size=SZS)

    // Row 3 - Direction
    table.cell(hud, 0, 3, "Direction", bgcolor=W, text_color=BK,   text_size=SZ)
    table.cell(hud, 1, 3, p_dir,       bgcolor=W, text_color=p_col, text_size=size.large)

    // Row 4 - Entry
    table.cell(hud, 0, 4, "Entry",  bgcolor=W, text_color=BK, text_size=SZ)
    table.cell(hud, 1, 4, p_entry,  bgcolor=W, text_color=BK, text_size=SZ)

    // Row 5 - Stop Loss
    table.cell(hud, 0, 5, "Stop Loss", bgcolor=W, text_color=BK,                      text_size=SZ)
    table.cell(hud, 1, 5, p_sl,        bgcolor=W, text_color=color.new(color.red, 0), text_size=SZ)

    // Row 6 - TP1
    table.cell(hud, 0, 6, "TP1",  bgcolor=W, text_color=BK,                        text_size=SZ)
    table.cell(hud, 1, 6, p_tp1,  bgcolor=W, text_color=color.new(color.green, 0), text_size=SZ)

    // Row 7 - TP2
    table.cell(hud, 0, 7, "TP2",  bgcolor=W, text_color=BK,                        text_size=SZ)
    table.cell(hud, 1, 7, p_tp2,  bgcolor=W, text_color=color.new(color.green, 0), text_size=SZ)

    // Row 8 - Status
    table.cell(hud, 0, 8, "Status", bgcolor=W, text_color=BK,     text_size=SZS)
    table.cell(hud, 1, 8, p_stat,   bgcolor=W, text_color=p_statc, text_size=SZS)

    // Row 9 - Section
    table.cell(hud, 0, 9, "BIAS STACK", bgcolor=W, text_color=GR, text_size=SZS)
    table.cell(hud, 1, 9, "",            bgcolor=W, text_color=GR, text_size=SZS)

    // Row 10 - Daily
    table.cell(hud, 0, 10, "HTF3 (" + htf3_in + ")", bgcolor=W, text_color=BK, text_size=SZ)
    table.cell(hud, 1, 10, d_str,    bgcolor=W, text_color=d_col, text_size=SZ)

    // Row 11 - 4H
    table.cell(hud, 0, 11, "HTF2 (" + htf2_in + ")", bgcolor=W, text_color=BK, text_size=SZ)
    table.cell(hud, 1, 11, h4_str,   bgcolor=W, text_color=h4_col, text_size=SZ)

    // Row 12 - 1H
    table.cell(hud, 0, 12, "HTF1 (" + htf1_in + ")", bgcolor=W, text_color=BK, text_size=SZ)
    table.cell(hud, 1, 12, h1_str,   bgcolor=W, text_color=h1_col, text_size=SZ)

    // Row 13 - Signal
    table.cell(hud, 0, 13, "Signal", bgcolor=W, text_color=BK,    text_size=SZ)
    table.cell(hud, 1, 13, sig_txt,  bgcolor=W, text_color=sig_col, text_size=SZ)

    // Row 14 - Section
    table.cell(hud, 0, 14, "TRADE HISTORY", bgcolor=W, text_color=GR, text_size=SZS)
    table.cell(hud, 1, 14, str.tostring(trades) + " trades", bgcolor=W, text_color=GR, text_size=SZS)

    // Row 15 - Win Rate
    table.cell(hud, 0, 15, "Win Rate", bgcolor=W, text_color=BK,   text_size=SZ)
    table.cell(hud, 1, 15, str.tostring(win_rate, "#.0") + "%  (" + str.tostring(wins) + "W / " + str.tostring(losses) + "L)", bgcolor=W, text_color=wr_col, text_size=SZ)

    // Row 16 - Net P&L
    table.cell(hud, 0, 16, "Net P&L", bgcolor=W, text_color=BK,    text_size=SZ)
    table.cell(hud, 1, 16, str.tostring(net_pnl, format.mintick),   bgcolor=W, text_color=pnl_col, text_size=SZ)

    // Row 17 - Gross Profit
    table.cell(hud, 0, 17, "Gross Profit", bgcolor=W, text_color=BK,                        text_size=SZ)
    table.cell(hud, 1, 17, str.tostring(gross_profit, format.mintick), bgcolor=W, text_color=color.new(color.green, 0), text_size=SZ)

    // Row 18 - Gross Loss
    table.cell(hud, 0, 18, "Gross Loss", bgcolor=W, text_color=BK,                      text_size=SZ)
    table.cell(hud, 1, 18, str.tostring(gross_loss,   format.mintick), bgcolor=W, text_color=color.new(color.red, 0),   text_size=SZ)

    // Row 19 - Max DD
    table.cell(hud, 0, 19, "Max Drawdown", bgcolor=W, text_color=BK,                         text_size=SZ)
    table.cell(hud, 1, 19, str.tostring(max_dd, format.mintick), bgcolor=W, text_color=color.new(color.orange, 0), text_size=SZ)





