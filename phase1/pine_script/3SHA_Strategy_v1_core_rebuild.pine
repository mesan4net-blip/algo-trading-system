//@version=6
// ============================================================================
// 3SHA STRATEGY v1 — CORE REBUILD
// Three Smoothed Heikin Ashi — clean Entry → SL → Trail → Exit core
// Markers, partials, and HUD layered back on only after this core is verified
// ============================================================================
strategy("3SHA Strategy — Core Rebuild", shorttitle="3SHA-Core", overlay=true,
         initial_capital=100000, currency=currency.USD,
         default_qty_type=strategy.fixed, default_qty_value=1,
         calc_on_every_tick=false, process_orders_on_close=false,
         max_bars_back=5000)

// ============================================================================
// SHA FUNCTION — Two-pass: EMA → HA → EMA
// ============================================================================
f_sha(_len1, _len2, _o, _h, _l, _c) =>
    o1  = ta.ema(_o, _len1)
    h1  = ta.ema(_h, _len1)
    l1  = ta.ema(_l, _len1)
    c1  = ta.ema(_c, _len1)
    haC = (o1 + h1 + l1 + c1) / 4.0
    var float haO = na
    haO := na(haO[1]) ? (o1 + c1) / 2.0 : (haO[1] + haC[1]) / 2.0
    haH = math.max(h1, math.max(haO, haC))
    haL = math.min(l1, math.min(haO, haC))
    o2  = ta.ema(haO, _len2)
    h2  = ta.ema(haH, _len2)
    l2  = ta.ema(haL, _len2)
    c2  = ta.ema(haC, _len2)
    [o2, h2, l2, c2]

// ============================================================================
// INPUTS — SHA LAYERS
// ============================================================================
grp_base = "Base SHA [Chart TF]"
base_len1 = input.int(4, "Stage-1 EMA", minval=1, group=grp_base)
base_len2 = input.int(8, "Stage-2 EMA", minval=1, group=grp_base)
base_show = input.bool(true, "Show Base Candles", group=grp_base)

grp_htf1 = "HTF1 SHA [Mid TF]"
htf1_tf   = input.timeframe("60", "HTF1 Timeframe", group=grp_htf1)
htf1_len1 = input.int(4, "Stage-1 EMA", minval=1, group=grp_htf1)
htf1_len2 = input.int(8, "Stage-2 EMA", minval=1, group=grp_htf1)
htf1_show = input.bool(true, "Show HTF1 Candles", group=grp_htf1)

grp_htf2 = "HTF2 SHA [High TF]"
htf2_tf   = input.timeframe("240", "HTF2 Timeframe", group=grp_htf2)
htf2_len1 = input.int(4, "Stage-1 EMA", minval=1, group=grp_htf2)
htf2_len2 = input.int(8, "Stage-2 EMA", minval=1, group=grp_htf2)
htf2_show = input.bool(true, "Show HTF2 Candles", group=grp_htf2)

// ============================================================================
// INPUTS — EMA FILTER
// ============================================================================
grp_ema = "EMA Filter"
use_ema = input.bool(true, "Enable EMA Direction Filter", group=grp_ema)
ema_len = input.int(200, "EMA Length", minval=1, group=grp_ema)

// ============================================================================
// INPUTS — ENTRY CONDITIONS
// ============================================================================
grp_entry = "Entry Conditions"
use_sess_filter = input.bool(true, "Session Filter — London + New York Only", group=grp_entry)
use_gap_filter  = input.bool(true, "Block Gap Bar Entries", group=grp_entry)

show_full_alignment = input.bool(false, "Full Alignment",
     tooltip="All three SHA layers (Base, HTF1, HTF2) are now pointing the same direction. Highest confidence, but slowest to fire.",
     group=grp_entry)

show_cluster_cross = input.bool(false, "Full Cluster Cross",
     tooltip="Price has broken completely through all three SHA layers in a single move — from fully below to fully above (or vice versa). Strong, decisive momentum signal.",
     group=grp_entry)

show_pullback_resume = input.bool(true, "Pullback Resume",
     tooltip="Base price dipped into the trend (as far as HTF2) and has now recovered back in the original direction. Classic 'buy the dip' / 'sell the rally' continuation signal.",
     group=grp_entry)

show_early_trend = input.bool(false, "Early Trend Signal",
     tooltip="Base and HTF1 are now aligned with each other, while HTF2 (the slowest layer) is still catching up. Fires earlier than Full Alignment, at the cost of some confirmation.",
     group=grp_entry)

early_trend_tier = input.string("Tier 1 — Early Cross", "Early Trend Signal — Confirmation Level",
     options=["Tier 1 — Early Cross", "Tier 2 — Confirmed Cross"],
     tooltip="Tier 1 — Early Cross: Base has closed past HTF2. HTF1 agrees in direction, but hasn't crossed HTF2 itself yet.\n\nTier 2 — Confirmed Cross: Both Base AND HTF1 have closed past HTF2. Stronger confirmation than Tier 1, still earlier than waiting for HTF2 to flip.",
     group=grp_entry)

// ============================================================================
// INPUTS — STOP LOSS
// ============================================================================
grp_sl = "Stop Loss"
sl_method   = input.string("Prev N Bars Low/High", "SL Method", options=["Trade Candle Low/High","Prev N Bars Low/High"], group=grp_sl)
sl_lookback = input.int(30, "Lookback N Bars", minval=1, maxval=100, group=grp_sl)
sl_buffer   = input.float(2.0, "Buffer (pips)", minval=0, step=0.5, group=grp_sl)
show_sl_dot = input.bool(true, "Show Initial SL Dot", group=grp_sl)

// ============================================================================
// INPUTS — TRAIL
// ============================================================================
grp_trail = "Trail"
trail_trigger = input.string("Touch", "Trail Trigger", options=["Touch","Close Beyond"], group=grp_trail)
trail_bars    = input.int(30, "Trail Lookback Bars", minval=1, maxval=100, group=grp_trail)
show_trail    = input.bool(true, "Show Trail Line", group=grp_trail)

// ============================================================================
// INPUTS — POSITION SIZING
// ============================================================================
grp_risk = "Position Sizing"
pip_divisor       = input.float(0.0001, "Pip Size", minval=0.00001, step=0.00001, group=grp_risk)
auto_pip_value    = input.bool(true, "Auto-Calculate Pip Value Per Lot", group=grp_risk)
pip_value_manual  = input.float(10.0, "Manual Pip Value Override (USD)", minval=0.01, group=grp_risk)
risk_pct          = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=10.0, step=0.1, group=grp_risk)

// ============================================================================
// COMPUTE SHA LAYERS
// ============================================================================
[bO, bH, bL, bC] = f_sha(base_len1, base_len2, open, high, low, close)

// Pull the LAST CONFIRMED HTF bar — not the live, still-forming one.
// Per TradingView's official non-repainting pattern: offset the expression by [1]
// AND use barmerge.lookahead_on together. This combination is required —
// lookahead_off with an offset expression produces persistent na values.
// The [1] offset means we always get the last CLOSED HTF bar, never the live one.
htf1_o = request.security(syminfo.tickerid, htf1_tf, open[1],  barmerge.gaps_off, barmerge.lookahead_on)
htf1_h = request.security(syminfo.tickerid, htf1_tf, high[1],  barmerge.gaps_off, barmerge.lookahead_on)
htf1_l = request.security(syminfo.tickerid, htf1_tf, low[1],   barmerge.gaps_off, barmerge.lookahead_on)
htf1_c = request.security(syminfo.tickerid, htf1_tf, close[1], barmerge.gaps_off, barmerge.lookahead_on)
[h1O, h1H, h1L, h1C] = f_sha(htf1_len1, htf1_len2, htf1_o, htf1_h, htf1_l, htf1_c)

htf2_o = request.security(syminfo.tickerid, htf2_tf, open[1],  barmerge.gaps_off, barmerge.lookahead_on)
htf2_h = request.security(syminfo.tickerid, htf2_tf, high[1],  barmerge.gaps_off, barmerge.lookahead_on)
htf2_l = request.security(syminfo.tickerid, htf2_tf, low[1],   barmerge.gaps_off, barmerge.lookahead_on)
htf2_c = request.security(syminfo.tickerid, htf2_tf, close[1], barmerge.gaps_off, barmerge.lookahead_on)
[h2O, h2H, h2L, h2C] = f_sha(htf2_len1, htf2_len2, htf2_o, htf2_h, htf2_l, htf2_c)

// ============================================================================
// EMA FILTER
// ============================================================================
ema_val = ta.ema(close, ema_len)

// ============================================================================
// LAYER DIRECTION
// ============================================================================
base_ready = not na(bO) and not na(bC)
htf1_ready = not na(h1O) and not na(h1C)
htf2_ready = not na(h2O) and not na(h2C)
all_ready  = base_ready and htf1_ready and htf2_ready

base_bull_bar = bC  >= bO
htf1_bull_bar = h1C >= h1O
htf2_bull_bar = h2C >= h2O
base_bear_bar = bC  < bO
htf1_bear_bar = h1C < h1O
htf2_bear_bar = h2C < h2O

all_bull = all_ready and base_bull_bar and htf1_bull_bar and htf2_bull_bar
all_bear = all_ready and base_bear_bar and htf1_bear_bar and htf2_bear_bar

// ============================================================================
// SESSION DETECTION
// ============================================================================
in_lon_full = not na(time("", "0300-1200", "America/New_York"))
in_ny_full  = not na(time("", "0800-1700", "America/New_York"))
in_session  = in_lon_full or in_ny_full

// ============================================================================
// GAP FILTER
// ============================================================================
gap_bar = (low > high[1]) or (high < low[1])

// ============================================================================
// EMA DIRECTION GATE
// ============================================================================
ema_allow_long  = not use_ema or close > ema_val
ema_allow_short = not use_ema or close < ema_val

// ============================================================================
// SHA BODY BOUNDS
// ============================================================================
sha_top_b = math.max(bO,  bC)
sha_top_1 = math.max(h1O, h1C)
sha_top_2 = math.max(h2O, h2C)
sha_bot_b = math.min(bO,  bC)
sha_bot_1 = math.min(h1O, h1C)
sha_bot_2 = math.min(h2O, h2C)

// ============================================================================
// FULL CLUSTER CROSS — price breaks completely through all 3 SHA layers
// ============================================================================
was_below_all = close[1] < sha_bot_b[1] and close[1] < sha_bot_1[1] and close[1] < sha_bot_2[1]
was_above_all = close[1] > sha_top_b[1] and close[1] > sha_top_1[1] and close[1] > sha_top_2[1]
now_above_all = close > sha_top_b and close > sha_top_1 and close > sha_top_2
now_below_all = close < sha_bot_b and close < sha_bot_1 and close < sha_bot_2
cluster_cross_bull_sig = was_below_all and now_above_all
cluster_cross_bear_sig = was_above_all and now_below_all

// ============================================================================
// PULLBACK RESUME — Base dips below/above HTF1 body (as far as HTF2), then recovers
// ============================================================================
var bool pb_bull_dipped = false
var bool pb_bear_dipped = false

// Valid dip — Base has crossed below HTF1's body (entering pullback zone),
// dip zone extends all the way through HTF2's body — still a valid pullback
// as long as Base does NOT close fully below HTF2's bottom.
bull_dip_condition  = bC < sha_top_1 and bC >= sha_bot_2
// Invalid — Base closes fully below HTF2's bottom = trend break, not a pullback
bull_dip_invalidated = bC < sha_bot_2
bull_recovery        = bC > sha_top_1

bear_dip_condition   = bC > sha_bot_1 and bC <= sha_top_2
bear_dip_invalidated = bC > sha_top_2
bear_recovery        = bC < sha_bot_1

if bull_dip_condition
    pb_bull_dipped := true
if bull_dip_invalidated or bull_recovery
    pb_bull_dipped := false

if bear_dip_condition
    pb_bear_dipped := true
if bear_dip_invalidated or bear_recovery
    pb_bear_dipped := false

pullback_resume_bull_sig = bull_recovery and pb_bull_dipped[1] and htf2_bull_bar
pullback_resume_bear_sig = bear_recovery and pb_bear_dipped[1] and htf2_bear_bar

// ============================================================================
// FULL ALIGNMENT — all 3 SHA layers flip into the same direction together
// ============================================================================
full_alignment_bull_sig = all_bull and not all_bull[1]
full_alignment_bear_sig = all_bear and not all_bear[1]

// ============================================================================
// EARLY TREND SIGNAL — Base + HTF1 agree while HTF2 still catching up
// Tier 1 — Early Cross:     Base closes past HTF2, HTF1 agrees in direction
// Tier 2 — Confirmed Cross: Both Base AND HTF1 close past HTF2
// ============================================================================
base_htf1_agree_bull = base_bull_bar and htf1_bull_bar
base_htf1_agree_bear = base_bear_bar and htf1_bear_bar

base_crossed_htf2_bull = bC  > sha_top_2
htf1_crossed_htf2_bull = h1C > sha_top_2
base_crossed_htf2_bear = bC  < sha_bot_2
htf1_crossed_htf2_bear = h1C < sha_bot_2

early_trend_tier1_bull = base_htf1_agree_bull and base_crossed_htf2_bull
early_trend_tier1_bear = base_htf1_agree_bear and base_crossed_htf2_bear

early_trend_tier2_bull = base_htf1_agree_bull and base_crossed_htf2_bull and htf1_crossed_htf2_bull
early_trend_tier2_bear = base_htf1_agree_bear and base_crossed_htf2_bear and htf1_crossed_htf2_bear

early_trend_sig_bull_raw = early_trend_tier == "Tier 1 — Early Cross" ? early_trend_tier1_bull : early_trend_tier2_bull
early_trend_sig_bear_raw = early_trend_tier == "Tier 1 — Early Cross" ? early_trend_tier1_bear : early_trend_tier2_bear

// Fire only on the bar the condition first becomes true — not every bar it remains true
early_trend_sig_bull = early_trend_sig_bull_raw and not early_trend_sig_bull_raw[1]
early_trend_sig_bear = early_trend_sig_bear_raw and not early_trend_sig_bear_raw[1]

// ============================================================================
// ENTRY LOGIC — toggle ON = trade trigger, no pyramiding in this core build
// ============================================================================
entry_sig_bull = (show_full_alignment and full_alignment_bull_sig) or (show_cluster_cross and cluster_cross_bull_sig) or (show_pullback_resume and pullback_resume_bull_sig) or (show_early_trend and early_trend_sig_bull)
entry_sig_bear = (show_full_alignment and full_alignment_bear_sig) or (show_cluster_cross and cluster_cross_bear_sig) or (show_pullback_resume and pullback_resume_bear_sig) or (show_early_trend and early_trend_sig_bear)

entry_long_raw  = entry_sig_bull[1] and ema_allow_long  and (not use_sess_filter or in_session[1]) and (not use_gap_filter or not gap_bar) and all_ready
entry_short_raw = entry_sig_bear[1] and ema_allow_short and (not use_sess_filter or in_session[1]) and (not use_gap_filter or not gap_bar) and all_ready

entry_long  = entry_long_raw  and strategy.position_size == 0
entry_short = entry_short_raw and strategy.position_size == 0

// ============================================================================
// STOP LOSS CALCULATION
// ============================================================================
f_sl_long() =>
    float sl = na
    if sl_method == "Trade Candle Low/High"
        sl := low - sl_buffer * pip_divisor
    else
        lowest = low[1]
        for i = 1 to sl_lookback
            if low[i] < lowest
                lowest := low[i]
        sl := lowest - sl_buffer * pip_divisor
    sl

f_sl_short() =>
    float sl = na
    if sl_method == "Trade Candle Low/High"
        sl := high + sl_buffer * pip_divisor
    else
        highest = high[1]
        for i = 1 to sl_lookback
            if high[i] > highest
                highest := high[i]
        sl := highest + sl_buffer * pip_divisor
    sl

// ============================================================================
// AUTO PIP VALUE
// ============================================================================
pip_value_auto_calc = pip_divisor * syminfo.pointvalue * 100000
pip_value_per_lot   = auto_pip_value ? pip_value_auto_calc : pip_value_manual

// ============================================================================
// POSITION SIZING — returns UNITS
// ============================================================================
f_qty(_entry, _sl) =>
    risk_usd = strategy.equity * (risk_pct / 100.0)
    sl_pips  = math.abs(_entry - _sl) / pip_divisor
    lots     = sl_pips > 0 ? risk_usd / (sl_pips * pip_value_per_lot) : 1.0
    units    = lots * 100000
    math.max(units, 1000)

// ============================================================================
// TRAIL FUNCTIONS — rolling real-price candle low/high only (core build)
// ============================================================================
f_trail_long() =>
    t = low[1]
    for i = 2 to trail_bars
        if low[i] < t
            t := low[i]
    t

f_trail_short() =>
    t = high[1]
    for i = 2 to trail_bars
        if high[i] > t
            t := high[i]
    t

// ============================================================================
// COLOR + SIZE HELPERS
// ============================================================================
BLUE = color.new(#0077BB, 0)
ORANGE = color.new(#EE7733, 0)
GREEN = color.new(#009900, 0)
BLACK = color.new(#000000, 0)
WHITE = color.white
atr14 = ta.atr(14)

// ============================================================================
// EXECUTE ENTRIES
// ============================================================================
var float entry_sl = na
var float entry_px = na
var float trail_level = na
var float last_entry_px = na

if entry_long
    entry_px    := open
    entry_sl    := f_sl_long()
    last_entry_px := entry_px
    qty = f_qty(entry_px, entry_sl)
    strategy.entry("Long", strategy.long, qty=qty)
    trail_level := f_trail_long()
    label.new(bar_index, low - atr14 * 1.5, str.tostring(entry_px, format.mintick), style=label.style_label_up, color=BLUE, textcolor=WHITE, size=size.small)
    if show_sl_dot
        label.new(bar_index, entry_sl, "", style=label.style_circle, color=BLACK, size=size.tiny)

if entry_short
    entry_px    := open
    entry_sl    := f_sl_short()
    last_entry_px := entry_px
    qty = f_qty(entry_px, entry_sl)
    strategy.entry("Short", strategy.short, qty=qty)
    trail_level := f_trail_short()
    label.new(bar_index, high + atr14 * 1.5, str.tostring(entry_px, format.mintick), style=label.style_label_down, color=ORANGE, textcolor=WHITE, size=size.small)
    if show_sl_dot
        label.new(bar_index, entry_sl, "", style=label.style_circle, color=BLACK, size=size.tiny)

// ============================================================================
// MANAGE OPEN POSITIONS — trail + exit
// ============================================================================
if strategy.position_size > 0
    new_trail = f_trail_long()
    if not na(new_trail) and (na(trail_level) or new_trail > trail_level)
        trail_level := new_trail
    trail_stop = math.min(trail_level, entry_sl)
    trail_hit  = trail_trigger == "Touch" ? low <= trail_stop : close <= trail_stop
    if trail_hit
        exit_px = math.min(open, trail_stop)
        pnl_amt = (exit_px - last_entry_px) * strategy.position_size
        exit_col = pnl_amt >= 0 ? GREEN : BLACK
        pnl_txt = pnl_amt >= 0 ? "+$" + str.tostring(math.round(pnl_amt, 2), "#,###.00") : "-$" + str.tostring(math.abs(math.round(pnl_amt, 2)), "#,###.00")
        strategy.close("Long", comment="Trail")
        label.new(bar_index, high + atr14 * 1.5, str.tostring(exit_px, format.mintick), style=label.style_label_down, color=exit_col, textcolor=WHITE, size=size.small)
        label.new(bar_index, high + atr14 * 2.3, pnl_txt, style=label.style_label_down, color=exit_col, textcolor=WHITE, size=size.tiny)
        trail_level := na

if strategy.position_size < 0
    new_trail = f_trail_short()
    if not na(new_trail) and (na(trail_level) or new_trail < trail_level)
        trail_level := new_trail
    trail_stop = math.max(trail_level, entry_sl)
    trail_hit  = trail_trigger == "Touch" ? high >= trail_stop : close >= trail_stop
    if trail_hit
        exit_px = math.max(open, trail_stop)
        pnl_amt = (last_entry_px - exit_px) * math.abs(strategy.position_size)
        exit_col = pnl_amt >= 0 ? GREEN : BLACK
        pnl_txt = pnl_amt >= 0 ? "+$" + str.tostring(math.round(pnl_amt, 2), "#,###.00") : "-$" + str.tostring(math.abs(math.round(pnl_amt, 2)), "#,###.00")
        strategy.close("Short", comment="Trail")
        label.new(bar_index, low - atr14 * 1.5, str.tostring(exit_px, format.mintick), style=label.style_label_up, color=exit_col, textcolor=WHITE, size=size.small)
        label.new(bar_index, low - atr14 * 2.3, pnl_txt, style=label.style_label_up, color=exit_col, textcolor=WHITE, size=size.tiny)
        trail_level := na

if strategy.position_size == 0
    trail_level := na
    entry_sl    := na

plot(show_trail and strategy.position_size != 0 and not na(trail_level) ? trail_level : na, title="Trail", color=ORANGE, linewidth=1, style=plot.style_stepline)

// ============================================================================
// DRAW SHA CANDLES
// ============================================================================
plotcandle(htf2_ready and htf2_show ? h2O : na, htf2_ready and htf2_show ? h2H : na, htf2_ready and htf2_show ? h2L : na, htf2_ready and htf2_show ? h2C : na,
     title="HTF2 SHA", color=h2C>=h2O?color.new(#117733,50):color.new(#CC3311,50), wickcolor=color.new(#000000,100), bordercolor=color.new(#000000,50))

plotcandle(htf1_ready and htf1_show ? h1O : na, htf1_ready and htf1_show ? h1H : na, htf1_ready and htf1_show ? h1L : na, htf1_ready and htf1_show ? h1C : na,
     title="HTF1 SHA", color=h1C>=h1O?color.new(#882255,25):color.new(#DDCC77,25), wickcolor=color.new(#000000,100), bordercolor=color.new(#000000,25))

plotcandle(base_ready and base_show ? bO : na, base_ready and base_show ? bH : na, base_ready and base_show ? bL : na, base_ready and base_show ? bC : na,
     title="Base SHA", color=bC>=bO?BLUE:ORANGE, wickcolor=color.new(#000000,100), bordercolor=color.new(#000000,0))
