//@version=6
// ============================================================================
// 3SHA — PRICE ABOVE ALL + RENKO FILTER STRATEGY  (v1)
// ============================================================================
// PART OF: the per-entry-type rebuild of 3SHA_Strategy_v6. Each entry type gets
//   its own script, owning its stop, sizing and trade management end to end.
//   This one trades PRICE ABOVE ALL, gated by a NON-REPAINTING RENKO filter.
//
// DERIVED FROM: 3SHA_PriceAboveAll_v1.pine — that file is unchanged. Every
//   entry rule, exit rule, stop, sizing rule and cost setting below is
//   inherited from it verbatim. The renko adds ONE gate on entries and
//   touches nothing else.
//
// WHY THE RENKO IS TRACKED, NOT CHARTED:
//   The chart stays on its normal time-based bars. The renko lives as a
//   number computed alongside them. This is what makes it non-repainting:
//     - box size is frozen for a calendar month, derived from the month
//       that already finished, and old bricks are never redrawn with a new
//       size;
//     - brick boundaries sit at absolute multiples of the box size counted
//       from zero, so loading more history does not move the grid;
//     - bricks form only on a CLOSED bar, off the close.
//   TradingView's built-in renko chart fails on all three counts.
//
// BACKTEST HONESTY:
//   Several bricks can print inside one bar. They change the renko
//   direction and nothing else — one decision per bar, filled at the real
//   bar close. A renko-charted backtest would instead treat each brick as
//   its own moment and let you buy the first and sell the last, a trade
//   that never existed. That is why renko backtests flatter to deceive.
//
// SIGNAL:
//   Not "which way is each layer pointing" — that is Full Alignment. This asks
//   WHERE PRICE IS SITTING relative to the three SHA layers. A layer can point
//   down while price sits above it, and the reverse, so the two fire at quite
//   different moments. "Price Must Clear" chooses how many layers price has to
//   close beyond; the single-layer options are the HTF price-cross signals from
//   the plan, folded in here.
//
// ELIGIBILITY — the rule that keeps the exits honest:
//   A SHA layer cannot end a trade until price has CLOSED beyond it during that
//   trade. Whatever the entry required is eligible from the entry bar; any other
//   layer joins the moment price closes past it, and stays for the rest of the
//   trade. Without this, a layer price never cleared could close the position on
//   the very next bar — a layer the setup never asked about.
//
// EXIT ANCHORS — the stop IS the exit:
//   Alongside the fixed layer anchors, three anchors rank the ELIGIBLE layers by
//   distance from price: Closest, Middle, Furthest. The ranking is recomputed
//   every bar, so "closest" always means the line price would reach first. Both
//   the initial stop and the trail can use them. Which edge of the SHA body the
//   level sits on follows the existing convention: the far edge, i.e. the body
//   bottom for a long and the body top for a short.
//
// LAYER-FLIP EXIT (optional, off by default):
//   A layer only counts as flipped if it was pointing WITH the trade at some
//   point during it and then turned. A layer already pointing against the trade
//   at entry is dormant — it never flipped, it was just sitting there. A flip
//   INTO the trade's direction arms a layer; it never exits one.
//
// EXIT PHILOSOPHY: all exits are CLOSE-BASED (mental-stop style) by default,
//   with an optional hard stop, and every exit path closes the position.
//
// TRADING COSTS: Pine requires these to be constants in the strategy() call, so
//   they cannot be script inputs. Set them below or override in the Properties
//   tab. They ship at zero — a zero-cost backtest is fine for reconciliation
//   against TradingView, but is not a tradeable result.
// ============================================================================

strategy("3SHA Price Above All + Renko", shorttitle="3SHA-PAAR", overlay=true,
     initial_capital=100000, currency=currency.USD,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     calc_on_every_tick=false, process_orders_on_close=true, pyramiding=0,
     max_bars_back=5000, max_labels_count=500, max_lines_count=500,
     commission_type=strategy.commission.percent, commission_value=0.0,
     slippage=0)

// ============================================================================
// SHA FUNCTION — Two-pass: EMA → HA → EMA   (identical to v6)
// ============================================================================
f_sha(_len1, _len2, _o, _h, _l, _c) =>
    o1  = ta.ema(_o, _len1)
    h1  = ta.ema(_h, _len1)
    l1  = ta.ema(_l, _len1)
    c1  = ta.ema(_c, _len1)
    haC = (o1 + h1 + l1 + c1) / 4.0
    var float haO = na
    haO := na(haO[1]) ? (o1 + c1) / 2.0 : (haO[1] + haC[1]) / 2.0
    haH = math.max(h1, math.max(haO, haC))
    haL = math.min(l1, math.min(haO, haC))
    o2  = ta.ema(haO, _len2)
    h2  = ta.ema(haH, _len2)
    l2  = ta.ema(haL, _len2)
    c2  = ta.ema(haC, _len2)
    [o2, h2, l2, c2]

// ============================================================================
// ① INSTRUMENT  (labels the position/HUD; stops & buffers are in price points $)
// ============================================================================
grp_inst = "① ━━━ INSTRUMENT ━━━"
instrument_type = input.string("Equity", "Instrument Type", options=["Equity","Crypto"], tooltip="Equity: share-based sizing. Crypto: coin-based sizing. Both express buffers/stops in price points ($) and use identical sizing math — the selection only labels the HUD.", group=grp_inst)

// ============================================================================
// ② SHA LAYERS
// ============================================================================
grp_layers_disp = "② ━━━ SHA DISPLAY  [all layers] ━━━"
show_wicks   = input.bool(false, "Show Wicks (all layers)",   group=grp_layers_disp)
show_borders = input.bool(true,  "Show Borders (all layers)", group=grp_layers_disp)

grp_base = "② ━━━ BASE SHA  [Chart TF] ━━━"
base_len1 = input.int(4, "Base Stage-1 EMA", minval=1, group=grp_base)
base_len2 = input.int(8, "Base Stage-2 EMA", minval=1, group=grp_base)
base_show = input.bool(true, "Show Base SHA Candles", group=grp_base)
base_bull = input.color(color.new(#2962FF, 0), "Bull Color", group=grp_base)
base_bear = input.color(color.new(#FF9800, 0), "Bear Color", group=grp_base)
base_border  = input.color(color.new(#000000, 0), "Border Color", group=grp_base)
base_wick    = input.color(color.new(#555555, 0), "Wick Color",   group=grp_base)
base_opacity = input.int(0, "Opacity (0=solid 100=invisible)", minval=0, maxval=100, group=grp_base)

grp_htf1 = "② ━━━ HTF1 SHA  [Mid TF] ━━━"
htf1_tf   = input.timeframe("60", "HTF1 Timeframe", group=grp_htf1)
htf1_len1 = input.int(4, "HTF1 Stage-1 EMA", minval=1, group=grp_htf1)
htf1_len2 = input.int(8, "HTF1 Stage-2 EMA", minval=1, group=grp_htf1)
htf1_show = input.bool(true, "Show HTF1 SHA Candles", group=grp_htf1)
htf1_bull = input.color(color.new(#2962FF, 0), "Bull Color", group=grp_htf1)
htf1_bear = input.color(color.new(#F23645, 0), "Bear Color", group=grp_htf1)
htf1_border_bull = input.color(color.new(#000000, 0), "Bull Border Color", group=grp_htf1)
htf1_border_bear = input.color(color.new(#000000, 0), "Bear Border Color", group=grp_htf1)
htf1_wick = input.color(color.new(#555555, 0), "Wick Color", group=grp_htf1)
htf1_opacity = input.int(25, "Opacity (0=solid 100=invisible)", minval=0, maxval=100, group=grp_htf1)

grp_htf2 = "② ━━━ HTF2 SHA  [High TF] ━━━"
htf2_tf   = input.timeframe("240", "HTF2 Timeframe", group=grp_htf2)
htf2_len1 = input.int(4, "HTF2 Stage-1 EMA", minval=1, group=grp_htf2)
htf2_len2 = input.int(8, "HTF2 Stage-2 EMA", minval=1, group=grp_htf2)
htf2_show = input.bool(true, "Show HTF2 SHA Candles", group=grp_htf2)
htf2_bull = input.color(color.new(#2962FF, 0), "Bull Color", group=grp_htf2)
htf2_bear = input.color(color.new(#F23645, 0), "Bear Color", group=grp_htf2)
htf2_border_bull = input.color(color.new(#000000, 0), "Bull Border Color", group=grp_htf2)
htf2_border_bear = input.color(color.new(#000000, 0), "Bear Border Color", group=grp_htf2)
htf2_wick = input.color(color.new(#555555, 0), "Wick Color", group=grp_htf2)
htf2_opacity = input.int(50, "Opacity (0=solid 100=invisible)", minval=0, maxval=100, group=grp_htf2)

// ============================================================================
// ⑨ RENKO FILTER  (non-repainting — see header)
// ============================================================================
grp_renko = "⑨ ━━━ RENKO FILTER ━━━"
renko_on       = input.bool(true, "Enable Renko Filter", tooltip="OFF = this script behaves identically to plain 3SHA-PAA, same trades, same numbers. That is the A/B test: run it off, run it on, compare.", group=grp_renko)
renko_reset    = input.string("Monthly", "Brick Size Reset", options=["Daily", "Weekly", "Monthly"], tooltip="How often the brick size is recalculated. Monthly: last month sizes this month. Daily: yesterday sizes today. Whatever is already painted never changes - a reset only affects bricks drawn from that point on.", group=grp_renko)
renko_size_tf  = input.timeframe("30", "Bar Timeframe For Brick Size", tooltip="Which bars are measured to size the brick. Read from this timeframe directly, never from your chart, so the brick size is the same number whether you are looking at a 5-minute chart or a weekly one.", group=grp_renko)
renko_mult     = input.float(1.0, "Brick Size Multiplier", minval=0.05, maxval=20.0, step=0.05, tooltip="Brick size = average range of those bars over the last period, times this. 1.0 means the brick is exactly the average bar range. Raise it for chunkier bricks and fewer signals.", group=grp_renko)
renko_round    = input.float(0.0001, "Round Box Size To Nearest", minval=0.0, step=0.0001, tooltip="Rounds the computed brick size to something clean, so the grid levels are readable. 0.0001 suits forex, 0.05 suits equities. 0 = no rounding.", group=grp_renko)
renko_min      = input.float(0.0, "Minimum Box Size", minval=0.0, step=0.0001, tooltip="Floor, so a dead month cannot produce a silly-small brick. 0 = use the rounding step as the floor.", group=grp_renko)
renko_rev      = input.int(2, "Boxes Needed To Reverse", minval=1, maxval=10, tooltip="How far price must travel against the current direction to turn the renko around. 2 is standard renko: one box to keep going, two to turn. 1 makes it flip on every crossing, which is far twitchier.", group=grp_renko)
renko_confirm  = input.int(1, "Bricks In New Direction Before Entries Unlock", minval=1, maxval=10, tooltip="Separate from the reversal rule above. 1 = entries unlock the moment direction flips. 2 or 3 makes the renko commit before entries are allowed, at the cost of getting in later.", group=grp_renko)
renko_show_hud = input.bool(true, "Show Renko Row In HUD", group=grp_renko)

// ── Compute layers (HTF layers smoothed NATIVELY inside request.security,
//    exactly as v6 — do NOT recompute HTF SHA on the chart TF) ──────────────
[bO, bH, bL, bC]  = f_sha(base_len1, base_len2, open, high, low, close)
[h1O, h1H, h1L, h1C] = request.security(syminfo.tickerid, htf1_tf, f_sha(htf1_len1, htf1_len2, open, high, low, close), barmerge.gaps_off, barmerge.lookahead_off)
[h2O, h2H, h2L, h2C] = request.security(syminfo.tickerid, htf2_tf, f_sha(htf2_len1, htf2_len2, open, high, low, close), barmerge.gaps_off, barmerge.lookahead_off)

// Daily open and PRIOR daily close, no look-ahead — for the gap-skip filter.
day_open  = request.security(syminfo.tickerid, "1D", open,      barmerge.gaps_off, barmerge.lookahead_off)
day_pclose= request.security(syminfo.tickerid, "1D", close[1],  barmerge.gaps_off, barmerge.lookahead_off)
gap_pct   = not na(day_open) and not na(day_pclose) and day_pclose != 0 ? math.abs(day_open - day_pclose) / day_pclose * 100.0 : 0.0

base_ready = not na(bO)  and not na(bC)
htf1_ready = not na(h1O) and not na(h1C)
htf2_ready = not na(h2O) and not na(h2C)
all_ready  = base_ready and htf1_ready and htf2_ready

base_bull_bar = bC  >= bO
htf1_bull_bar = h1C >= h1O
htf2_bull_bar = h2C >= h2O

// SHA body extremes — used for the SHA-body stop option
sha_bot_0 = math.min(bO, bC)      // chart-layer SHA body — the layer the entry fires on
sha_top_0 = math.max(bO, bC)
sha_top_1 = math.max(h1O, h1C)
sha_bot_1 = math.min(h1O, h1C)
sha_top_2 = math.max(h2O, h2C)
sha_bot_2 = math.min(h2O, h2C)

// ============================================================================
// RENKO ENGINE  (state only — nothing is drawn as a chart type)
// ============================================================================
// THE DAILY RANGE IS REQUESTED FROM THE DAILY TIMEFRAME, NEVER REBUILT FROM
// CHART BARS. This is the whole reason the brick size does not move when you
// change chart timeframe. Rebuilding each day's high and low from chart bars
// looks equivalent but is not: once a chart bar is a day or longer, every bar
// counts as its own "day", so on a weekly chart the "average daily range" is
// really an average weekly range and the brick comes out roughly twice as wide.
// Intraday, session gaps and extended hours pull it around the same way.
//
// [1] takes the last COMPLETED daily bar and lookahead_off blocks values from
// arriving before they exist, so nothing leaks in early on a fast chart.
// BRICK SIZE
// Average the range of every sizing bar in the period that just finished, then
// hold that number for the whole of the next period.
//
// The averaging runs INSIDE the sizing timeframe's own context, so the period
// boundaries are found on those bars and not on your chart's. That is what
// makes the number timeframe-proof: a 5-minute chart and a 4-hour chart both
// read the identical 30-minute candles and both arrive at the identical brick.
//
// Note the ordering. On the first bar of a new period the running total still
// holds the period that just ENDED, so it is banked first and only then reset.
// Nothing is ever sized from a period still in progress.
f_rk_avg(_reset) =>
    bool _new = ta.change(time(_reset)) != 0
    var float _sum  = 0.0
    var int   _n    = 0
    var float _held = na
    if _new
        _held := _n > 0 ? _sum / _n : _held
        _sum  := 0.0
        _n    := 0
    _sum := _sum + (high - low)
    _n   := _n + 1
    _held

rk_reset_tf = renko_reset == "Daily" ? "1D" : renko_reset == "Weekly" ? "1W" : "1M"

// CHART TYPE MUST NOT CHANGE THE NUMBERS EITHER.
// On a Heikin Ashi, Renko, Kagi, Point & Figure, Line Break or Range chart, the
// built-in close/high/low are the MODIFIED values, not real traded prices - and
// syminfo.tickerid carries the chart-type modifier with it, so even a data
// request inherits it. ticker.standard() strips that off and returns plain
// candles from the real symbol. Everything below is sized and stepped off real
// traded prices, so switching chart type leaves the bricks untouched.
rk_sym = ticker.standard(syminfo.tickerid)

rk_avg = request.security(rk_sym, renko_size_tf, f_rk_avg(rk_reset_tf),
             lookahead = barmerge.lookahead_off)

// The real traded close, for brick formation. Not the chart's close, which on a
// Heikin Ashi chart is an average of averages and never traded anywhere.
rk_close = request.security(rk_sym, timeframe.period, close,
             lookahead = barmerge.lookahead_off)

// rk_avg only moves at a period boundary, so the brick size holds steady in
// between and anything already painted keeps the size it was painted with.
float rk_box_calc = na
if not na(rk_avg) and rk_avg > 0
    float _raw   = rk_avg * renko_mult
    float _step  = renko_round > 0 ? renko_round : 0.0
    float _round = _step > 0 ? math.round(_raw / _step) * _step : _raw
    float _floor = renko_min > 0 ? renko_min : (_step > 0 ? _step : 0.0)
    rk_box_calc := math.max(_round, _floor)

var float rk_box = na
bool rk_box_new = not na(rk_box_calc) and (na(rk_box) or rk_box != rk_box_calc)
if rk_box_new
    rk_box := rk_box_calc

// Brick state. rk_dir: 1 up, -1 down, 0 not yet established.
// rk_run: bricks in a row in the current direction.
var float rk_top = na
var float rk_bot = na
var int   rk_dir = 0
var int   rk_run = 0

// A new box size means a new grid. Re-anchor SILENTLY: direction and run carry
// over untouched and no brick prints on this bar. A change in the measuring
// stick must never flip the signal by itself.
if rk_box_new and not na(rk_box) and rk_box > 0
    rk_bot := math.floor(rk_close / rk_box) * rk_box
    rk_top := rk_bot + rk_box

// Brick formation — closed bar only, close only, highs and lows ignored.
// Bounded loop rather than while: several bricks can print on one bar, and 200
// is far beyond anything real. If it were ever hit the state simply lags a bar.
if not rk_box_new and not na(rk_box) and rk_box > 0 and not na(rk_top)
    for _i = 0 to 199
        bool _printed = false
        if rk_dir == 1
            if rk_close >= rk_top + rk_box
                rk_bot := rk_top
                rk_top := rk_top + rk_box
                rk_run := rk_run + 1
                _printed := true
            else if rk_close <= rk_top - renko_rev * rk_box
                rk_top := rk_top - (renko_rev - 1) * rk_box
                rk_bot := rk_top - rk_box
                rk_dir := -1
                rk_run := 1
                _printed := true
        else if rk_dir == -1
            if rk_close <= rk_bot - rk_box
                rk_top := rk_bot
                rk_bot := rk_bot - rk_box
                rk_run := rk_run + 1
                _printed := true
            else if rk_close >= rk_bot + renko_rev * rk_box
                rk_bot := rk_bot + (renko_rev - 1) * rk_box
                rk_top := rk_bot + rk_box
                rk_dir := 1
                rk_run := 1
                _printed := true
        else
            if rk_close >= rk_top + rk_box
                rk_bot := rk_top
                rk_top := rk_top + rk_box
                rk_dir := 1
                rk_run := 1
                _printed := true
            else if rk_close <= rk_bot - rk_box
                rk_top := rk_bot
                rk_bot := rk_bot - rk_box
                rk_dir := -1
                rk_run := 1
                _printed := true
        if not _printed
            break

// The gate. During the first calendar month there is no box, no direction and
// therefore no entries at all — that month is warm-up. Set the backtest start
// at least one full month after the data starts or it is wasted.
rk_ok_long  = not renko_on or (rk_dir ==  1 and rk_run >= renko_confirm)
rk_ok_short = not renko_on or (rk_dir == -1 and rk_run >= renko_confirm)

// ============================================================================
// ③ ENTRY — PRICE ABOVE ALL
// ============================================================================
grp_entry = "③ ━━━ ENTRY: PRICE ABOVE ALL ━━━"
pa_layers = input.string("All three", "Price Must Clear", options=["All three","HTF1 + HTF2","Base + HTF1","Base + HTF2","HTF2 only","HTF1 only","Base only","Any two"], tooltip="Which SHA layers price has to close beyond. 'All three' is the strictest. The single-layer options are the HTF price-cross signals from the plan, folded in here.", group=grp_entry)
confirm_mode = input.string("Confirmed (1-bar)", "Confirmation Mode", options=["Confirmed (1-bar)","Immediate"], tooltip="Confirmed (1-bar): fires the bar AFTER price completes the condition. One bar of confirmation lag.\nImmediate: fires on the bar price completes it. Earlier, slightly noisier.", group=grp_entry)
allow_longs  = input.bool(true, "Allow Longs", group=grp_entry)
allow_shorts = input.bool(true, "Allow Shorts", group=grp_entry)
// ── RE-ENTRY AFTER AN EXIT ─────────────────────────────────────────────────
// The entry signal fires once, on the FIRST breakout into the condition, and
// never again while it stays true. So a trade stopped out mid-trend leaves the
// rest of the move untaken. This arms the setup again after an exit: price has
// to prove it is resuming by CLOSING beyond the exit candle itself.
use_reentry = input.bool(false, "Re-Enter After Exit", tooltip="After a trade closes, arm the setup again. It fires when a later candle CLOSES above the exit candle's HIGH (for longs) or below its LOW (for shorts). No fresh transition needed — price simply has to clear the bar you were knocked out on.", group=grp_entry)
reentry_needs_base = input.bool(true, "  Setup Must Still Hold", tooltip="Only re-enter while the entry condition is still true. Off means price clearing the exit candle is enough on its own, even if the layers have since fallen out of agreement.", group=grp_entry)
reentry_expires = input.bool(true, "  Cancel If Setup Breaks", tooltip="If the condition fails before price clears the exit candle, drop the armed re-entry rather than waiting indefinitely. It re-arms only after another exit.", group=grp_entry)
gap_thresh   = input.float(0.0, "Skip Gap Entries Above (%)", minval=0.0, step=0.1, tooltip="0 = OFF, no gap is ever skipped. Any value above 0 is the gap size that invalidates an entry: if the day opened more than this away from the prior day's close, an entry firing on that open is skipped, because the alignment was likely manufactured by the gap rather than earned. The day itself is not blocked - a later, non-gap re-alignment enters normally.", group=grp_entry)

// ============================================================================
// ④ INITIAL STOP  (invalidation level + sizing anchor)
// ============================================================================
grp_sl = "④ ━━━ INITIAL STOP ━━━"
sl_mode = input.string("Swing (Prev N Bars)", "Stop Anchor", options=["Trigger Candle","Swing (Prev N Bars)","Base SHA Body","HTF1 SHA Body","HTF2 SHA Body","Last Bar Beyond Nearest SHA","Last Bar Beyond Furthest SHA","Last SHA Bar Beyond Nearest SHA","Last SHA Bar Beyond Furthest SHA","Closest Eligible SHA","Middle Eligible SHA","Furthest Eligible SHA"], tooltip="Closest / Middle / Furthest Eligible SHA: rank the SHA layers that price has CLOSED beyond during this trade, by distance from price, and anchor on the chosen rung. Recomputed every bar. With two eligible layers Middle resolves to Furthest; with one, all three rungs resolve to it; with none, the anchor falls back to Swing.\n\nLast Bar Beyond ... : the most recent bar that sat entirely past the SHA's far edge (below it for a long, above it for a short) — the last place price was genuinely on the wrong side of the trend. 'SHA Bar' tests the smoothed candle instead of the raw one. Nearest/furthest is decided at entry by which higher SHA layer is closer to price. No lookback limit.\n\nTrigger Candle: the signal bar itself.\nSwing (Prev N Bars): lowest/highest over the lookback — structural, recommended for trend entries.\nHTF1 SHA Body: opposite edge of the mid-TF body — invalidation = mid-TF trend threatened.\nHTF2 SHA Body: opposite edge of the high-TF body — widest, high-TF invalidation.", group=grp_sl)
sl_price_basis = input.string("Body (open/close)", "Anchor Uses", options=["Body (open/close)","Wick (high/low)"], tooltip="Applies to Trigger Candle and Swing anchors.\nBody: the candle body edge (open/close) — tighter, ignores the shadow.\nWick: the full extreme (high/low) including the shadow — wider, harder to knock out.\n(HTF SHA-Body anchors always use the SHA body.)", group=grp_sl)
sl_lookback = input.int(10, "Swing Lookback (bars)", minval=1, maxval=100, group=grp_sl)
sl_buffer_pct = input.float(0.10, "Stop Buffer (%)", minval=0.0, step=0.01, tooltip="How far beyond the anchor the stop sits, as a percentage of price. 0.10 means one tenth of one percent. Percent rather than a fixed amount so the same setting is meaningful on any instrument.", group=grp_sl)
sl_buffer_raw = close * sl_buffer_pct / 100
min_stop_pct = input.float(0.00, "Min Stop Distance (%)", minval=0.0, step=0.01, tooltip="Floor on stop distance, as a percentage of price. The stop is never placed closer to entry than this. 0 = off.", group=grp_sl)
min_stop_raw = close * min_stop_pct / 100
use_hard_stop = input.bool(false, "Hard Stop (intra-bar + gap protection)", tooltip="OFF (default): the stop is CLOSE-based (mental) — it fires only when a candle CLOSES beyond the stop. ON: the stop is a REAL order that fires the instant price TOUCHES it intra-bar, and protects against overnight/weekend gaps (important for stocks like QQQ). Break-even and trailing still ratchet the stop; this only changes how it is enforced. The alignment-break exit stays close-based either way.", group=grp_sl)

// ── ENTRY CONDITION: WHERE PRICE SITS, NOT WHICH WAY EACH LAYER POINTS ─────
// Which edge counts follows the Anchor Uses setting, so Body ignores wicks on
// both sides — the same convention the stop anchors use. This block sits below
// the stop inputs because it reads sl_price_basis, and Pine requires an input
// to be declared before it is used.
_pa_body = sl_price_basis == "Body (open/close)"
pa_b_top = _pa_body ? math.max(bO, bC)  : bH
pa_b_bot = _pa_body ? math.min(bO, bC)  : bL
pa_1_top = _pa_body ? math.max(h1O,h1C) : h1H
pa_1_bot = _pa_body ? math.min(h1O,h1C) : h1L
pa_2_top = _pa_body ? math.max(h2O,h2C) : h2H
pa_2_bot = _pa_body ? math.min(h2O,h2C) : h2L

_ab = close > pa_b_top
_a1 = close > pa_1_top
_a2 = close > pa_2_top
_bb = close < pa_b_bot
_b1 = close < pa_1_bot
_b2 = close < pa_2_bot
_n_above = (_ab ? 1 : 0) + (_a1 ? 1 : 0) + (_a2 ? 1 : 0)
_n_below = (_bb ? 1 : 0) + (_b1 ? 1 : 0) + (_b2 ? 1 : 0)

all_bull = all_ready and (pa_layers == "All three"          ? (_ab and _a1 and _a2)
   : pa_layers == "HTF1 + HTF2"        ? (_a1 and _a2)
   : pa_layers == "Base + HTF1"        ? (_ab and _a1)
   : pa_layers == "Base + HTF2"        ? (_ab and _a2)
   : pa_layers == "HTF2 only"          ? _a2
   : pa_layers == "HTF1 only"          ? _a1
   : pa_layers == "Base only"          ? _ab
   :                                     _n_above >= 2)
all_bear = all_ready and (pa_layers == "All three"          ? (_bb and _b1 and _b2)
   : pa_layers == "HTF1 + HTF2"        ? (_b1 and _b2)
   : pa_layers == "Base + HTF1"        ? (_bb and _b1)
   : pa_layers == "Base + HTF2"        ? (_bb and _b2)
   : pa_layers == "HTF2 only"          ? _b2
   : pa_layers == "HTF1 only"          ? _b1
   : pa_layers == "Base only"          ? _bb
   :                                     _n_below >= 2)

// Entry fires on the transition INTO the condition, not while it persists.
pa_bull_raw = confirm_mode == "Confirmed (1-bar)" ? (all_bull[1] and not all_bull[2]) : (all_bull and not all_bull[1])
pa_bear_raw = confirm_mode == "Confirmed (1-bar)" ? (all_bear[1] and not all_bear[2]) : (all_bear and not all_bear[1])

// Body extremes for the current bar
body_low  = math.min(open, close)
body_high = math.max(open, close)

// ta.lowest / ta.highest keep internal state and MUST run every bar, so all
// four swing variants are computed here at global scope, then selected.
swing_low_wick  = ta.lowest(low,  sl_lookback)
swing_high_wick = ta.highest(high, sl_lookback)
swing_low_body  = ta.lowest(body_low,  sl_lookback)
swing_high_body = ta.highest(body_high, sl_lookback)

sl_use_body = sl_price_basis == "Body (open/close)"
trig_low_lvl  = sl_use_body ? body_low  : low
trig_high_lvl = sl_use_body ? body_high : high
sw_low_lvl    = sl_use_body ? swing_low_body  : swing_low_wick
sw_high_lvl   = sl_use_body ? swing_high_body : swing_high_wick

// ── LAST-BAR-BEYOND ANCHORS ────────────────────────────────────────────────
// NOT a crossing event — that is the entry signal. This is a POSITION: the most
// recent bar that sat BEYOND the SHA. For a long, any part of the bar below the
// SHA's lower edge; for a short, any part above its upper edge. A bar that only
// pokes into the SHA body does NOT count — it must clear the far edge, i.e. be
// genuinely on the wrong side of the trend.
// Tracked forward one bar at a time (O(1)) rather than searched backwards, so
// there is NO lookback limit — the anchor can be any distance away.
// Basis follows the Anchor Uses setting: Body compares body edges only and
// ignores wicks on both the candle and the SHA; Wick compares full extremes.
// "Nearest / furthest" is decided at ENTRY time, by which of the two higher
// SHA layers is closer to price right then.
px_low_test  = sl_use_body ? body_low  : low
px_high_test = sl_use_body ? body_high : high
ha_low_test  = sl_use_body ? math.min(bO, bC) : bL
ha_high_test = sl_use_body ? math.max(bO, bC) : bH
h1_bot_edge  = sl_use_body ? sha_bot_1 : h1L
h1_top_edge  = sl_use_body ? sha_top_1 : h1H
h2_bot_edge  = sl_use_body ? sha_bot_2 : h2L
h2_top_edge  = sl_use_body ? sha_top_2 : h2H

var float xl_px_h1 = na, var float xl_px_h2 = na
var float xl_ha_h1 = na, var float xl_ha_h2 = na
var float xh_px_h1 = na, var float xh_px_h2 = na
var float xh_ha_h1 = na, var float xh_ha_h2 = na
if not na(h1_bot_edge) and px_low_test  < h1_bot_edge
    xl_px_h1 := px_low_test
if not na(h2_bot_edge) and px_low_test  < h2_bot_edge
    xl_px_h2 := px_low_test
if not na(h1_bot_edge) and ha_low_test  < h1_bot_edge
    xl_ha_h1 := ha_low_test
if not na(h2_bot_edge) and ha_low_test  < h2_bot_edge
    xl_ha_h2 := ha_low_test
if not na(h1_top_edge) and px_high_test > h1_top_edge
    xh_px_h1 := px_high_test
if not na(h2_top_edge) and px_high_test > h2_top_edge
    xh_px_h2 := px_high_test
if not na(h1_top_edge) and ha_high_test > h1_top_edge
    xh_ha_h1 := ha_high_test
if not na(h2_top_edge) and ha_high_test > h2_top_edge
    xh_ha_h2 := ha_high_test

// Which higher layer is nearer to price right now
d_h1_bot = na(h1_bot_edge) ? 1e18 : math.abs(close - h1_bot_edge)
d_h2_bot = na(h2_bot_edge) ? 1e18 : math.abs(close - h2_bot_edge)
d_h1_top = na(h1_top_edge) ? 1e18 : math.abs(close - h1_top_edge)
d_h2_top = na(h2_top_edge) ? 1e18 : math.abs(close - h2_top_edge)
near_is_h1_long  = d_h1_bot <= d_h2_bot
near_is_h1_short = d_h1_top <= d_h2_top

// ============================================================================
// TRADE STATE  (declared here because eligibility, ranking and the trail all
// read pos_dir before the management block runs)
// ============================================================================
var string pos_dir     = "flat"
var float  entry_price = na
var float  init_stop   = na
var float  stop_level  = na
var float  risk_unit   = na    // |entry - init_stop|, the R denominator
var int    entry_bar   = na
var bool   be_moved    = false
var bool   tp1_taken   = false
var int    bad_bars    = 0     // consecutive bars the flip condition has held
var float  peak_r      = 0.0   // best R reached, for the give-back exit
var float  rearm_high  = na    // exit candle's high — long re-entry trigger
var float  rearm_low   = na    // exit candle's low  — short re-entry trigger

// ── ELIGIBILITY AND ARMING ─────────────────────────────────────────────────
// elig_*  : price has CLOSED beyond this layer at some point during the trade.
//           Only an eligible layer may end the trade.
// arm_*   : this layer has pointed WITH the trade at some point during it.
//           Only an armed layer can be said to have flipped against it.
var bool elig_b = false
var bool elig_1 = false
var bool elig_2 = false
var bool arm_b  = false
var bool arm_1  = false
var bool arm_2  = false

// Instantaneous test — also what seeds the flags on the entry bar.
inst_el_b_long  = close > pa_b_top
inst_el_1_long  = close > pa_1_top
inst_el_2_long  = close > pa_2_top
inst_el_b_short = close < pa_b_bot
inst_el_1_short = close < pa_1_bot
inst_el_2_short = close < pa_2_bot

// Running update, before anything downstream reads the flags. Once set, a flag
// holds for the rest of the trade; both sets are cleared on entry and on exit.
if pos_dir == "long"
    elig_b := elig_b or inst_el_b_long
    elig_1 := elig_1 or inst_el_1_long
    elig_2 := elig_2 or inst_el_2_long
    arm_b  := arm_b  or base_bull_bar
    arm_1  := arm_1  or htf1_bull_bar
    arm_2  := arm_2  or htf2_bull_bar
else if pos_dir == "short"
    elig_b := elig_b or inst_el_b_short
    elig_1 := elig_1 or inst_el_1_short
    elig_2 := elig_2 or inst_el_2_short
    arm_b  := arm_b  or not base_bull_bar
    arm_1  := arm_1  or not htf1_bull_bar
    arm_2  := arm_2  or not htf2_bull_bar

// ── DISTANCE RANKING OF THE ELIGIBLE LAYERS ────────────────────────────────
// Returns [closest, middle, furthest] by absolute distance from the close.
// Collapse: two eligible → middle resolves to furthest; one → all three resolve
// to it; none → all na, and the caller falls back to Swing.
// Everything is passed in; the function reads no outer-scope series.
f_rank(_e0, _l0, _e1, _l1, _e2, _l2) =>
    _lv = array.new_float()
    _ds = array.new_float()
    if _e0 and not na(_l0)
        array.push(_lv, _l0)
        array.push(_ds, math.abs(close - _l0))
    if _e1 and not na(_l1)
        array.push(_lv, _l1)
        array.push(_ds, math.abs(close - _l1))
    if _e2 and not na(_l2)
        array.push(_lv, _l2)
        array.push(_ds, math.abs(close - _l2))
    _n = array.size(_lv)
    float _near = na
    float _mid  = na
    float _far  = na
    if _n > 0
        _ix = array.sort_indices(_ds, order.ascending)
        _near := array.get(_lv, array.get(_ix, 0))
        _far  := array.get(_lv, array.get(_ix, _n - 1))
        _mid  := _n >= 3 ? array.get(_lv, array.get(_ix, 1)) : _far
    [_near, _mid, _far]

// Entry-bar ranking, from the instantaneous test — used by the initial stop.
[ik_near_L, ik_mid_L, ik_far_L] = f_rank(inst_el_b_long,  sha_bot_0, inst_el_1_long,  sha_bot_1, inst_el_2_long,  sha_bot_2)
[ik_near_S, ik_mid_S, ik_far_S] = f_rank(inst_el_b_short, sha_top_0, inst_el_1_short, sha_top_1, inst_el_2_short, sha_top_2)
// In-trade ranking, from the running flags — used by the trail.
[rk_near_L, rk_mid_L, rk_far_L] = f_rank(elig_b, sha_bot_0, elig_1, sha_bot_1, elig_2, sha_bot_2)
[rk_near_S, rk_mid_S, rk_far_S] = f_rank(elig_b, sha_top_0, elig_1, sha_top_1, elig_2, sha_top_2)

f_long_stop(_kn, _km, _kf) =>
    _near = near_is_h1_long
    _lcp  = _near ? xl_px_h1 : xl_px_h2
    _lcpF = _near ? xl_px_h2 : xl_px_h1
    _lch  = _near ? xl_ha_h1 : xl_ha_h2
    _lchF = _near ? xl_ha_h2 : xl_ha_h1
    _lvl = sl_mode == "Trigger Candle"                  ? trig_low_lvl
      :    sl_mode == "Swing (Prev N Bars)"             ? sw_low_lvl
      :    sl_mode == "Base SHA Body"                   ? sha_bot_0
      :    sl_mode == "HTF1 SHA Body"                   ? sha_bot_1
      :    sl_mode == "HTF2 SHA Body"                   ? sha_bot_2
      :    sl_mode == "Last Bar Beyond Nearest SHA"  ? (na(_lcp)  ? sw_low_lvl : _lcp)
      :    sl_mode == "Last Bar Beyond Furthest SHA" ? (na(_lcpF) ? sw_low_lvl : _lcpF)
      :    sl_mode == "Last SHA Bar Beyond Nearest SHA"    ? (na(_lch)  ? sw_low_lvl : _lch)
      :    sl_mode == "Last SHA Bar Beyond Furthest SHA"   ? (na(_lchF) ? sw_low_lvl : _lchF)
      :    sl_mode == "Closest Eligible SHA"          ? (na(_kn) ? sw_low_lvl : _kn)
      :    sl_mode == "Middle Eligible SHA"           ? (na(_km) ? sw_low_lvl : _km)
      :    sl_mode == "Furthest Eligible SHA"         ? (na(_kf) ? sw_low_lvl : _kf)
      :                                                   sw_low_lvl
    _s = _lvl - sl_buffer_raw
    min_stop_raw > 0 ? math.min(_s, close - min_stop_raw) : _s

f_short_stop(_kn, _km, _kf) =>
    _near = near_is_h1_short
    _hcp  = _near ? xh_px_h1 : xh_px_h2
    _hcpF = _near ? xh_px_h2 : xh_px_h1
    _hch  = _near ? xh_ha_h1 : xh_ha_h2
    _hchF = _near ? xh_ha_h2 : xh_ha_h1
    _lvl = sl_mode == "Trigger Candle"                  ? trig_high_lvl
      :    sl_mode == "Swing (Prev N Bars)"             ? sw_high_lvl
      :    sl_mode == "Base SHA Body"                   ? sha_top_0
      :    sl_mode == "HTF1 SHA Body"                   ? sha_top_1
      :    sl_mode == "HTF2 SHA Body"                   ? sha_top_2
      :    sl_mode == "Last Bar Beyond Nearest SHA"  ? (na(_hcp)  ? sw_high_lvl : _hcp)
      :    sl_mode == "Last Bar Beyond Furthest SHA" ? (na(_hcpF) ? sw_high_lvl : _hcpF)
      :    sl_mode == "Last SHA Bar Beyond Nearest SHA"    ? (na(_hch)  ? sw_high_lvl : _hch)
      :    sl_mode == "Last SHA Bar Beyond Furthest SHA"   ? (na(_hchF) ? sw_high_lvl : _hchF)
      :    sl_mode == "Closest Eligible SHA"          ? (na(_kn) ? sw_high_lvl : _kn)
      :    sl_mode == "Middle Eligible SHA"           ? (na(_km) ? sw_high_lvl : _km)
      :    sl_mode == "Furthest Eligible SHA"         ? (na(_kf) ? sw_high_lvl : _kf)
      :                                                   sw_high_lvl
    _s = _lvl + sl_buffer_raw
    min_stop_raw > 0 ? math.max(_s, close + min_stop_raw) : _s

// ============================================================================
// ⑤ POSITION SIZING  (risk-based; same math as v6, dedicated risk % here)
// ============================================================================
grp_size = "⑤ ━━━ POSITION SIZING ━━━"
risk_pct = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=10.0, step=0.1, tooltip="% of equity risked from entry to initial stop. Price Above All clears a structural level rather than waiting for three layers to agree, so this defaults to the middle of the normal band. Risk$ ÷ stop distance = size.", group=grp_size)
max_equity_pct = input.float(100.0, "Max Equity Per Trade (%)", minval=1.0, maxval=100.0, step=1.0, tooltip="Hard cap on capital deployed, even if the risk calc allows more.", group=grp_size)

f_qty(_entry, _stop) =>
    _eq   = strategy.equity
    _riskD = _eq * risk_pct / 100.0
    _dist  = math.abs(_entry - _stop)
    _qtyR  = _dist > 0 ? _riskD / _dist : 0.0
    _qtyMax = (_eq * max_equity_pct / 100.0) / _entry
    math.max(0.0, math.min(_qtyR, _qtyMax))

// ============================================================================
// ⑥ TRADE MANAGEMENT  (the Full-Alignment-specific engine)
//   Layered, all close-based, evaluated newest-first each bar:
//     1. Partial take-profit at a set R (optional)
//     2. Break-even move after +Xr (optional)
//     3. Structural trailing stop once in profit (optional)
//     4. Alignment-break exit — the signature rule (optional)
//     5. Hard stop breach (always on)
// ============================================================================
grp_mgmt = "⑥ ━━━ TRADE MANAGEMENT ━━━"

use_tp1   = input.bool(false, "Partial Take-Profit", tooltip="Scale out a portion at a fixed R multiple, ride the rest on the trail/alignment. Off by default to let winners run.", group=grp_mgmt)
tp1_r     = input.float(2.0, "  TP1 at (R multiple)", minval=0.5, step=0.5, group=grp_mgmt)
tp1_pct   = input.float(50, "  TP1 Size (% of position)", minval=1, maxval=99, step=5, group=grp_mgmt)

use_be    = input.bool(true, "Move Stop To Break-Even", tooltip="After price closes +Xr in favor, move the stop to entry (plus offset). Locks the trade to break-even once the trend proves itself.", group=grp_mgmt)
be_trig_r = input.float(1.0, "  Break-Even Trigger (R)", minval=0.1, step=0.1, group=grp_mgmt)
be_offset_pct = input.float(0.00, "  Break-Even Offset (%)", minval=0.0, step=0.01, tooltip="How far beyond entry the break-even stop sits, as a percentage of price. 0 = exactly at entry.", group=grp_mgmt)
be_offset_raw = close * be_offset_pct / 100
use_trail = input.bool(true, "Trailing Stop", tooltip="Once in profit, ratchet the stop toward the chosen anchor. Never loosens. Close-based — only triggers when a candle CLOSES beyond it.", group=grp_mgmt)
trail_mode = input.string("Swing (Prev N Bars)", "  Trail Anchor", options=["Swing (Prev N Bars)","Base SHA Body","HTF1 SHA Body","HTF2 SHA Body","Closest Eligible SHA","Middle Eligible SHA","Furthest Eligible SHA"], tooltip="Same anchor choices as the initial stop, except Trigger Candle (a fixed entry bar can't trail).\nSwing: recent swing low/high.\nHTF1 SHA Body: trail the mid-TF trend body.\nHTF2 SHA Body: trail the high-TF trend body (loosest, rides longest).", group=grp_mgmt)
trail_price_basis = input.string("Body (open/close)", "  Trail Uses", options=["Body (open/close)","Wick (high/low)"], tooltip="For the Swing trail anchor: Body = body edge (tighter), Wick = full extreme (wider).", group=grp_mgmt)
trail_start_r = input.float(1.0, "  Trail Activates At (R)", minval=0.1, step=0.1, group=grp_mgmt)
trail_lookback = input.int(6, "  Trail Lookback (bars)", minval=1, maxval=100, group=grp_mgmt)
trail_buffer_pct = input.float(0.10, "  Trail Buffer (%)", minval=0.0, step=0.01, tooltip="How far beyond the trail anchor the trailing stop sits, as a percentage of price.", group=grp_mgmt)
trail_buffer_raw = close * trail_buffer_pct / 100
reverse_on_stop = input.bool(false, "Reverse On Stop", tooltip="When the stop is hit, immediately open the opposite side IF that side is fully aligned at that moment (and its direction is allowed, and the gap filter passes). Built to cut the sideways bleed of exiting and re-entering the same way. Note: it does NOT wait for a fresh alignment signal — the opposite alignment simply has to be present.\n\nFor hold-until-stopped behaviour, switch Alignment-Break Exit OFF: the stop then becomes the only way out, with break-even and the trail still tightening it.", group=grp_mgmt)
// ── EXIT SCENARIOS ─────────────────────────────────────────────────────────
// Seven ways a trade can end, each independent and each off unless enabled.
// Whichever triggers first closes the trade. All are close-based unless the
// hard stop is on.
align_confirm_bars = input.int(1, "  Flip Must Hold (bars)", minval=1, maxval=20, tooltip="1 = exit the moment the layer flips (original behaviour). 2 or 3 requires the misalignment to persist, which is the same idea as the Confirmed entry mode applied to the way out. Directly targets exit churn on fast charts.", group=grp_mgmt)

use_sha_break = input.bool(false, "Exit: Price Back Through SHA", tooltip="Close when price closes back through the chosen SHA body — for a long, below its lower edge. Different from that layer FLIPPING: the trend line can still point up while price collapses back through it, so this is an earlier warning.", group=grp_mgmt)
sha_break_layer = input.string("HTF1", "  Which Layer", options=["Base","HTF1","HTF2"], group=grp_mgmt)

use_target = input.bool(false, "Exit: Profit Target", tooltip="Close the WHOLE position at a multiple of the initial risk. Caps winners — usually costly for a trend system, but may suit markets that grind rather than run.", group=grp_mgmt)
target_r = input.float(3.0, "  Target (R)", minval=0.5, step=0.5, group=grp_mgmt)

use_giveback = input.bool(false, "Exit: Give-Back", tooltip="Close if the trade hands back this share of its best profit. A percentage alternative to the structural trail, and it behaves very differently in chop.", group=grp_mgmt)
giveback_pct = input.float(40.0, "  Give-Back (% of peak profit)", minval=5, maxval=95, step=5, group=grp_mgmt)
giveback_min_r = input.float(1.0, "  Only After (R)", minval=0.1, step=0.1, tooltip="Give-back is ignored until the trade has reached at least this much profit.", group=grp_mgmt)

use_time_stop = input.bool(false, "Exit: Time Stop", tooltip="Close a trade that has gone nowhere after N bars. Cuts positions that only bleed spread.", group=grp_mgmt)
time_stop_bars = input.int(30, "  After (bars)", minval=1, group=grp_mgmt)
time_stop_min_r = input.float(0.5, "  Unless Ahead By (R)", minval=0.0, step=0.1, group=grp_mgmt)

use_cross_exit = input.bool(false, "Exit: Chart SHA Crosses Mid SHA", tooltip="Close when the chart-timeframe SHA crosses the mid-timeframe SHA against the trade — the two lines crossing rather than either one flipping.", group=grp_mgmt)

use_align_exit = input.bool(false, "Exit: Layer Flips Direction", tooltip="Exit when a SHA layer turns against the trade. OFF by default: this strategy enters on where PRICE sits, so a layer can be pointing the wrong way at entry and this exit would fire immediately. Two gates prevent that — a layer must be ELIGIBLE (price closed beyond it during the trade) and ARMED (it pointed with the trade at some point). A layer that never came onside can never exit the trade, and a flip INTO the trade\x27s direction only arms a layer. Close-based.", group=grp_mgmt)
align_break_level = input.string("HTF1 Flips", "  Flip Trigger", options=["Base Flips","HTF1 Flips","HTF2 Flips","Any Layer Flips","All Layers Flip"], tooltip="Base Flips: tightest — exit the moment the chart-TF SHA turns against you.\nHTF1 Flips: exit when the MID-TF anchor turns (recommended balance).\nHTF2 Flips: loosest — only exit when the HIGH-TF turns.\nAny Layer Flips: exit if any single layer disagrees.\nAll Layers Flip: exit only on full opposite alignment.", group=grp_mgmt)

// Trail references — all ta.* computed every bar at global scope, then selected.
trail_sw_low_wick  = ta.lowest(low,  trail_lookback)
trail_sw_low_body  = ta.lowest(body_low,  trail_lookback)
trail_sw_high_wick = ta.highest(high, trail_lookback)
trail_sw_high_body = ta.highest(body_high, trail_lookback)
trail_use_body = trail_price_basis == "Body (open/close)"
trail_sw_low  = trail_use_body ? trail_sw_low_body  : trail_sw_low_wick
trail_sw_high = trail_use_body ? trail_sw_high_body : trail_sw_high_wick

trail_low_anchor  = trail_mode == "Swing (Prev N Bars)" ? trail_sw_low  : trail_mode == "Base SHA Body" ? sha_bot_0 : trail_mode == "HTF1 SHA Body" ? sha_bot_1 : trail_mode == "HTF2 SHA Body" ? sha_bot_2 : trail_mode == "Closest Eligible SHA" ? rk_near_L : trail_mode == "Middle Eligible SHA" ? rk_mid_L : rk_far_L
trail_high_anchor = trail_mode == "Swing (Prev N Bars)" ? trail_sw_high : trail_mode == "Base SHA Body" ? sha_top_0 : trail_mode == "HTF1 SHA Body" ? sha_top_1 : trail_mode == "HTF2 SHA Body" ? sha_top_2 : trail_mode == "Closest Eligible SHA" ? rk_near_S : trail_mode == "Middle Eligible SHA" ? rk_mid_S : rk_far_S
trail_low_ref  = trail_low_anchor  - trail_buffer_raw
trail_high_ref = trail_high_anchor + trail_buffer_raw

// ============================================================================
// ⑦ DATE FILTER
// ============================================================================
grp_date = "⑦ ━━━ DATE FILTER ━━━"
use_date = input.bool(false, "Enable Date Range", group=grp_date)
date_start = input.time(timestamp("2025-01-01 00:00"), "Start", group=grp_date)
date_end   = input.time(timestamp("2026-12-31 23:59"), "End", group=grp_date)
in_date = not use_date or (time >= date_start and time <= date_end)

// ============================================================================
// ⑧ DISPLAY
// ============================================================================
grp_disp = "⑧ ━━━ DISPLAY ━━━"
show_markers = input.bool(true, "Entry / Exit Markers", group=grp_disp)
show_stop_line = input.bool(true, "Active Stop Line", group=grp_disp)
show_hud = input.bool(true, "State HUD", group=grp_disp)
hud_pos = input.string("Top Right", "HUD Position", options=["Top Left","Top Right","Bottom Left","Bottom Right"], group=grp_disp)

// Drop an armed re-entry once the setup itself has gone
if reentry_expires and not na(rearm_high) and not all_bull
    rearm_high := na
if reentry_expires and not na(rearm_low) and not all_bear
    rearm_low := na

// Re-entry: price CLOSES beyond the exit candle, setup optionally still required
re_long  = use_reentry and not na(rearm_high) and close > rearm_high and (not reentry_needs_base or all_bull)
re_short = use_reentry and not na(rearm_low)  and close < rearm_low  and (not reentry_needs_base or all_bear)

// Gate: only a fresh breakout enters, only when flat, within the date range.
// Gap skip: block only the entry that fires on a gapped daily open (not the whole day).
is_new_day = ta.change(time("1D")) != 0
gap_block  = gap_thresh > 0 and is_new_day and gap_pct > gap_thresh
long_signal  = allow_longs  and (pa_bull_raw or re_long)  and in_date and not gap_block and rk_ok_long
short_signal = allow_shorts and (pa_bear_raw or re_short) and in_date and not gap_block and rk_ok_short

// Per-bar event flags (for markers)
did_exit  = false
did_enter = false
stopped_from = ""   // "long"/"short" when a STOP (not another exit) closed a trade this bar
exit_reason = ""

// ── ALIGNMENT-BREAK condition (direction-aware) ──────────────────────────
// Chart SHA crossing the mid SHA (computed globally — ta.* must run every bar)
cross_dn = ta.crossunder(bC, h1C)
cross_up = ta.crossover(bC, h1C)

// Which SHA body edge the "price back through" exit watches
shab_bot = sha_break_layer == "Base" ? math.min(bO, bC) : sha_break_layer == "HTF1" ? sha_bot_1 : sha_bot_2
shab_top = sha_break_layer == "Base" ? math.max(bO, bC) : sha_break_layer == "HTF1" ? sha_top_1 : sha_top_2


// ── LAYER-FLIP CONDITION (eligible AND armed AND now against the trade) ────
// A layer that price never cleared cannot exit the trade. Neither can a layer
// that never pointed with it — that layer never flipped, it was always offside.
flip_b_long = elig_b and arm_b and not base_bull_bar
flip_1_long = elig_1 and arm_1 and not htf1_bull_bar
flip_2_long = elig_2 and arm_2 and not htf2_bull_bar
flip_b_short = elig_b and arm_b and base_bull_bar
flip_1_short = elig_1 and arm_1 and htf1_bull_bar
flip_2_short = elig_2 and arm_2 and htf2_bull_bar
n_elig      = (elig_b ? 1 : 0) + (elig_1 ? 1 : 0) + (elig_2 ? 1 : 0)
n_flip_long = (flip_b_long ? 1 : 0) + (flip_1_long ? 1 : 0) + (flip_2_long ? 1 : 0)
n_flip_shrt = (flip_b_short ? 1 : 0) + (flip_1_short ? 1 : 0) + (flip_2_short ? 1 : 0)

align_broken_long = align_break_level == "Base Flips"      ? flip_b_long
   : align_break_level == "HTF1 Flips"      ? flip_1_long
   : align_break_level == "HTF2 Flips"      ? flip_2_long
   : align_break_level == "Any Layer Flips" ? (n_flip_long > 0)
   :                                          (n_elig > 0 and n_flip_long == n_elig)
align_broken_short = align_break_level == "Base Flips"      ? flip_b_short
   : align_break_level == "HTF1 Flips"      ? flip_1_short
   : align_break_level == "HTF2 Flips"      ? flip_2_short
   : align_break_level == "Any Layer Flips" ? (n_flip_shrt > 0)
   :                                          (n_elig > 0 and n_flip_shrt == n_elig)

// ───────────────────────────── MANAGE OPEN POSITION ────────────────────────
// Runs before entries so a same-bar reversal (exit then opposite entry) works.

// Reconcile: if a HARD stop order filled, the engine closed the position but our
// manual state is still "in a trade" — detect (flat book, non-flat state) and reset.
if pos_dir != "flat" and strategy.position_size == 0 and not na(entry_bar) and bar_index > entry_bar
    did_exit := true
    exit_reason := "STOP"
    pos_dir := "flat"
    entry_price := na
    init_stop := na
    stop_level := na
    risk_unit := na
    be_moved := false
    tp1_taken := false
    elig_b := false
    elig_1 := false
    elig_2 := false
    arm_b  := false
    arm_1  := false
    arm_2  := false

if pos_dir == "long" and not na(stop_level)
    _rr = risk_unit > 0 ? (close - entry_price) / risk_unit : 0.0

    // 1. Partial take-profit
    if use_tp1 and not tp1_taken and _rr >= tp1_r
        strategy.close("PAA", qty_percent=tp1_pct, comment="TP1")
        tp1_taken := true
        if not be_moved
            stop_level := math.max(stop_level, entry_price + be_offset_raw)
            be_moved := true

    // 2. Break-even
    if use_be and not be_moved and _rr >= be_trig_r
        stop_level := math.max(stop_level, entry_price + be_offset_raw)
        be_moved := true

    // 3. Structural trail (ratchet only)
    if use_trail and _rr >= trail_start_r
        if trail_low_ref > stop_level
            stop_level := trail_low_ref

    // 4 & 5. Exits — align-break is always close-based; the stop is hard or mental
    peak_r := math.max(peak_r, _rr)
    bad_bars := align_broken_long ? bad_bars + 1 : 0
    _align_out = use_align_exit and bad_bars >= align_confirm_bars
    _sha_out   = use_sha_break and close < shab_bot
    _tgt_out   = use_target and _rr >= target_r
    _give_out  = use_giveback and peak_r >= giveback_min_r and _rr <= peak_r * (1.0 - giveback_pct / 100.0)
    _time_out  = use_time_stop and not na(entry_bar) and (bar_index - entry_bar) >= time_stop_bars and _rr < time_stop_min_r
    _cross_out = use_cross_exit and cross_dn
    _other_out = _align_out or _sha_out or _tgt_out or _give_out or _time_out or _cross_out
    _stop_hit  = (not use_hard_stop) and (close <= stop_level)
    if use_hard_stop and not _other_out
        strategy.exit("PAA-stop", from_entry="PAA", stop=stop_level)   // real intra-bar, gap-safe
    if _stop_hit or _other_out
        _why = _stop_hit ? "Stop" : _align_out ? "Layer Flip" : _sha_out ? "SHA Break" : _tgt_out ? "Target" : _give_out ? "Give-Back" : _time_out ? "Time" : "SHA Cross"
        strategy.close_all(comment = _why)
        did_exit := true
        exit_reason := _stop_hit ? "STOP" : "EXIT"
        if _stop_hit
            stopped_from := "long"
        rearm_high := high
        rearm_low := na
        bad_bars := 0
        peak_r := 0.0
        pos_dir := "flat"
        entry_price := na
        init_stop := na
        stop_level := na
        risk_unit := na
        be_moved := false
        tp1_taken := false
        elig_b := false
        elig_1 := false
        elig_2 := false
        arm_b  := false
        arm_1  := false
        arm_2  := false

else if pos_dir == "short" and not na(stop_level)
    _rr = risk_unit > 0 ? (entry_price - close) / risk_unit : 0.0

    if use_tp1 and not tp1_taken and _rr >= tp1_r
        strategy.close("PAA", qty_percent=tp1_pct, comment="TP1")
        tp1_taken := true
        if not be_moved
            stop_level := math.min(stop_level, entry_price - be_offset_raw)
            be_moved := true

    if use_be and not be_moved and _rr >= be_trig_r
        stop_level := math.min(stop_level, entry_price - be_offset_raw)
        be_moved := true

    if use_trail and _rr >= trail_start_r
        if trail_high_ref < stop_level
            stop_level := trail_high_ref

    peak_r := math.max(peak_r, _rr)
    bad_bars := align_broken_short ? bad_bars + 1 : 0
    _align_out = use_align_exit and bad_bars >= align_confirm_bars
    _sha_out   = use_sha_break and close > shab_top
    _tgt_out   = use_target and _rr >= target_r
    _give_out  = use_giveback and peak_r >= giveback_min_r and _rr <= peak_r * (1.0 - giveback_pct / 100.0)
    _time_out  = use_time_stop and not na(entry_bar) and (bar_index - entry_bar) >= time_stop_bars and _rr < time_stop_min_r
    _cross_out = use_cross_exit and cross_up
    _other_out = _align_out or _sha_out or _tgt_out or _give_out or _time_out or _cross_out
    _stop_hit  = (not use_hard_stop) and (close >= stop_level)
    if use_hard_stop and not _other_out
        strategy.exit("PAA-stop", from_entry="PAA", stop=stop_level)   // real intra-bar, gap-safe
    if _stop_hit or _other_out
        _why = _stop_hit ? "Stop" : _align_out ? "Layer Flip" : _sha_out ? "SHA Break" : _tgt_out ? "Target" : _give_out ? "Give-Back" : _time_out ? "Time" : "SHA Cross"
        strategy.close_all(comment = _why)
        did_exit := true
        exit_reason := _stop_hit ? "STOP" : "EXIT"
        if _stop_hit
            stopped_from := "short"
        rearm_low := low
        rearm_high := na
        bad_bars := 0
        peak_r := 0.0
        pos_dir := "flat"
        entry_price := na
        init_stop := na
        stop_level := na
        risk_unit := na
        be_moved := false
        tp1_taken := false
        elig_b := false
        elig_1 := false
        elig_2 := false
        arm_b  := false
        arm_1  := false
        arm_2  := false

// ── REVERSE ON STOP ────────────────────────────────────────────────────────
// Flip only if the opposite side is FULLY ALIGNED at this moment, its direction
// is permitted, and the gap filter passes. It does not require a fresh signal.
rev_long  = reverse_on_stop and stopped_from == "short" and all_bull and allow_longs  and in_date and not gap_block and rk_ok_long
rev_short = reverse_on_stop and stopped_from == "long"  and all_bear and allow_shorts and in_date and not gap_block and rk_ok_short

// ───────────────────────────────── ENTRIES ────────────────────────────────
// Only when flat (possibly just made flat above → same-bar flip).
if pos_dir == "flat" and (long_signal or rev_long)
    _stop = f_long_stop(ik_near_L, ik_mid_L, ik_far_L)
    if not na(_stop) and _stop < close
        entry_price := close
        init_stop   := _stop
        stop_level  := _stop
        risk_unit   := close - _stop
        entry_bar   := bar_index
        be_moved    := false
        bad_bars    := 0
        peak_r      := 0.0
        rearm_high  := na
        rearm_low   := na
        tp1_taken   := false
        elig_b      := inst_el_b_long
        elig_1      := inst_el_1_long
        elig_2      := inst_el_2_long
        arm_b       := base_bull_bar
        arm_1       := htf1_bull_bar
        arm_2       := htf2_bull_bar
        pos_dir     := "long"
        strategy.entry("PAA", strategy.long, qty=f_qty(close, _stop))
        did_enter := true

if pos_dir == "flat" and (short_signal or rev_short)
    _stop = f_short_stop(ik_near_S, ik_mid_S, ik_far_S)
    if not na(_stop) and _stop > close
        entry_price := close
        init_stop   := _stop
        stop_level  := _stop
        risk_unit   := _stop - close
        entry_bar   := bar_index
        be_moved    := false
        bad_bars    := 0
        peak_r      := 0.0
        rearm_high  := na
        rearm_low   := na
        tp1_taken   := false
        elig_b      := inst_el_b_short
        elig_1      := inst_el_1_short
        elig_2      := inst_el_2_short
        arm_b       := not base_bull_bar
        arm_1       := not htf1_bull_bar
        arm_2       := not htf2_bull_bar
        pos_dir     := "short"
        strategy.entry("PAA", strategy.short, qty=f_qty(close, _stop))
        did_enter := true

// ============================================================================
// VISUALS
// ============================================================================
// SHA CANDLES — all three layers, drawn back-to-front (HTF2 → HTF1 → Base) with
// graded opacity so higher timeframes sit behind. Faithful to v6's rendering.
// ============================================================================
htf2_body_col = h2C >= h2O ? color.new(htf2_bull, htf2_opacity) : color.new(htf2_bear, htf2_opacity)
htf2_wick_col = show_wicks   ? color.new(htf2_wick, htf2_opacity) : na
htf2_brdr_col = show_borders ? (h2C >= h2O ? color.new(htf2_border_bull, htf2_opacity) : color.new(htf2_border_bear, htf2_opacity)) : htf2_body_col
htf2_pH       = show_wicks ? h2H : math.max(h2O, h2C)
htf2_pL       = show_wicks ? h2L : math.min(h2O, h2C)
plotcandle(htf2_ready and htf2_show ? h2O : na, htf2_ready and htf2_show ? htf2_pH : na,
           htf2_ready and htf2_show ? htf2_pL : na, htf2_ready and htf2_show ? h2C : na,
           title="HTF2 SHA", color=htf2_ready and htf2_show ? htf2_body_col : na,
           wickcolor=htf2_ready and htf2_show ? htf2_wick_col : na,
           bordercolor=htf2_ready and htf2_show ? htf2_brdr_col : na)

htf1_body_col = h1C >= h1O ? color.new(htf1_bull, htf1_opacity) : color.new(htf1_bear, htf1_opacity)
htf1_wick_col = show_wicks   ? color.new(htf1_wick, htf1_opacity) : na
htf1_brdr_col = show_borders ? (h1C >= h1O ? color.new(htf1_border_bull, htf1_opacity) : color.new(htf1_border_bear, htf1_opacity)) : htf1_body_col
htf1_pH       = show_wicks ? h1H : math.max(h1O, h1C)
htf1_pL       = show_wicks ? h1L : math.min(h1O, h1C)
plotcandle(htf1_ready and htf1_show ? h1O : na, htf1_ready and htf1_show ? htf1_pH : na,
           htf1_ready and htf1_show ? htf1_pL : na, htf1_ready and htf1_show ? h1C : na,
           title="HTF1 SHA", color=htf1_ready and htf1_show ? htf1_body_col : na,
           wickcolor=htf1_ready and htf1_show ? htf1_wick_col : na,
           bordercolor=htf1_ready and htf1_show ? htf1_brdr_col : na)

base_body_col = bC >= bO ? color.new(base_bull, base_opacity) : color.new(base_bear, base_opacity)
base_wick_col = show_wicks   ? color.new(base_wick, base_opacity) : na
base_brdr_col = show_borders ? color.new(base_border, base_opacity) : base_body_col
base_pH       = show_wicks ? bH : math.max(bO, bC)
base_pL       = show_wicks ? bL : math.min(bO, bC)
plotcandle(base_ready and base_show ? bO : na, base_ready and base_show ? base_pH : na,
           base_ready and base_show ? base_pL : na, base_ready and base_show ? bC : na,
           title="Base SHA", color=base_ready and base_show ? base_body_col : na,
           wickcolor=base_ready and base_show ? base_wick_col : na,
           bordercolor=base_ready and base_show ? base_brdr_col : na)

// Entry markers — filled arrows (▲▼), carried over from v6
plotshape(show_markers and did_enter and pos_dir == "long"  ? low  : na, title="Entry Long",  style=shape.triangleup,   location=location.belowbar, color=color.new(#2962FF, 0), size=size.small, text="▲")
plotshape(show_markers and did_enter and pos_dir == "short" ? high : na, title="Entry Short", style=shape.triangledown, location=location.abovebar, color=color.new(#F23645, 0), size=size.small, text="▼")

// Exit markers — ✕ at the exit, colored by reason (stop vs alignment break)
plotshape(show_markers and did_exit ? close : na, title="Exit", style=shape.xcross, location=location.absolute,
     color = exit_reason == "STOP" ? color.new(#8B0000, 0) : color.new(#000000, 0), size=size.tiny)

// Active stop line
plot(show_stop_line and pos_dir != "flat" ? stop_level : na, title="Active Stop", color=color.new(#8B0000, 0), style=plot.style_linebr, linewidth=1)

// Data Window telemetry
plot(base_bull_bar ? 1 : -1, "Base Dir",  display=display.data_window)
plot(htf1_bull_bar ? 1 : -1, "HTF1 Dir",  display=display.data_window)
plot(htf2_bull_bar ? 1 : -1, "HTF2 Dir",  display=display.data_window)
plot(all_bull ? 1 : all_bear ? -1 : 0, "Price Position", display=display.data_window)
plot(pos_dir == "long" ? 1 : pos_dir == "short" ? -1 : 0, "Position", display=display.data_window)

// ============================================================================
// STATE HUD
// ============================================================================
var table hud = na
if show_hud and barstate.islast
    _hp = hud_pos == "Top Left" ? position.top_left : hud_pos == "Top Right" ? position.top_right : hud_pos == "Bottom Left" ? position.bottom_left : position.bottom_right
    hud := table.new(_hp, 2, 10, border_width=1, frame_color=color.new(#000000, 40), frame_width=1)
    _bg = color.new(#1A1A1A, 10)
    _hd = color.new(#2962FF, 0)
    table.cell(hud, 0, 0, "3SHA PRICE ABOVE + RK", text_color=color.white, bgcolor=_hd, text_size=size.small)
    table.cell(hud, 1, 0, confirm_mode == "Immediate" ? "IMMEDIATE" : "CONFIRMED", text_color=color.white, bgcolor=_hd, text_size=size.small)

    _align_txt = all_bull ? "▲ ABOVE ALL" : all_bear ? "▼ BELOW ALL" : "◇ MIXED"
    _align_col = all_bull ? color.new(#2962FF, 0) : all_bear ? color.new(#F23645, 0) : color.new(#888888, 0)
    table.cell(hud, 0, 1, "Price vs SHA", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 1, _align_txt, text_color=color.white, bgcolor=_align_col, text_size=size.small)

    table.cell(hud, 0, 2, "Layers B/1/2", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 2, (base_bull_bar?"▲":"▼")+" "+(htf1_bull_bar?"▲":"▼")+" "+(htf2_bull_bar?"▲":"▼"), text_color=color.white, bgcolor=_bg, text_size=size.small)

    _pos_txt = pos_dir == "long" ? "LONG" : pos_dir == "short" ? "SHORT" : "FLAT"
    _pos_col = pos_dir == "long" ? color.new(#1B5E20, 0) : pos_dir == "short" ? color.new(#8B0000, 0) : color.new(#444444, 0)
    table.cell(hud, 0, 3, "Position", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 3, _pos_txt, text_color=color.white, bgcolor=_pos_col, text_size=size.small)

    _rr_now = pos_dir == "long" and risk_unit > 0 ? (close - entry_price)/risk_unit : pos_dir == "short" and risk_unit > 0 ? (entry_price - close)/risk_unit : na
    table.cell(hud, 0, 4, "Open R", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 4, na(_rr_now) ? "—" : str.tostring(_rr_now, "0.00")+"R", text_color=color.white, bgcolor=_bg, text_size=size.small)

    table.cell(hud, 0, 5, "Entry", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 5, na(entry_price) ? "—" : str.tostring(entry_price, format.mintick), text_color=color.white, bgcolor=_bg, text_size=size.small)

    table.cell(hud, 0, 6, "Stop"+(be_moved?" (BE+)":""), text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 6, na(stop_level) ? "—" : str.tostring(stop_level, format.mintick), text_color=color.white, bgcolor=_bg, text_size=size.small)

    table.cell(hud, 0, 7, "Eligible B/1/2", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 7, (elig_b?"●":"○")+" "+(elig_1?"●":"○")+" "+(elig_2?"●":"○"), text_color=color.white, bgcolor=_bg, text_size=size.small)

    table.cell(hud, 0, 8, "Instrument", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 8, instrument_type, text_color=color.white, bgcolor=_bg, text_size=size.small)

    table.cell(hud, 0, 9, "Renko" + (renko_on ? "" : " (off)"), text_color=color.white, bgcolor=_bg, text_size=size.small)
    _rk_txt = not renko_on ? "— disabled" : na(rk_box) ? "warm-up" : (rk_dir == 1 ? "▲ UP" : rk_dir == -1 ? "▼ DOWN" : "◇ none") + "  x" + str.tostring(rk_run) + "  box " + str.tostring(rk_box, format.mintick)
    _rk_col = not renko_on ? color.new(#888888, 0) : rk_dir == 1 ? color.new(#2962FF, 0) : rk_dir == -1 ? color.new(#F23645, 0) : color.new(#888888, 0)
    table.cell(hud, 1, 9, _rk_txt, text_color=color.white, bgcolor=_rk_col, text_size=size.small)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(did_enter and pos_dir == "long",  "PAA Long Entry",  "3SHA Price Above All — LONG entry")
alertcondition(did_enter and pos_dir == "short", "PAA Short Entry", "3SHA Price Above All — SHORT entry")
alertcondition(did_exit, "PAA Exit", "3SHA Price Above All — position closed")
