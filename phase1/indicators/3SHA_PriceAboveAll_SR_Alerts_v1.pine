//@version=6
// ============================================================================
// 3SHA — PRICE ABOVE ALL ALERTS  (companion indicator to 3SHA-PA strategy)
// ============================================================================
// WHY A SEPARATE SCRIPT:
//   TradingView does not allow alertcondition() inside a strategy, and a
//   strategy only signals when it would actually TAKE a trade (flat-only,
//   pyramiding=0) — so a condition met while already in a position is silent.
//   This indicator fires on EVERY occurrence, and gives one alert per event
//   type so sound/popup can be set separately for each.
//
// THE CALCULATION BLOCK BELOW MIRRORS 3SHA_PriceAboveAll_v1.pine VERBATIM.
//   Do not edit it here independently. If the strategy changes, copy the
//   change across and re-verify that the alignment output matches.
//
// ALERT SETUP (in TradingView, not in this code):
//   Right-click chart -> Add alert -> Condition = "3SHA-PA Alerts" -> pick the
//   event. Notifications tab: tick "Show popup" and "Play sound".
//   SET TRIGGER TO "Once Per Bar Close". The signal is close-based; firing
//   intrabar produces phantom alerts that vanish when the candle closes.
// ============================================================================

indicator("3SHA Price Above All + S/R Alerts", shorttitle="3SHA-PA-SR Alerts", overlay=true,
     max_labels_count=500, max_lines_count=500)

// ============================================================================
// SHA FUNCTION — two-pass EMA -> HA -> EMA   (verbatim from the strategy)
// ============================================================================
f_sha(_len1, _len2, _o, _h, _l, _c) =>
    o1  = ta.ema(_o, _len1)
    h1  = ta.ema(_h, _len1)
    l1  = ta.ema(_l, _len1)
    c1  = ta.ema(_c, _len1)
    haC = (o1 + h1 + l1 + c1) / 4.0
    var float haO = na
    haO := na(haO[1]) ? (o1 + c1) / 2.0 : (haO[1] + haC[1]) / 2.0
    haH = math.max(h1, math.max(haO, haC))
    haL = math.min(l1, math.min(haO, haC))
    o2  = ta.ema(haO, _len2)
    h2  = ta.ema(haH, _len2)
    l2  = ta.ema(haL, _len2)
    c2  = ta.ema(haC, _len2)
    [o2, h2, l2, c2]

// ============================================================================
// ① SHA LAYERS
// ============================================================================
grp_base = "① ━━━ BASE LAYER (chart TF) ━━━"
base_len1 = input.int(4, "Base Stage-1 EMA", minval=1, group=grp_base)
base_len2 = input.int(8, "Base Stage-2 EMA", minval=1, group=grp_base)

grp_htf1 = "② ━━━ HTF1 — MID LAYER ━━━"
htf1_tf   = input.timeframe("60", "HTF1 Timeframe", group=grp_htf1)
htf1_len1 = input.int(4, "HTF1 Stage-1 EMA", minval=1, group=grp_htf1)
htf1_len2 = input.int(8, "HTF1 Stage-2 EMA", minval=1, group=grp_htf1)

grp_htf2 = "③ ━━━ HTF2 — SLOW LAYER ━━━"
htf2_tf   = input.timeframe("240", "HTF2 Timeframe", group=grp_htf2)
htf2_len1 = input.int(4, "HTF2 Stage-1 EMA", minval=1, group=grp_htf2)
htf2_len2 = input.int(8, "HTF2 Stage-2 EMA", minval=1, group=grp_htf2)

grp_layers_disp = "① ━━━ SHA DISPLAY  [all layers] ━━━"
show_wicks   = input.bool(false, "Show Wicks (all layers)",   group=grp_layers_disp)
show_borders = input.bool(true,  "Show Borders (all layers)", group=grp_layers_disp)
base_show = input.bool(true, "Show Base SHA Candles", group=grp_base)
base_bull = input.color(color.new(#2962FF, 0), "Bull Color", group=grp_base)
base_bear = input.color(color.new(#FF9800, 0), "Bear Color", group=grp_base)
base_border  = input.color(color.new(#000000, 0), "Border Color", group=grp_base)
base_wick    = input.color(color.new(#555555, 0), "Wick Color",   group=grp_base)
base_opacity = input.int(0, "Opacity (0=solid 100=invisible)", minval=0, maxval=100, group=grp_base)
htf1_show = input.bool(true, "Show HTF1 SHA Candles", group=grp_htf1)
htf1_bull = input.color(color.new(#2962FF, 0), "Bull Color", group=grp_htf1)
htf1_bear = input.color(color.new(#F23645, 0), "Bear Color", group=grp_htf1)
htf1_border_bull = input.color(color.new(#000000, 0), "Bull Border Color", group=grp_htf1)
htf1_border_bear = input.color(color.new(#000000, 0), "Bear Border Color", group=grp_htf1)
htf1_wick = input.color(color.new(#555555, 0), "Wick Color", group=grp_htf1)
htf1_opacity = input.int(25, "Opacity (0=solid 100=invisible)", minval=0, maxval=100, group=grp_htf1)
htf2_show = input.bool(true, "Show HTF2 SHA Candles", group=grp_htf2)
htf2_bull = input.color(color.new(#2962FF, 0), "Bull Color", group=grp_htf2)
htf2_bear = input.color(color.new(#F23645, 0), "Bear Color", group=grp_htf2)
htf2_border_bull = input.color(color.new(#000000, 0), "Bull Border Color", group=grp_htf2)
htf2_border_bear = input.color(color.new(#000000, 0), "Bear Border Color", group=grp_htf2)
htf2_wick = input.color(color.new(#555555, 0), "Wick Color", group=grp_htf2)
htf2_opacity = input.int(50, "Opacity (0=solid 100=invisible)", minval=0, maxval=100, group=grp_htf2)

// ── RAW CANDLE SOURCE ─────────────────────────────────────────
// Pine's open/high/low/close return whatever the CHART is showing. On a
// Renko, Heikin-Ashi, Kagi or Line-Break chart those are synthetic values,
// so the SHA layers would be built from bricks instead of from price and
// would move every time the chart type changed. Everything below sources
// from a standard ticker instead, so the layers are identical on any chart
// type. NOTE: this fixes the SIGNALS only. Orders still fill at whatever
// price the chart bar reports, so backtests must be run on standard
// candles regardless — fills on Renko/HA are not real prices.
tStd = ticker.standard(syminfo.tickerid)
[rawO, rawH, rawL, rawC] = request.security(tStd, timeframe.period, [open, high, low, close], barmerge.gaps_off, barmerge.lookahead_off)

// ── Compute layers (HTF smoothed natively inside request.security) ──────────
[bO, bH, bL, bC]     = f_sha(base_len1, base_len2, rawO, rawH, rawL, rawC)
[h1O, h1H, h1L, h1C] = request.security(tStd, htf1_tf, f_sha(htf1_len1, htf1_len2, open, high, low, close), barmerge.gaps_off, barmerge.lookahead_off)
[h2O, h2H, h2L, h2C] = request.security(tStd, htf2_tf, f_sha(htf2_len1, htf2_len2, open, high, low, close), barmerge.gaps_off, barmerge.lookahead_off)

day_open   = request.security(tStd, "1D", open,     barmerge.gaps_off, barmerge.lookahead_off)
day_pclose = request.security(tStd, "1D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
gap_pct    = not na(day_open) and not na(day_pclose) and day_pclose != 0 ? math.abs(day_open - day_pclose) / day_pclose * 100.0 : 0.0

base_ready = not na(bO)  and not na(bC)
htf1_ready = not na(h1O) and not na(h1C)
htf2_ready = not na(h2O) and not na(h2C)
all_ready  = base_ready and htf1_ready and htf2_ready

base_bull_bar = bC  >= bO
htf1_bull_bar = h1C >= h1O
htf2_bull_bar = h2C >= h2O
sha_bot_0 = math.min(bO, bC)
sha_top_0 = math.max(bO, bC)
sha_top_1 = math.max(h1O, h1C)
sha_bot_1 = math.min(h1O, h1C)
sha_top_2 = math.max(h2O, h2C)
sha_bot_2 = math.min(h2O, h2C)

// ============================================================================
// ④ ENTRY — PRICE ABOVE ALL
// ============================================================================
grp_entry = "④ ━━━ ENTRY: PRICE ABOVE ALL ━━━"
pa_layers = input.string("All three", "Price Must Clear", options=["All three","HTF1 + HTF2","Base + HTF1","Base + HTF2","HTF2 only","HTF1 only","Base only","Any two"], tooltip="Which SHA layers price has to close beyond. 'All three' is the strictest. Base only has no higher-timeframe context at all — it is a control for measuring what HTF1 and HTF2 contribute, not a signal to trade.", group=grp_entry)
confirm_mode = input.string("Confirmed (1-bar)", "Confirmation Mode", options=["Confirmed (1-bar)","Immediate"], tooltip="Confirmed (1-bar): fires the bar AFTER price completes the condition.\nImmediate: fires on the bar price completes it.", group=grp_entry)
allow_longs  = input.bool(true, "Allow Longs", group=grp_entry)
allow_shorts = input.bool(true, "Allow Shorts", group=grp_entry)
entry_needs_dir = input.bool(true, "Entry Candle Must Match Direction", tooltip="Longs only open on a bull candle (close above open), shorts only on a bear candle. A candle that closes exactly at its open is neither, so it takes no trade. Applies to every entry, including re-entries and stop reversals.", group=grp_entry)
use_reentry = input.bool(false, "Re-Enter After Exit", tooltip="After a trade closes, arm the setup again. It fires when the setup is valid AND a candle CLOSES beyond the reference level. The reference is the close of whichever candle came last: the one the trade exited on, or the one that made the setup invalid.", group=grp_entry)
reentry_needs_base = input.bool(true, "  Setup Must Still Hold", group=grp_entry)
reentry_style = input.string("Two-candle pattern", "  Re-Entry Style", options=["Two-candle pattern","Close beyond reference"], tooltip="Two-candle pattern: after the setup is valid again, wait for a candle that closes beyond the SHA layer body below (the trigger candle), then enter at the close of a later candle that closes beyond the TRIGGER CANDLE'S low (short) or high (long).\n\nClose beyond reference: the simpler rule - enter on any close beyond the close of the candle the trade exited on, or of the candle that made the setup invalid, whichever came last.", group=grp_entry)
reentry_layer = input.string("Base", "  Re-Entry Trigger Layer", options=["Base","HTF1","HTF2"], tooltip="Which SHA layer's body the trigger candle has to close beyond. This applies to RE-ENTRY ONLY - it does not change what the first entry requires.", group=grp_entry)
gap_thresh   = input.float(0.0, "Skip Gap Entries Above (%)", minval=0.0, step=0.1, tooltip="0 = OFF, no gap is ever skipped. Any value above 0 is the gap size that invalidates an entry: if the day opened more than this away from the prior day's close, an entry firing on that open is skipped, because the alignment was likely manufactured by the gap rather than earned. The day itself is not blocked - a later, non-gap re-alignment enters normally.", group=grp_entry)

// ============================================================================
// ⑤ INITIAL STOP  (needed so stop-hit alerts match the strategy)
// ============================================================================
grp_sl = "⑤ ━━━ INITIAL STOP ━━━"
sl_mode = input.string("Swing (Prev N Bars)", "Stop Anchor", options=["Trigger Candle","Swing (Prev N Bars)","Base SHA Body","HTF1 SHA Body","HTF2 SHA Body","Last Bar Beyond Nearest SHA","Last Bar Beyond Furthest SHA","Last SHA Bar Beyond Nearest SHA","Last SHA Bar Beyond Furthest SHA","Closest Eligible SHA","Middle Eligible SHA","Furthest Eligible SHA"], tooltip="Last Bar Beyond ... : the most recent bar with ANY part past the SHA — below its lower edge for a long, above its upper edge for a short. Covers bars wholly beyond and bars straddling the edge. 'SHA Bar' tests the smoothed candle instead of the raw one. Nearest/furthest is decided at entry by which higher layer is closer to price. No lookback limit.", group=grp_sl)
sl_price_basis = input.string("Body (open/close)", "Anchor Uses", options=["Body (open/close)","Wick (high/low)"], group=grp_sl)
sl_lookback = input.int(10, "Swing Lookback (bars)", minval=1, maxval=100, group=grp_sl)
sl_buffer_pct = input.float(0.10, "Stop Buffer (%)", minval=0.0, step=0.01, tooltip="How far beyond the anchor the stop sits, as a percentage of price. 0.10 means one tenth of one percent. Percent rather than a fixed amount so the same setting is meaningful on any instrument.", group=grp_sl)
sl_buffer_raw = rawC * sl_buffer_pct / 100
min_stop_pct = input.float(0.00, "Min Stop Distance (%)", minval=0.0, step=0.01, tooltip="Floor on stop distance, as a percentage of price. The stop is never placed closer to entry than this. 0 = off.", group=grp_sl)
min_stop_raw = rawC * min_stop_pct / 100
use_hard_stop = input.bool(false, "Hard Stop (intra-bar)", tooltip="OFF: stop-hit alerts fire only when a candle CLOSES beyond the stop (matches the strategy default).\nON: fires the moment price touches the stop intra-bar.", group=grp_sl)

body_low  = math.min(rawO, rawC)
body_high = math.max(rawO, rawC)

swing_low_wick  = ta.lowest(rawL,  sl_lookback)
swing_high_wick = ta.highest(rawH, sl_lookback)
swing_low_body  = ta.lowest(body_low,  sl_lookback)
swing_high_body = ta.highest(body_high, sl_lookback)

sl_use_body   = sl_price_basis == "Body (open/close)"
trig_low_lvl  = sl_use_body ? body_low  : rawL
trig_high_lvl = sl_use_body ? body_high : rawH
sw_low_lvl    = sl_use_body ? swing_low_body  : swing_low_wick
sw_high_lvl   = sl_use_body ? swing_high_body : swing_high_wick

// ── ENTRY CONDITION: WHERE PRICE SITS, NOT WHICH WAY EACH LAYER POINTS ─────
// Sits below the stop inputs because it reads sl_price_basis, and Pine requires
// an input to be declared before it is used.
_pa_body = sl_price_basis == "Body (open/close)"
pa_b_top = _pa_body ? math.max(bO, bC)  : bH
pa_b_bot = _pa_body ? math.min(bO, bC)  : bL
pa_1_top = _pa_body ? math.max(h1O,h1C) : h1H
pa_1_bot = _pa_body ? math.min(h1O,h1C) : h1L
pa_2_top = _pa_body ? math.max(h2O,h2C) : h2H
pa_2_bot = _pa_body ? math.min(h2O,h2C) : h2L

_ab = rawC > pa_b_top
_a1 = rawC > pa_1_top
_a2 = rawC > pa_2_top
_bb = rawC < pa_b_bot
_b1 = rawC < pa_1_bot
_b2 = rawC < pa_2_bot
_n_above = (_ab ? 1 : 0) + (_a1 ? 1 : 0) + (_a2 ? 1 : 0)
_n_below = (_bb ? 1 : 0) + (_b1 ? 1 : 0) + (_b2 ? 1 : 0)

all_bull = all_ready and (pa_layers == "All three"          ? (_ab and _a1 and _a2)
   : pa_layers == "HTF1 + HTF2"        ? (_a1 and _a2)
   : pa_layers == "Base + HTF1"        ? (_ab and _a1)
   : pa_layers == "Base + HTF2"        ? (_ab and _a2)
   : pa_layers == "HTF2 only"          ? _a2
   : pa_layers == "HTF1 only"          ? _a1
   : pa_layers == "Base only"          ? _ab
   :                                     _n_above >= 2)
all_bear = all_ready and (pa_layers == "All three"          ? (_bb and _b1 and _b2)
   : pa_layers == "HTF1 + HTF2"        ? (_b1 and _b2)
   : pa_layers == "Base + HTF1"        ? (_bb and _b1)
   : pa_layers == "Base + HTF2"        ? (_bb and _b2)
   : pa_layers == "HTF2 only"          ? _b2
   : pa_layers == "HTF1 only"          ? _b1
   : pa_layers == "Base only"          ? _bb
   :                                     _n_below >= 2)

pa_bull_raw = confirm_mode == "Confirmed (1-bar)" ? (all_bull[1] and not all_bull[2]) : (all_bull and not all_bull[1])
pa_bear_raw = confirm_mode == "Confirmed (1-bar)" ? (all_bear[1] and not all_bear[2]) : (all_bear and not all_bear[1])

is_new_day = ta.change(time("1D")) != 0
gap_block  = gap_thresh > 0 and is_new_day and gap_pct > gap_thresh

// ── LAST-BAR-BEYOND ANCHORS (mirrors the strategy verbatim) ────────────────
px_low_test  = sl_use_body ? body_low  : rawL
px_high_test = sl_use_body ? body_high : rawH
ha_low_test  = sl_use_body ? math.min(bO, bC) : bL
ha_high_test = sl_use_body ? math.max(bO, bC) : bH
h1_bot_edge  = sl_use_body ? sha_bot_1 : h1L
h1_top_edge  = sl_use_body ? sha_top_1 : h1H
h2_bot_edge  = sl_use_body ? sha_bot_2 : h2L
h2_top_edge  = sl_use_body ? sha_top_2 : h2H

var float xl_px_h1 = na, var float xl_px_h2 = na
var float xl_ha_h1 = na, var float xl_ha_h2 = na
var float xh_px_h1 = na, var float xh_px_h2 = na
var float xh_ha_h1 = na, var float xh_ha_h2 = na
if not na(h1_bot_edge) and px_low_test  < h1_bot_edge
    xl_px_h1 := px_low_test
if not na(h2_bot_edge) and px_low_test  < h2_bot_edge
    xl_px_h2 := px_low_test
if not na(h1_bot_edge) and ha_low_test  < h1_bot_edge
    xl_ha_h1 := ha_low_test
if not na(h2_bot_edge) and ha_low_test  < h2_bot_edge
    xl_ha_h2 := ha_low_test
if not na(h1_top_edge) and px_high_test > h1_top_edge
    xh_px_h1 := px_high_test
if not na(h2_top_edge) and px_high_test > h2_top_edge
    xh_px_h2 := px_high_test
if not na(h1_top_edge) and ha_high_test > h1_top_edge
    xh_ha_h1 := ha_high_test
if not na(h2_top_edge) and ha_high_test > h2_top_edge
    xh_ha_h2 := ha_high_test

d_h1_bot = na(h1_bot_edge) ? 1e18 : math.abs(rawC - h1_bot_edge)
d_h2_bot = na(h2_bot_edge) ? 1e18 : math.abs(rawC - h2_bot_edge)
d_h1_top = na(h1_top_edge) ? 1e18 : math.abs(rawC - h1_top_edge)
d_h2_top = na(h2_top_edge) ? 1e18 : math.abs(rawC - h2_top_edge)
near_is_h1_long  = d_h1_bot <= d_h2_bot
near_is_h1_short = d_h1_top <= d_h2_top


// ═════════════════════════════════════════════════════════════════════════════
// DAILY CUTOFF  (mirrors the strategy)
// ═════════════════════════════════════════════════════════════════════════════
// Closes the tracked trade at a set time each day and stops new entries for
// the rest of that day, so the alerts agree with the strategy. The clock is
// EXCHANGE time, so it follows daylight saving on its own and is right for
// whichever market the instrument trades on. On a 24-hour instrument set it to
// whichever close matters (e.g. the NY close).
grp_eod = "① ━━━ DATE FILTER ━━━"
use_date = input.bool(false, "Enable Date Range", group=grp_eod)
date_start = input.time(timestamp("2025-01-01 00:00"), "Start", group=grp_eod)
date_end   = input.time(timestamp("2026-12-31 23:59"), "End", group=grp_eod)
in_date = not use_date or (time >= date_start and time <= date_end)
use_eod    = input.bool(false, "Daily Cutoff", tooltip="Close the tracked trade at the cutoff time and take no new trades until the next day. Off by default.", group=grp_eod)
eod_hour   = input.int(15, "  Cutoff Hour (exchange time, 0-23)", minval=0, maxval=23, tooltip="24-hour clock in the exchange's own time zone. 15 = 3 PM. For a US stock, 15:55 is five minutes before the close.", group=grp_eod)
eod_minute = input.int(55, "  Cutoff Minute", minval=0, maxval=59, group=grp_eod)
eod_block_entries = input.bool(true, "  Block New Entries After Cutoff", tooltip="Stops new trades opening in the minutes after the cutoff only to be closed straight away.", group=grp_eod)

_now_min = hour(time, syminfo.timezone) * 60 + minute(time, syminfo.timezone)
_eod_min = eod_hour * 60 + eod_minute
past_cutoff = use_eod and _now_min >= _eod_min
eod_entry_block = past_cutoff and eod_block_entries

// ============================================================================
// TRADE STATE  (declared here — eligibility, ranking and the trail all read
// pos_dir before the management block runs)
// ============================================================================
var string pos_dir     = "flat"
var float  entry_price = na
var float  stop_level  = na
var float  init_stop   = na    // the stop as first placed, before break-even or trailing move it
var float  risk_unit   = na
var bool   be_moved    = false
var int    bad_bars    = 0
var float  peak_r      = 0.0
var int    entry_bar   = na
var float  rearm_high  = na
var float  rearm_low   = na

// ── ELIGIBILITY AND ARMING (mirrors the strategy) ──────────────────────
// elig_* : price has CLOSED beyond this layer during the trade. Only an
//          eligible layer may end it.
// arm_*  : this layer has pointed WITH the trade during it. Only an armed layer
//          can be said to have flipped against it.
var bool elig_b = false
var bool elig_1 = false
var bool elig_2 = false
var bool arm_b  = false
var bool arm_1  = false
var bool arm_2  = false

inst_el_b_long  = rawC > pa_b_top
inst_el_1_long  = rawC > pa_1_top
inst_el_2_long  = rawC > pa_2_top
inst_el_b_short = rawC < pa_b_bot
inst_el_1_short = rawC < pa_1_bot
inst_el_2_short = rawC < pa_2_bot

if pos_dir == "long"
    elig_b := elig_b or inst_el_b_long
    elig_1 := elig_1 or inst_el_1_long
    elig_2 := elig_2 or inst_el_2_long
    arm_b  := arm_b  or base_bull_bar
    arm_1  := arm_1  or htf1_bull_bar
    arm_2  := arm_2  or htf2_bull_bar
else if pos_dir == "short"
    elig_b := elig_b or inst_el_b_short
    elig_1 := elig_1 or inst_el_1_short
    elig_2 := elig_2 or inst_el_2_short
    arm_b  := arm_b  or not base_bull_bar
    arm_1  := arm_1  or not htf1_bull_bar
    arm_2  := arm_2  or not htf2_bull_bar

// ── DISTANCE RANKING OF THE ELIGIBLE LAYERS ─────────────────────────
// [closest, middle, furthest] by absolute distance from the close. Two eligible
// → middle resolves to furthest; one → all three resolve to it; none → all na
// and the caller falls back to Swing.
f_rank(_e0, _l0, _e1, _l1, _e2, _l2, _ref) =>
    _lv = array.new_float()
    _ds = array.new_float()
    if _e0 and not na(_l0)
        array.push(_lv, _l0)
        array.push(_ds, math.abs(_ref - _l0))
    if _e1 and not na(_l1)
        array.push(_lv, _l1)
        array.push(_ds, math.abs(_ref - _l1))
    if _e2 and not na(_l2)
        array.push(_lv, _l2)
        array.push(_ds, math.abs(_ref - _l2))
    _n = array.size(_lv)
    float _near = na
    float _mid  = na
    float _far  = na
    if _n > 0
        _ix = array.sort_indices(_ds, order.ascending)
        _near := array.get(_lv, array.get(_ix, 0))
        _far  := array.get(_lv, array.get(_ix, _n - 1))
        _mid  := _n >= 3 ? array.get(_lv, array.get(_ix, 1)) : _far
    [_near, _mid, _far]

[ik_near_L, ik_mid_L, ik_far_L] = f_rank(inst_el_b_long,  sha_bot_0, inst_el_1_long,  sha_bot_1, inst_el_2_long,  sha_bot_2, rawC)
[ik_near_S, ik_mid_S, ik_far_S] = f_rank(inst_el_b_short, sha_top_0, inst_el_1_short, sha_top_1, inst_el_2_short, sha_top_2, rawC)
[rk_near_L, rk_mid_L, rk_far_L] = f_rank(elig_b, sha_bot_0, elig_1, sha_bot_1, elig_2, sha_bot_2, rawC)
[rk_near_S, rk_mid_S, rk_far_S] = f_rank(elig_b, sha_top_0, elig_1, sha_top_1, elig_2, sha_top_2, rawC)

f_long_stop(_kn, _km, _kf) =>
    _near = near_is_h1_long
    _lcp  = _near ? xl_px_h1 : xl_px_h2
    _lcpF = _near ? xl_px_h2 : xl_px_h1
    _lch  = _near ? xl_ha_h1 : xl_ha_h2
    _lchF = _near ? xl_ha_h2 : xl_ha_h1
    _lvl = sl_mode == "Trigger Candle"                     ? trig_low_lvl
      :    sl_mode == "Swing (Prev N Bars)"                ? sw_low_lvl
      :    sl_mode == "Base SHA Body"                      ? sha_bot_0
      :    sl_mode == "HTF1 SHA Body"                      ? sha_bot_1
      :    sl_mode == "HTF2 SHA Body"                      ? sha_bot_2
      :    sl_mode == "Last Bar Beyond Nearest SHA"        ? (na(_lcp)  ? sw_low_lvl : _lcp)
      :    sl_mode == "Last Bar Beyond Furthest SHA"       ? (na(_lcpF) ? sw_low_lvl : _lcpF)
      :    sl_mode == "Last SHA Bar Beyond Nearest SHA"    ? (na(_lch)  ? sw_low_lvl : _lch)
      :    sl_mode == "Last SHA Bar Beyond Furthest SHA"   ? (na(_lchF) ? sw_low_lvl : _lchF)
      :    sl_mode == "Closest Eligible SHA"          ? (na(_kn) ? sw_low_lvl : _kn)
      :    sl_mode == "Middle Eligible SHA"           ? (na(_km) ? sw_low_lvl : _km)
      :    sl_mode == "Furthest Eligible SHA"         ? (na(_kf) ? sw_low_lvl : _kf)
      :                                                      sw_low_lvl
    _s = _lvl - sl_buffer_raw
    min_stop_raw > 0 ? math.min(_s, rawC - min_stop_raw) : _s

f_short_stop(_kn, _km, _kf) =>
    _near = near_is_h1_short
    _hcp  = _near ? xh_px_h1 : xh_px_h2
    _hcpF = _near ? xh_px_h2 : xh_px_h1
    _hch  = _near ? xh_ha_h1 : xh_ha_h2
    _hchF = _near ? xh_ha_h2 : xh_ha_h1
    _lvl = sl_mode == "Trigger Candle"                     ? trig_high_lvl
      :    sl_mode == "Swing (Prev N Bars)"                ? sw_high_lvl
      :    sl_mode == "Base SHA Body"                      ? sha_top_0
      :    sl_mode == "HTF1 SHA Body"                      ? sha_top_1
      :    sl_mode == "HTF2 SHA Body"                      ? sha_top_2
      :    sl_mode == "Last Bar Beyond Nearest SHA"        ? (na(_hcp)  ? sw_high_lvl : _hcp)
      :    sl_mode == "Last Bar Beyond Furthest SHA"       ? (na(_hcpF) ? sw_high_lvl : _hcpF)
      :    sl_mode == "Last SHA Bar Beyond Nearest SHA"    ? (na(_hch)  ? sw_high_lvl : _hch)
      :    sl_mode == "Last SHA Bar Beyond Furthest SHA"   ? (na(_hchF) ? sw_high_lvl : _hchF)
      :    sl_mode == "Closest Eligible SHA"          ? (na(_kn) ? sw_high_lvl : _kn)
      :    sl_mode == "Middle Eligible SHA"           ? (na(_km) ? sw_high_lvl : _km)
      :    sl_mode == "Furthest Eligible SHA"         ? (na(_kf) ? sw_high_lvl : _kf)
      :                                                      sw_high_lvl
    _s = _lvl + sl_buffer_raw
    min_stop_raw > 0 ? math.max(_s, rawC + min_stop_raw) : _s

// ============================================================================
// ⑥ TRADE MANAGEMENT
// ============================================================================
grp_mgmt = "⑥ ━━━ TRADE MANAGEMENT ━━━"
use_be = input.bool(true, "Move Stop To Break-Even", group=grp_mgmt)
be_trigger_r = input.float(1.0, "  Break-Even Trigger (R)", minval=0.1, step=0.1, group=grp_mgmt)
be_offset_pct = input.float(0.00, "  Break-Even Offset (%)", minval=0.0, step=0.01, tooltip="How far beyond entry the break-even stop sits, as a percentage of price. 0 = exactly at entry.", group=grp_mgmt)
be_offset_raw = rawC * be_offset_pct / 100
use_trail = input.bool(true, "Trailing Stop", group=grp_mgmt)
trail_mode = input.string("Swing (Prev N Bars)", "  Trail Anchor", options=["Swing (Prev N Bars)","Base SHA Body","HTF1 SHA Body","HTF2 SHA Body","Closest Eligible SHA","Middle Eligible SHA","Furthest Eligible SHA"], group=grp_mgmt)
trail_price_basis = input.string("Body (open/close)", "  Trail Uses", options=["Body (open/close)","Wick (high/low)"], group=grp_mgmt)
trail_start_r = input.float(1.0, "  Trail Activates At (R)", minval=0.1, step=0.1, group=grp_mgmt)
trail_lookback = input.int(6, "  Trail Lookback (bars)", minval=1, maxval=100, group=grp_mgmt)
trail_buffer_pct = input.float(0.10, "  Trail Buffer (%)", minval=0.0, step=0.01, tooltip="How far beyond the trail anchor the trailing stop sits, as a percentage of price.", group=grp_mgmt)
trail_buffer_raw = rawC * trail_buffer_pct / 100
reverse_on_stop = input.bool(false, "Reverse On Stop", tooltip="On a stop hit, immediately flip to the opposite side IF that side is fully aligned at that moment, its direction is allowed, and the gap filter passes.", group=grp_mgmt)
align_confirm_bars = input.int(1, "  Flip Must Hold (bars)", minval=1, maxval=20, group=grp_mgmt)
use_sha_break = input.bool(false, "Exit: Price Back Through SHA", group=grp_mgmt)
sha_break_layer = input.string("HTF1", "  Which Layer", options=["Base","HTF1","HTF2"], group=grp_mgmt)
use_target = input.bool(false, "Exit: Profit Target", group=grp_mgmt)
target_r = input.float(3.0, "  Target (R)", minval=0.5, step=0.5, group=grp_mgmt)
use_giveback = input.bool(false, "Exit: Give-Back", group=grp_mgmt)
giveback_pct = input.float(40.0, "  Give-Back (% of peak)", minval=5, maxval=95, step=5, group=grp_mgmt)
giveback_min_r = input.float(1.0, "  Only After (R)", minval=0.1, step=0.1, group=grp_mgmt)
use_time_stop = input.bool(false, "Exit: Time Stop", group=grp_mgmt)
time_stop_bars = input.int(30, "  After (bars)", minval=1, group=grp_mgmt)
time_stop_min_r = input.float(0.5, "  Unless Ahead By (R)", minval=0.0, step=0.1, group=grp_mgmt)
use_cross_exit = input.bool(false, "Exit: Chart SHA Crosses Mid SHA", group=grp_mgmt)
use_align_exit = input.bool(false, "Exit: Layer Flips Direction", tooltip="Exit when a SHA layer turns against the trade. OFF by default: entries are based on where PRICE sits, so a layer can point the wrong way at entry. Gated on ELIGIBLE (price closed beyond it during the trade) and ARMED (it pointed with the trade at some point).", group=grp_mgmt)
align_break_level = input.string("HTF1 Flips", "  Flip Trigger", options=["Base Flips","HTF1 Flips","HTF2 Flips","Any Layer Flips","All Layers Flip"], group=grp_mgmt)

trail_sw_low_wick  = ta.lowest(rawL,  trail_lookback)
trail_sw_low_body  = ta.lowest(body_low,  trail_lookback)
trail_sw_high_wick = ta.highest(rawH, trail_lookback)
trail_sw_high_body = ta.highest(body_high, trail_lookback)
trail_use_body = trail_price_basis == "Body (open/close)"
trail_sw_low   = trail_use_body ? trail_sw_low_body  : trail_sw_low_wick
trail_sw_high  = trail_use_body ? trail_sw_high_body : trail_sw_high_wick

trail_low_anchor  = trail_mode == "Swing (Prev N Bars)" ? trail_sw_low  : trail_mode == "Base SHA Body" ? sha_bot_0 : trail_mode == "HTF1 SHA Body" ? sha_bot_1 : trail_mode == "HTF2 SHA Body" ? sha_bot_2 : trail_mode == "Closest Eligible SHA" ? rk_near_L : trail_mode == "Middle Eligible SHA" ? rk_mid_L : rk_far_L
trail_high_anchor = trail_mode == "Swing (Prev N Bars)" ? trail_sw_high : trail_mode == "Base SHA Body" ? sha_top_0 : trail_mode == "HTF1 SHA Body" ? sha_top_1 : trail_mode == "HTF2 SHA Body" ? sha_top_2 : trail_mode == "Closest Eligible SHA" ? rk_near_S : trail_mode == "Middle Eligible SHA" ? rk_mid_S : rk_far_S
trail_low_ref  = trail_low_anchor  - trail_buffer_raw
trail_high_ref = trail_high_anchor + trail_buffer_raw

cross_dn = ta.crossunder(bC, h1C)
cross_up = ta.crossover(bC, h1C)

shab_bot = sha_break_layer == "Base" ? math.min(bO, bC) : sha_break_layer == "HTF1" ? sha_bot_1 : sha_bot_2
shab_top = sha_break_layer == "Base" ? math.max(bO, bC) : sha_break_layer == "HTF1" ? sha_top_1 : sha_top_2

// ── LAYER-FLIP CONDITION (eligible AND armed AND now against the trade) ────
flip_b_long  = elig_b and arm_b and not base_bull_bar
flip_1_long  = elig_1 and arm_1 and not htf1_bull_bar
flip_2_long  = elig_2 and arm_2 and not htf2_bull_bar
flip_b_short = elig_b and arm_b and base_bull_bar
flip_1_short = elig_1 and arm_1 and htf1_bull_bar
flip_2_short = elig_2 and arm_2 and htf2_bull_bar
n_elig      = (elig_b ? 1 : 0) + (elig_1 ? 1 : 0) + (elig_2 ? 1 : 0)
n_flip_long = (flip_b_long ? 1 : 0) + (flip_1_long ? 1 : 0) + (flip_2_long ? 1 : 0)
n_flip_shrt = (flip_b_short ? 1 : 0) + (flip_1_short ? 1 : 0) + (flip_2_short ? 1 : 0)

align_broken_long = align_break_level == "Base Flips"      ? flip_b_long
   : align_break_level == "HTF1 Flips"      ? flip_1_long
   : align_break_level == "HTF2 Flips"      ? flip_2_long
   : align_break_level == "Any Layer Flips" ? (n_flip_long > 0)
   :                                          (n_elig > 0 and n_flip_long == n_elig)
align_broken_short = align_break_level == "Base Flips"      ? flip_b_short
   : align_break_level == "HTF1 Flips"      ? flip_1_short
   : align_break_level == "HTF2 Flips"      ? flip_2_short
   : align_break_level == "Any Layer Flips" ? (n_flip_shrt > 0)
   :                                          (n_elig > 0 and n_flip_shrt == n_elig)

// Held for the labels: the exit block clears entry_price and flips pos_dir to
// "flat" before either can be read.
var float  lbl_entry_px = na
var int    trade_no     = 0    // increments on every entry, so an exit can name the trade it closed
var int    exit_no      = 0    // the closing trade's number, captured before any same-bar entry
var float  exit_from_px = na   // and its entry price, for the same reason
var string pos_dir_prev = "flat"
pos_dir_prev := pos_dir

ev_entry_long  = false
ev_entry_short = false
ev_stop_hit    = false
ev_align_break = false
stopped_from   = ""

// ── manage the open hypothetical position first ────────────────────────────
if pos_dir == "long" and not na(stop_level)
    _r = risk_unit > 0 ? (rawC - entry_price) / risk_unit : 0.0
    if use_be and not be_moved and _r >= be_trigger_r
        stop_level := math.max(stop_level, entry_price + be_offset_raw)
        be_moved := true
    if use_trail and _r >= trail_start_r
        stop_level := math.max(stop_level, trail_low_ref)
    peak_r := math.max(peak_r, _r)
    bad_bars := align_broken_long ? bad_bars + 1 : 0
    _align_out = use_align_exit and bad_bars >= align_confirm_bars
    _other = (_align_out or (use_sha_break and rawC < shab_bot) or (use_target and _r >= target_r) or (use_giveback and peak_r >= giveback_min_r and _r <= peak_r * (1.0 - giveback_pct / 100.0)) or (use_time_stop and not na(entry_bar) and (bar_index - entry_bar) >= time_stop_bars and _r < time_stop_min_r) or (use_cross_exit and cross_dn)) or past_cutoff
    _stop_hit  = use_hard_stop ? (rawL <= stop_level) : (rawC <= stop_level)
    if _stop_hit or _other
        ev_stop_hit    := _stop_hit
        ev_align_break := _other and not _stop_hit
        if _stop_hit
            stopped_from := "long"
        rearm_high := rawC
        rearm_low := na
        pos_dir := "flat"
        elig_b := false
        elig_1 := false
        elig_2 := false
        arm_b  := false
        arm_1  := false
        arm_2  := false
        exit_no := trade_no
        exit_from_px := lbl_entry_px
        entry_price := na
        stop_level := na
        init_stop := na
        risk_unit := na
        be_moved := false
        bad_bars := 0
        peak_r := 0.0

else if pos_dir == "short" and not na(stop_level)
    _r = risk_unit > 0 ? (entry_price - rawC) / risk_unit : 0.0
    if use_be and not be_moved and _r >= be_trigger_r
        stop_level := math.min(stop_level, entry_price - be_offset_raw)
        be_moved := true
    if use_trail and _r >= trail_start_r
        stop_level := math.min(stop_level, trail_high_ref)
    peak_r := math.max(peak_r, _r)
    bad_bars := align_broken_short ? bad_bars + 1 : 0
    _align_out = use_align_exit and bad_bars >= align_confirm_bars
    _other = (_align_out or (use_sha_break and rawC > shab_top) or (use_target and _r >= target_r) or (use_giveback and peak_r >= giveback_min_r and _r <= peak_r * (1.0 - giveback_pct / 100.0)) or (use_time_stop and not na(entry_bar) and (bar_index - entry_bar) >= time_stop_bars and _r < time_stop_min_r) or (use_cross_exit and cross_up)) or past_cutoff
    _stop_hit  = use_hard_stop ? (rawH >= stop_level) : (rawC >= stop_level)
    if _stop_hit or _other
        ev_stop_hit    := _stop_hit
        ev_align_break := _other and not _stop_hit
        if _stop_hit
            stopped_from := "short"
        rearm_low := rawC
        rearm_high := na
        pos_dir := "flat"
        elig_b := false
        elig_1 := false
        elig_2 := false
        arm_b  := false
        arm_1  := false
        arm_2  := false
        exit_no := trade_no
        exit_from_px := lbl_entry_px
        entry_price := na
        stop_level := na
        init_stop := na
        risk_unit := na
        be_moved := false
        bad_bars := 0
        peak_r := 0.0

// ── then entries ───────────────────────────────────────────────────────────
// RE-ENTRY REFERENCE LEVEL
// The level to beat is the CLOSE of whichever candle came last: the one the
// trade exited on, or the one that made the setup invalid. When the setup
// breaks, the level moves to that breaking candle's close. It is not dropped
// and it is not carried over - the most recent event simply sets it.
if not na(rearm_high) and all_bull[1] and not all_bull
    rearm_high := rawC
if not na(rearm_low) and all_bear[1] and not all_bear
    rearm_low := rawC
// ── RE-ENTRY: TWO-CANDLE PATTERN ────────────────────────────────────────────
// Trigger candle: the first raw candle in the trade's direction that closes
// beyond the chosen SHA layer's body. Trade candle: a later raw candle in the
// same direction that closes beyond the TRIGGER CANDLE'S extreme - its low for
// a short, its high for a long. Entry is at that candle's close.
//
// The trigger never moves. Later candles clearing the layer body do not
// replace it. If the setup goes invalid the pattern is abandoned, and starts
// again from scratch when the setup returns.
rex_bot = reentry_layer == "Base" ? sha_bot_0 : reentry_layer == "HTF1" ? sha_bot_1 : sha_bot_2
rex_top = reentry_layer == "Base" ? sha_top_0 : reentry_layer == "HTF1" ? sha_top_1 : sha_top_2
raw_is_bull = rawC > rawO
raw_is_bear = rawC < rawO

var float trig_high = na
var float trig_low  = na

if na(rearm_high) or not all_bull
    trig_high := na
else if na(trig_high) and raw_is_bull and rawC > rex_top
    trig_high := rawH

if na(rearm_low) or not all_bear
    trig_low := na
else if na(trig_low) and raw_is_bear and rawC < rex_bot
    trig_low := rawL

pat_long  = not na(trig_high) and raw_is_bull and rawC > trig_high
pat_short = not na(trig_low)  and raw_is_bear and rawC < trig_low

ref_long  = not na(rearm_high) and rawC > rearm_high and (not reentry_needs_base or all_bull)
ref_short = not na(rearm_low)  and rawC < rearm_low  and (not reentry_needs_base or all_bear)

re_long  = use_reentry and (reentry_style == "Two-candle pattern" ? pat_long  : ref_long)
re_short = use_reentry and (reentry_style == "Two-candle pattern" ? pat_short : ref_short)

// ── SUPPORT / RESISTANCE FILTER ─────────────────────────────────────────────
// Reads levels from a SEPARATE indicator on the same chart. Point the two
// sources at that indicator's resistance and support plots; nothing is
// computed here and no third-party code is copied.
//
// The levels lag by design. A pivot needs its right-hand bars before it can be
// confirmed, so the level in force on any bar was established well before it.
// The other script draws its lines shifted BACK to the pivot, which makes them
// look present earlier than they were known - so do not judge this filter by
// eye off the chart. It is honest, it just knows less than the drawing implies.
grp_sr = "⑨ ━━━ S/R FILTER ━━━"
use_sr = input.bool(false, "Avoid Entries Near S/R", tooltip="Hold a long while resistance sits just above, and a short while support sits just below. OFF by default: it does nothing until both sources below are pointed at a support/resistance indicator on this chart.", group=grp_sr)
sr_res_src = input.source(close, "  Resistance Source", tooltip="Pick the resistance plot from your support/resistance indicator. Leaving this on close makes the filter meaningless, so it is ignored unless it differs from price.", group=grp_sr)
sr_sup_src = input.source(close, "  Support Source", tooltip="Pick the support plot from the same indicator.", group=grp_sr)
sr_band_pct = input.float(0.30, "  Keep Clear By (%)", minval=0.0, step=0.05, tooltip="How close price has to be to the level before entries are held, as a percentage of price. 0.30 on a $600 instrument is about $1.80.", group=grp_sr)

// A level only counts on the side it is actually on: resistance ABOVE price,
// support BELOW it. A pivot high that price has already cleared is acting as
// support, and holding longs on it would be backwards.
_sr_band  = rawC * sr_band_pct / 100.0
_sr_armed = use_sr and sr_res_src != rawC and sr_sup_src != rawC
sr_hold_long  = _sr_armed and not na(sr_res_src) and sr_res_src > rawC and (sr_res_src - rawC) <= _sr_band
sr_hold_short = _sr_armed and not na(sr_sup_src) and sr_sup_src < rawC and (rawC - sr_sup_src) <= _sr_band

// ── ARMED ENTRY ─────────────────────────────────────────────────────────────
// pa_bull_raw fires on a single bar. If the direction filter blocks that bar
// the signal would be gone for good, even though the setup may hold for hours -
// one bad bar could cost an entire move. So the setup ARMS the entry instead:
// it stays armed until a candle facing the right way turns up, and is dropped
// the moment the setup stops being valid. Always on; there is no case where
// firing once and giving up is preferable.
var bool pend_long  = false
var bool pend_short = false
if not all_bull
    pend_long := false
else if pa_bull_raw
    pend_long := true
if not all_bear
    pend_short := false
else if pa_bear_raw
    pend_short := true

sig_long  = pend_long
sig_short = pend_short

long_signal  = allow_longs  and (sig_long or re_long)  and in_date and not gap_block and not eod_entry_block and (not entry_needs_dir or raw_is_bull) and not sr_hold_long
short_signal = allow_shorts and (sig_short or re_short) and in_date and not gap_block and not eod_entry_block and (not entry_needs_dir or raw_is_bear) and not sr_hold_short
rev_long  = reverse_on_stop and stopped_from == "short" and all_bull and allow_longs  and in_date and not gap_block and not eod_entry_block and (not entry_needs_dir or raw_is_bull) and not sr_hold_long
rev_short = reverse_on_stop and stopped_from == "long"  and all_bear and allow_shorts and in_date and not gap_block and not eod_entry_block and (not entry_needs_dir or raw_is_bear) and not sr_hold_short

if pos_dir == "flat" and (long_signal or rev_long)
    _s = f_long_stop(ik_near_L, ik_mid_L, ik_far_L)
    if _s < rawC
        elig_b := inst_el_b_long
        elig_1 := inst_el_1_long
        elig_2 := inst_el_2_long
        arm_b  := base_bull_bar
        arm_1  := htf1_bull_bar
        arm_2  := htf2_bull_bar
        pos_dir := "long"
        pend_long := false
        pend_short := false
        entry_price := rawC
        lbl_entry_px := rawC
        trade_no := trade_no + 1
        stop_level := _s
        init_stop := _s
        risk_unit := rawC - _s
        be_moved := false
        bad_bars := 0
        peak_r := 0.0
        entry_bar := bar_index
        rearm_high := na
        rearm_low := na
        ev_entry_long := true

else if pos_dir == "flat" and (short_signal or rev_short)
    _s = f_short_stop(ik_near_S, ik_mid_S, ik_far_S)
    if _s > rawC
        elig_b := inst_el_b_short
        elig_1 := inst_el_1_short
        elig_2 := inst_el_2_short
        arm_b  := not base_bull_bar
        arm_1  := not htf1_bull_bar
        arm_2  := not htf2_bull_bar
        pos_dir := "short"
        pend_long := false
        pend_short := false
        entry_price := rawC
        lbl_entry_px := rawC
        trade_no := trade_no + 1
        stop_level := _s
        init_stop := _s
        risk_unit := _s - rawC
        be_moved := false
        bad_bars := 0
        peak_r := 0.0
        entry_bar := bar_index
        rearm_high := na
        rearm_low := na
        ev_entry_short := true

// ============================================================================
// ⑧ ALERTS  — toggle each on/off, then set sound/popup per alert in TradingView
// ============================================================================
grp_al = "⑦ ━━━ ALERTS ━━━"
al_entry  = input.bool(true, "Entry alerts", group=grp_al)
al_exit   = input.bool(true, "Exit-signal alerts (any enabled exit)", group=grp_al)
al_stop   = input.bool(true, "Stop-hit alerts", group=grp_al)
al_signal_only = input.bool(false, "Signal-only mode (ignore position state)", tooltip="OFF: entry alerts fire only when flat, matching the strategy.\nON: every Full Alignment fires, even while a hypothetical trade is already open.", group=grp_al)

raw_long  = allow_longs  and (pa_bull_raw or re_long)  and in_date and not gap_block and not eod_entry_block and (not entry_needs_dir or raw_is_bull) and not sr_hold_long
raw_short = allow_shorts and (pa_bear_raw or re_short) and in_date and not gap_block and not eod_entry_block and (not entry_needs_dir or raw_is_bear) and not sr_hold_short

fire_entry_long  = al_entry and (al_signal_only ? raw_long  : ev_entry_long)
fire_entry_short = al_entry and (al_signal_only ? raw_short : ev_entry_short)
fire_align_break = al_exit and ev_align_break
fire_stop_hit    = al_stop and ev_stop_hit
fire_any_entry   = fire_entry_long or fire_entry_short
fire_any_exit    = fire_align_break or fire_stop_hit

alertcondition(fire_entry_long,  "Entry LONG",  "3SHA-PA LONG entry on {{ticker}} {{interval}} at {{close}}")
alertcondition(fire_entry_short, "Entry SHORT", "3SHA-PA SHORT entry on {{ticker}} {{interval}} at {{close}}")
alertcondition(fire_align_break, "Exit — signal", "3SHA-PA exit signal on {{ticker}} {{interval}} at {{close}} (alignment break, target, give-back, time or SHA break — whichever is enabled)")
alertcondition(fire_stop_hit,    "Exit — stop hit", "3SHA-PA stop hit on {{ticker}} {{interval}} at {{close}} — exit")
alertcondition(fire_any_entry,   "Any entry", "3SHA-PA entry on {{ticker}} {{interval}} at {{close}}")
alertcondition(fire_any_exit,    "Any exit",  "3SHA-PA exit on {{ticker}} {{interval}} at {{close}}")

// ============================================================================
// ⑨ DISPLAY
// ============================================================================
grp_disp = "⑧ ━━━ DISPLAY ━━━"
show_marks = input.bool(true, "Show entry/exit markers", group=grp_disp)
show_price_labels = input.bool(true, "Show entry/exit price labels", tooltip="Shows the fill price at each entry and exit, in a label held clear of the candle.", group=grp_disp)
label_offset_pct = input.float(0.30, "  Label distance (%)", minval=0.0, step=0.05, tooltip="How far the label sits from the candle, as a percentage of price. Raise it if labels overlap the bars.", group=grp_disp)
label_size = input.string("Small", "  Label Size", options=["Tiny","Small","Normal","Large","Huge"], tooltip="Text size for the entry and exit price labels.", group=grp_disp)
_lbl_size = label_size == "Tiny" ? size.tiny : label_size == "Small" ? size.small : label_size == "Normal" ? size.normal : label_size == "Large" ? size.large : size.huge
show_stop  = input.bool(true, "Show active stop line", group=grp_disp)
show_init_stop = input.bool(true, "Show initial stop", tooltip="Marks the stop as first placed, so you can see how far break-even and trailing have moved it since.", group=grp_disp)
show_panel = input.bool(true, "Show status panel", group=grp_disp)
hud_pos = input.string("Top Right", "  Panel Position", options=["Top Left","Top Right","Bottom Left","Bottom Right"], group=grp_disp)
col_bull = input.color(color.new(#2962FF, 0), "Bull / Long", inline="lc", group=grp_disp)
col_bear = input.color(color.new(#F23645, 0), "Bear / Short", inline="lc", group=grp_disp)
col_stop = input.color(color.new(#FF9800, 0), "Stop", inline="lc", group=grp_disp)
col_exit = input.color(color.new(#FF9800, 0), "Other Exit", inline="lc", group=grp_disp)
col_init = input.color(color.new(#000000, 0), "Initial Stop", inline="lc", group=grp_disp)
marker_offset_pct = input.float(0.15, "Marker Distance (%)", minval=0.0, step=0.05, tooltip="How far the exit arrows sit from the candle, as a percentage of price. Raise it if they overlap the bars or the price labels.", group=grp_disp)
col_win  = input.color(color.new(#1B5E20, 0), "Exit Ahead", inline="oc", tooltip="Colour for an exit that finished ahead, and one for an exit that did not. Applies to the exit arrow and the exit label together.", group=grp_disp)
col_lose = input.color(color.new(#000000, 0), "Exit Behind", inline="oc", group=grp_disp)

plotshape(show_marks and fire_entry_long,  title="Long entry",  style=shape.triangleup,   location=location.belowbar, color=col_bull,  size=size.small, text="PAA")
plotshape(show_marks and fire_entry_short, title="Short entry", style=shape.triangledown, location=location.abovebar, color=col_bear, size=size.small, text="PAA")
// Exit arrows sit clear of the candle - on the side opposite the entry marker,
// so an exit can never be mistaken for an entry on the same bar.
_mk_off = rawC * marker_offset_pct / 100.0
_mk_up  = pos_dir_prev == "long"
_mk_pl  = na(exit_from_px) ? na : (_mk_up ? rawC - exit_from_px : exit_from_px - rawC)
_mk_col = na(_mk_pl) ? col_exit : (_mk_pl >= 0 ? col_win : col_lose)
plotshape(show_marks and (fire_stop_hit or fire_align_break) and pos_dir_prev == "long" ? rawH + _mk_off : na, title="Exit Long", style=shape.arrowdown, location=location.absolute, color=_mk_col, size=size.small)
plotshape(show_marks and (fire_stop_hit or fire_align_break) and pos_dir_prev == "short" ? rawL - _mk_off : na, title="Exit Short", style=shape.arrowup,  location=location.absolute, color=_mk_col, size=size.small)

// ── ENTRY / EXIT PRICE LABELS ───────────────────────────────────────────────
// Held clear of the candle by a percentage of price, so the gap looks the same
// on a $20 stock and a $600 one.
_lbl_off = rawC * label_offset_pct / 100.0
if show_price_labels and (fire_entry_long or fire_entry_short)
    _up = fire_entry_long
    label.new(bar_index, _up ? rawL - _lbl_off : rawH + _lbl_off,
         text = "#" + str.tostring(trade_no) + " " + (_up ? "LONG " : "SHORT ") + "[" + (rawC > rawO ? "bull" : rawC < rawO ? "bear" : "flat") + "] " + str.tostring(rawC, format.mintick),
         style = _up ? label.style_label_up : label.style_label_down,
         color = _up ? color.new(col_bull, 15) : color.new(col_bear, 15),
         textcolor = color.white, size = _lbl_size)

if show_price_labels and (fire_stop_hit or fire_align_break)
    _wasup = pos_dir_prev == "long"
    _pl = na(exit_from_px) ? na : (_wasup ? rawC - exit_from_px : exit_from_px - rawC)
    label.new(bar_index, _wasup ? rawH + _lbl_off : rawL - _lbl_off,
         text = "#" + str.tostring(exit_no) + " " + str.tostring(rawC, format.mintick)
                + (na(_pl) ? "" : "  (" + (_pl >= 0 ? "+" : "") + str.tostring(_pl, format.mintick) + ")"),
         style = _wasup ? label.style_label_down : label.style_label_up,
         color = na(_pl) ? color.new(col_exit, 15) : (_pl >= 0 ? color.new(col_win, 15) : color.new(col_lose, 15)),
         textcolor = color.white, size = _lbl_size)


plot(show_stop and pos_dir != "flat" ? stop_level : na, "Active stop", color=color.new(col_stop, 20), style=plot.style_stepline, linewidth=1)
plot(show_init_stop and pos_dir != "flat" ? init_stop : na, "Initial stop", color=col_init, style=plot.style_circles, linewidth=1)

var table hud = na
if show_panel and barstate.islast
    _hp = hud_pos == "Top Left" ? position.top_left : hud_pos == "Top Right" ? position.top_right : hud_pos == "Bottom Left" ? position.bottom_left : position.bottom_right
    hud := table.new(_hp, 2, 10, border_width=1, frame_color=color.new(#000000, 40), frame_width=1)
    _bg = color.new(#1A1A1A, 10)
    _hd = col_bull
    table.cell(hud, 0, 0, "3SHA PRICE ABOVE", text_color=color.white, bgcolor=_hd, text_size=size.small)
    table.cell(hud, 1, 0, confirm_mode == "Immediate" ? "IMMEDIATE" : "CONFIRMED", text_color=color.white, bgcolor=_hd, text_size=size.small)

    _align_txt = all_bull ? "▲ ABOVE ALL" : all_bear ? "▼ BELOW ALL" : "◇ MIXED"
    _align_col = all_bull ? col_bull : all_bear ? col_bear : color.new(#888888, 0)
    table.cell(hud, 0, 1, "Price vs SHA", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 1, _align_txt, text_color=color.white, bgcolor=_align_col, text_size=size.small)

    table.cell(hud, 0, 2, "Layers B/1/2", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 2, (base_bull_bar?"▲":"▼")+" "+(htf1_bull_bar?"▲":"▼")+" "+(htf2_bull_bar?"▲":"▼"), text_color=color.white, bgcolor=_bg, text_size=size.small)

    _pos_txt = pos_dir == "long" ? "LONG" : pos_dir == "short" ? "SHORT" : "FLAT"
    _pos_col = pos_dir == "long" ? col_bull : pos_dir == "short" ? col_bear : color.new(#444444, 0)
    table.cell(hud, 0, 3, "Position", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 3, _pos_txt, text_color=color.white, bgcolor=_pos_col, text_size=size.small)

    _rr_now = pos_dir == "long" and risk_unit > 0 ? (rawC - entry_price)/risk_unit : pos_dir == "short" and risk_unit > 0 ? (entry_price - rawC)/risk_unit : na
    table.cell(hud, 0, 4, "Open R", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 4, na(_rr_now) ? "—" : str.tostring(_rr_now, "0.00")+"R", text_color=color.white, bgcolor=_bg, text_size=size.small)

    table.cell(hud, 0, 5, "Entry", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 5, na(entry_price) ? "—" : str.tostring(entry_price, format.mintick), text_color=color.white, bgcolor=_bg, text_size=size.small)

    table.cell(hud, 0, 6, "Stop"+(be_moved?" (BE+)":""), text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 6, na(stop_level) ? "—" : str.tostring(stop_level, format.mintick), text_color=color.white, bgcolor=_bg, text_size=size.small)

    table.cell(hud, 0, 7, "Eligible B/1/2", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 7, (elig_b?"●":"○")+" "+(elig_1?"●":"○")+" "+(elig_2?"●":"○"), text_color=color.white, bgcolor=_bg, text_size=size.small)

    _rawdir = rawC > rawO ? "▲ BULL" : rawC < rawO ? "▼ BEAR" : "◇ FLAT"
    _rawcol = rawC > rawO ? col_bull : rawC < rawO ? col_bear : color.new(#888888, 0)
    table.cell(hud, 0, 8, "Raw Candle", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 8, _rawdir, text_color=color.white, bgcolor=_rawcol, text_size=size.small)

    _srtxt = not _sr_armed ? "off" : (sr_hold_long or sr_hold_short) ? "● HOLDING" : "clear"
    _srcol = (sr_hold_long or sr_hold_short) ? col_stop : _bg
    table.cell(hud, 0, 9, "S/R Filter", text_color=color.white, bgcolor=_bg, text_size=size.small)
    table.cell(hud, 1, 9, _srtxt, text_color=color.white, bgcolor=_srcol, text_size=size.small)


// ============================================================================
// SHA CANDLES  (identical to the strategy - derived, do not edit by hand)
// ============================================================================
htf2_body_col = h2C >= h2O ? color.new(htf2_bull, htf2_opacity) : color.new(htf2_bear, htf2_opacity)
htf2_wick_col = show_wicks   ? color.new(htf2_wick, htf2_opacity) : na
htf2_brdr_col = show_borders ? (h2C >= h2O ? color.new(htf2_border_bull, htf2_opacity) : color.new(htf2_border_bear, htf2_opacity)) : htf2_body_col
htf2_pH       = show_wicks ? h2H : math.max(h2O, h2C)
htf2_pL       = show_wicks ? h2L : math.min(h2O, h2C)
plotcandle(htf2_ready and htf2_show ? h2O : na, htf2_ready and htf2_show ? htf2_pH : na,
           htf2_ready and htf2_show ? htf2_pL : na, htf2_ready and htf2_show ? h2C : na,
           title="HTF2 SHA", color=htf2_ready and htf2_show ? htf2_body_col : na,
           wickcolor=htf2_ready and htf2_show ? htf2_wick_col : na,
           bordercolor=htf2_ready and htf2_show ? htf2_brdr_col : na)

htf1_body_col = h1C >= h1O ? color.new(htf1_bull, htf1_opacity) : color.new(htf1_bear, htf1_opacity)
htf1_wick_col = show_wicks   ? color.new(htf1_wick, htf1_opacity) : na
htf1_brdr_col = show_borders ? (h1C >= h1O ? color.new(htf1_border_bull, htf1_opacity) : color.new(htf1_border_bear, htf1_opacity)) : htf1_body_col
htf1_pH       = show_wicks ? h1H : math.max(h1O, h1C)
htf1_pL       = show_wicks ? h1L : math.min(h1O, h1C)
plotcandle(htf1_ready and htf1_show ? h1O : na, htf1_ready and htf1_show ? htf1_pH : na,
           htf1_ready and htf1_show ? htf1_pL : na, htf1_ready and htf1_show ? h1C : na,
           title="HTF1 SHA", color=htf1_ready and htf1_show ? htf1_body_col : na,
           wickcolor=htf1_ready and htf1_show ? htf1_wick_col : na,
           bordercolor=htf1_ready and htf1_show ? htf1_brdr_col : na)

base_body_col = bC >= bO ? color.new(base_bull, base_opacity) : color.new(base_bear, base_opacity)
base_wick_col = show_wicks   ? color.new(base_wick, base_opacity) : na
base_brdr_col = show_borders ? color.new(base_border, base_opacity) : base_body_col
base_pH       = show_wicks ? bH : math.max(bO, bC)
base_pL       = show_wicks ? bL : math.min(bO, bC)
plotcandle(base_ready and base_show ? bO : na, base_ready and base_show ? base_pH : na,
           base_ready and base_show ? base_pL : na, base_ready and base_show ? bC : na,
           title="Base SHA", color=base_ready and base_show ? base_body_col : na,
           wickcolor=base_ready and base_show ? base_wick_col : na,
           bordercolor=base_ready and base_show ? base_brdr_col : na)
